# Build artefacts
/build/
/dist/
*.exe
*.test
*.out
*.o
*.so

# Go binaries built in-place
/backend/malachid
/ui/malachi
/ui/ui

# Vendored dependencies for offline (Flatpak) builds — generated by
# scripts/flatpak-vendor.sh, never committed
/backend/vendor/
/ui/vendor/

# Version handed to the Flatpak build, which has no .git to describe
/.version

# Generated Blueprint output (compiled from .blp at build time)
/ui/data/ui/*.ui

# Generated desktop/metainfo/service files (from .in templates)
/data/*.desktop
/data/*.metainfo.xml
/data/*.service

# Databases
*.db
*.db-*
*.sqlite
*.sqlite-*

# Flatpak / AppImage
.flatpak-builder/
repo/
*.flatpak
*.AppImage
/packaging/appimage/AppDir/

# Logs
*.log

# Local configuration and secrets
config.local.toml
*.local.toml
.env
.env.*

# Editors / tooling
.idea/
.vscode/
*.swp
*~
.DS_Store
.claude/settings.json
.claude/settings.local.json
.claude/*.tmp.*

# Compiled translations (built into build/locale)
/po/*.mo
