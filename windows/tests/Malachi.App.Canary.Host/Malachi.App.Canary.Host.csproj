SPDX-FileCopyrightText: 2026 Vladislav Janeček
SPDX-License-Identifier: GPL-3.0-or-later

The network canary's WinUI host (docs/windows-port.md §12): a window that
holds the app's real viewer, editor and previewer, compiled from the same
files as MalachiMail.exe (src/Malachi.App/WebViews, which therefore depend
on nothing else of the app), and plays what Malachi.App.Canary tells it:
documents to load, pointer actions through the DevTools protocol, pictures
and attachments to show. It records what the views did and writes a
Chromium NetLog; the test counts connections and lookups. Not a test
project itself, and never shipped.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <AssemblyName>Malachi.App.Canary.Host</AssemblyName>
    <RootNamespace>Malachi.App.Canary.Host</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The views under test, as the app compiles them. -->
    <Compile Include="..\..\src\Malachi.App\WebViews\**\*.cs" LinkBase="WebViews" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Malachi.Core\Malachi.Core.csproj" />
    <ProjectReference Include="..\..\src\Malachi.Platform.Windows\Malachi.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
