Malachi.Platform.Windows: the Windows services behind Core's interfaces
(process host, key-file policy, registry settings, Mark of the Web, launch
at login, mailto: registration, the tray icon). P/Invoke and COM come from
CsWin32 (NativeMethods.txt), never written by hand where it can generate
them (docs/windows-port.md §2, §3.1).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Malachi.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Restored for the app's runtimes as well (see Malachi.Core.csproj). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Malachi.Core\Malachi.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Malachi.Platform.Windows.Tests" />
  </ItemGroup>
</Project>
