Port of ui/data/ui/assistant_panel.blp (assistant_panel); macOS:
MalachiMail/Assistant/AssistantPanelViewController.swift. The assistant
panel of the main window (ui/internal/assistant, the In App target), on the
right of the panes (MainWindow's AssistantSplit). From the top: the header
with the title, its subtitle (Claude Code and the model) and New
Conversation; the context chip; the quick actions (added from code); the bar
"Another message is selected"; the transcript (rows added from code); the
waiting action; the question field with Send or Stop; the line that says
where the mail goes. Every text is set from code (AssistantPanel.xaml.cs,
from ui/internal/assistant's texts), and everything the model or mail wrote
reaches the screen as TextBlock.Text or Runs set from code, never markup.
-->
<UserControl
    x:Class="Malachi.App.Assistants.AssistantPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reader="using:Malachi.App.Reader"
    xmlns:res="using:Malachi.App.Resources"
    IsTabStop="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The header bar: the title with its subtitle, New Conversation. -->
        <Grid
            Height="44"
            Padding="12,0,6,0"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleLabel"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource HeadingLabelStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SubtitleLabel"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Name="NewButton"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="AssistantNewConversation"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('document-edit-symbolic')}" />
            </Button>
        </Grid>

        <!-- The chip, the quick actions and the bar. -->
        <StackPanel
            Grid.Row="1"
            Margin="12,10,12,10"
            Spacing="8">
            <Border
                x:Name="Chip"
                Padding="8,4,4,4"
                HorizontalAlignment="Left"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="14">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon
                        x:Name="ChipIcon"
                        VerticalAlignment="Center"
                        FontSize="14" />
                    <TextBlock
                        x:Name="ChipLabel"
                        MaxWidth="260"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AssistantContext"
                        Style="{StaticResource BodyLabelStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="ChipRemove"
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="10" Glyph="{x:Bind res:Icons.Glyph('window-close-symbolic')}" />
                    </Button>
                </StackPanel>
            </Border>
            <reader:WrapBox
                x:Name="Actions"
                ChildSpacing="6"
                LineSpacing="6" />
            <Border
                x:Name="Bar"
                Padding="12,10,12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="BarLabel"
                        Style="{StaticResource BodyLabelStyle}"
                        TextWrapping="Wrap" />
                    <reader:WrapBox ChildSpacing="6" LineSpacing="6">
                        <Button x:Name="BarNew" AutomationProperties.AutomationId="AssistantBarNew" />
                        <Button x:Name="BarAdd" AutomationProperties.AutomationId="AssistantBarAdd" />
                    </reader:WrapBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <Rectangle
            Grid.Row="2"
            Height="1"
            VerticalAlignment="Bottom"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!--
            The transcript: one row per item of the controller, and below
            them the spinner while a question is under way and nothing above
            shows it (AssistantPanelController.IsWaiting; GTK
            assistant_waiting).
        -->
        <ScrollViewer
            x:Name="Scroller"
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" Spacing="10">
                <StackPanel
                    x:Name="Transcript"
                    AutomationProperties.AutomationId="AssistantTranscript"
                    Spacing="10" />
                <ProgressRing
                    x:Name="WaitingRing"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Left"
                    IsActive="False"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Rectangle
            Grid.Row="4"
            Height="1"
            VerticalAlignment="Top"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- The waiting action, the question field with Send or Stop, the footer. -->
        <StackPanel
            Grid.Row="5"
            Margin="12,8,12,10"
            Spacing="6">
            <StackPanel
                x:Name="PendingRow"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="PendingLabel"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="PendingCancel"
                    Width="24"
                    Height="24"
                    Padding="0"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="10" Glyph="{x:Bind res:Icons.Glyph('window-close-symbolic')}" />
                </Button>
            </StackPanel>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="Input"
                    MaxHeight="112"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="AssistantInput"
                    IsSpellCheckEnabled="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="AssistantSend"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <TextBlock
                x:Name="Footer"
                Style="{StaticResource DimCaptionLabelStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
