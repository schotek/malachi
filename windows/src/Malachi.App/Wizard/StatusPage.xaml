Port of macos/Sources/MalachiMail/AccountWizard/WizardWidgets.swift
(WizardStatusPageView); GTK: Adw.StatusPage (account_wizard.blp
goa_hint, oauth_prompt, oauth_waiting, oauth_unavailable,
testing_progress, testing_results). A large dim icon or a spinner, a
bold title, a description and an optional child, centred and scrolling
when the window is short: 36 px above and below, 36 under the icon, 12
under the title, 36 under the description when a child follows
(libadwaita's statuspage margins), the texts at most 400 px wide. The
texts are plain text: a description may name a provider or carry the
daemon's words.
-->
<UserControl
    x:Class="Malachi.App.Wizard.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    IsTabStop="False">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="Column"
            Margin="12,36"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <FontIcon
                x:Name="IconView"
                Margin="0,0,0,36"
                HorizontalAlignment="Center"
                FontSize="96"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Visibility="Collapsed" />
            <ProgressRing
                x:Name="Spinner"
                Width="48"
                Height="48"
                Margin="0,0,0,36"
                HorizontalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="TitleView"
                MaxWidth="400"
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource Title1LabelStyle}" />
            <TextBlock
                x:Name="DescriptionView"
                MaxWidth="400"
                HorizontalAlignment="Center"
                IsTextSelectionEnabled="False"
                Style="{StaticResource BodyLabelStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <ContentPresenter
                x:Name="ChildView"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
