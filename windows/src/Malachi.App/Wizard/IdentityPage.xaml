Port of macos/Sources/MalachiMail/AccountWizard/IdentityPageController.swift;
GTK: account_wizard.blp identity_page. Element by element: the banner
(identity_banner) across the top, then a scrolling column clamped to 480
px with 24 px margins and 18 px between its parts: the description (dim,
wrapping), the linked accounts' group (linked_group: GNOME Online
Accounts, which Windows does not have, so it is left out as on macOS,
M20), and the rows Your Name, E-mail Address and Password
(identity_rows); at the bottom, right-aligned with 12 px margins, Next
(identity_next_button, the suggested action). The rows are SettingsCards
with their entry at the end, a flagged row's title turns red (the GTK
error class).
-->
<UserControl
    x:Class="Malachi.App.Wizard.IdentityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="Banner"
            Grid.Row="0"
            AutomationProperties.AutomationId="IdentityBanner"
            CornerRadius="0"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
            <Grid>
                <StackPanel
                    MaxWidth="480"
                    Padding="24"
                    Spacing="18">
                    <TextBlock
                        Style="{StaticResource DimLabelStyle}"
                        Text="{l:T Msgid='Enter your e-mail address and, unless the account signs in through your browser, its password. Malachi Mail will look up the server settings for you.'}"
                        TextWrapping="Wrap" />

                    <StackPanel x:Name="IdentityRows" Spacing="{StaticResource SettingsCardSpacing}">
                        <tk:SettingsCard
                            x:Name="NameRow"
                            Header="{l:T Msgid='Your Name'}">
                            <TextBox
                                x:Name="NameBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="DisplayName"
                                AutomationProperties.Name="{l:T Msgid='Your Name'}"
                                IsSpellCheckEnabled="False"
                                TextChanged="OnTextChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard
                            x:Name="EmailRow"
                            Header="{l:T Msgid='E-mail Address'}">
                            <TextBox
                                x:Name="EmailBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="Email"
                                AutomationProperties.Name="{l:T Msgid='E-mail Address'}"
                                InputScope="EmailSmtpAddress"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                KeyDown="OnEmailKeyDown"
                                TextChanged="OnTextChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard
                            x:Name="PasswordRow">
                            <PasswordBox
                                x:Name="PasswordField"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="Password"
                                KeyDown="OnPasswordKeyDown"
                                PasswordChanged="OnPasswordChanged" />
                        </tk:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Style="{StaticResource WizardButtonBarStyle}">
            <Button
                x:Name="NextButton"
                AutomationProperties.AutomationId="Next"
                Click="OnNextClick"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
