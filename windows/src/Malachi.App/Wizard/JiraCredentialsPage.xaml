<UserControl
    x:Class="Malachi.App.Wizard.JiraCredentialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Malachi.App.Wizard"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="Banner"
            Grid.Row="0"
            AutomationProperties.AutomationId="JiraCredentialsBanner"
            CornerRadius="0"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel
                    MaxWidth="480"
                    Padding="24"
                    Spacing="12">
                    <TextBlock
                        x:Name="Help"
                        Style="{StaticResource DimLabelStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="HelpButton"
                        Margin="0,0,0,6"
                        AutomationProperties.AutomationId="JiraTokenHelp"
                        Click="OnHelpClick" />
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <tk:SettingsCard x:Name="LoginRow">
                            <TextBox
                                x:Name="LoginBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="JiraLogin"
                                InputScope="EmailSmtpAddress"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                KeyDown="OnLoginKeyDown"
                                TextChanged="OnLoginChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="TokenRow">
                            <PasswordBox
                                x:Name="TokenBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="JiraToken"
                                KeyDown="OnTokenKeyDown"
                                PasswordChanged="OnTokenChanged" />
                        </tk:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:JiraWizardButtonBar x:Name="Bar" Grid.Row="2" />
    </Grid>
</UserControl>
