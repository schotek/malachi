<UserControl
    x:Class="Malachi.App.Wizard.EwayServicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Malachi.App.Wizard"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="Banner"
            Grid.Row="0"
            AutomationProperties.AutomationId="EwayServiceBanner"
            CornerRadius="0"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel
                    MaxWidth="480"
                    Padding="24"
                    Spacing="12">
                    <tk:SettingsCard x:Name="ServiceRow">
                        <TextBox
                            x:Name="ServiceBox"
                            MinWidth="{StaticResource SettingsEntryWidth}"
                            AutomationProperties.AutomationId="EwayService"
                            InputScope="Url"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            KeyDown="OnServiceKeyDown"
                            TextChanged="OnServiceChanged" />
                    </tk:SettingsCard>
                    <TextBlock
                        x:Name="Problem"
                        AutomationProperties.AutomationId="EwayServiceProblem"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource JiraProblemTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="Hint"
                        AutomationProperties.AutomationId="EwayServiceHint"
                        Style="{StaticResource JiraStatusTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:JiraWizardButtonBar x:Name="Bar" Grid.Row="2" />
    </Grid>
</UserControl>
