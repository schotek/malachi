Port of macos/Sources/MalachiMail/AccountWizard/EWay/EWayWizardWindowController.swift
(EWayCredentialsPageController); GTK: the sign-in page of eway_wizard.blp
(docs/eway.md §2.6, written in T7). The eWay-CRM assistant's sign-in page,
laid out as the Jira assistant's (JiraCredentialsPage.xaml): the banner
across the top, then a scrolling column clamped to 480 px with 24 px
margins: the instance's address (dim, read-only, selectable), the rows
Account Name, User Name and Password (New Password … when editing), the
check box "Also save later messages of saved conversations" with its hint
under it (docs/eway.md D22); at the bottom the call under way and Add
Account (Save when editing).
-->
<UserControl
    x:Class="Malachi.App.Wizard.EwayCredentialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Malachi.App.Wizard"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="Banner"
            Grid.Row="0"
            AutomationProperties.AutomationId="EwayCredentialsBanner"
            CornerRadius="0"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel
                    MaxWidth="480"
                    Padding="24"
                    Spacing="12">
                    <TextBlock
                        x:Name="ServiceUrl"
                        Margin="0,0,0,6"
                        AutomationProperties.AutomationId="EwayServiceUrl"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource DimLabelStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <tk:SettingsCard x:Name="NameRow">
                            <TextBox
                                x:Name="NameBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="EwayName"
                                IsSpellCheckEnabled="False"
                                KeyDown="OnFieldKeyDown"
                                TextChanged="OnNameChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="UserRow">
                            <TextBox
                                x:Name="UserBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="EwayUser"
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                KeyDown="OnFieldKeyDown"
                                TextChanged="OnUserChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="PasswordRow">
                            <PasswordBox
                                x:Name="PasswordBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="EwayPassword"
                                KeyDown="OnPasswordKeyDown"
                                PasswordChanged="OnPasswordChanged" />
                        </tk:SettingsCard>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <CheckBox
                            x:Name="FollowBox"
                            AutomationProperties.AutomationId="EwayFollowThreads"
                            Click="OnFollowClick" />
                        <TextBlock
                            x:Name="FollowHint"
                            Margin="28,0,0,0"
                            AutomationProperties.AutomationId="EwayFollowThreadsHint"
                            Style="{StaticResource JiraStatusTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <local:JiraWizardButtonBar x:Name="Bar" Grid.Row="2" />
    </Grid>
</UserControl>
