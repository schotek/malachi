Windows-only (docs/windows-port.md §6.6): the attachment previewer, the
decided replacement for GNOME Sushi (ui/internal/preview) and Quick Look
(macos Attachments/AttachmentPreview.swift). One reusable window: the
title bar with the file's name and, where Sushi and Quick Look offer to
open the file, Open and Save As… (the chip menu's items, attachments.go
chipMenu); below it the locked-down PreviewWebView (pictures, PDF, text;
HTML, SVG, XML and messages as their source) or its panel (the icon,
name, size and type), under the window's own toast overlay.
-->
<Window
    x:Class="Malachi.App.MessageWindows.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:l="using:Malachi.App.Localization">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />
        <TitleBar
            x:Name="WindowTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,8,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenButton"
                        AutomationProperties.AutomationId="PreviewOpenButton"
                        Click="OnOpen"
                        l:MnemonicLabel.Text="{l:T Msgid='_Open'}" />
                    <Button
                        x:Name="SaveButton"
                        AutomationProperties.AutomationId="PreviewSaveButton"
                        Click="OnSave"
                        l:MnemonicLabel.Text="{l:T Msgid='Save _As…'}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <Grid
            x:Name="PreviewArea"
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <controls:ToastHost x:Name="ToastsHost" />
        </Grid>
    </Grid>
</Window>
