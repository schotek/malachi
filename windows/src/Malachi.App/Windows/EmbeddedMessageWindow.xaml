Port of macos/Sources/MalachiMail/Windows/EmbeddedWindowController.swift;
GTK: ui/data/ui/embedded_window.blp (ui/internal/window/embedded.go). An
attached message (a message/rfc822 or .eml part) shown read-only in its
own window: the title bar with its subject and "Attached to “…”" under it
(window_title), and the message view in its embedded mode: the remote-image
bar with Load Images only, the headers, the chips that only name the parts,
the body; no actions (the message has no id of its own), its own toast
overlay.
-->
<Window
    x:Class="Malachi.App.MessageWindows.EmbeddedMessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />
        <TitleBar
            x:Name="WindowTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid Grid.Row="1">
            <ContentControl
                x:Name="ViewHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False" />
            <controls:ToastHost x:Name="ToastsHost" />
        </Grid>
    </Grid>
</Window>
