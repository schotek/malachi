<UserControl
    x:Class="Malachi.App.Preferences.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:res="using:Malachi.App.Resources"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Padding="{StaticResource SettingsPagePadding}"
                Spacing="{StaticResource SettingsGroupSpacing}">
                <StackPanel x:Name="AccountsGroup">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}"
                            Text="{l:T Msgid='Mail Accounts'}" />
                        <Button
                            x:Name="AddAccountButton"
                            Grid.Column="1"
                            Margin="0,0,0,4"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AddAccount"
                            AutomationProperties.Name="{l:T Msgid='Add Account'}"
                            Click="OnAddClick"
                            IsEnabled="{x:Bind Controller.IsEnabled, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{l:T Msgid='Add Account'}">
                            <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('list-add')}" />
                        </Button>
                    </Grid>
                    <Border x:Name="ListSlot" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
