Port of macos/Sources/MalachiMail/Preferences/PreferencesGroupView.swift,
PreferenceRowView.swift and PrefsClampView.swift (the metrics); GTK:
Adw.PreferencesPage, Adw.PreferencesGroup and its rows as the
Preferences and the account wizard's Servers page use them. A group is
its bold title, an optional dim description and its rows; on Windows the
rows are CommunityToolkit SettingsCards 4 px apart (the Windows Settings
look) instead of a boxed list with dividers. A page is a column at most
600 px wide (AdwPreferencesPage's clamp) with 24 px above and below and
12 px at the sides, the groups 24 px apart. Merged into the pages and
windows that use it, not into App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <!-- Between the rows of a group. -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <!-- Between the groups of a page. -->
    <x:Double x:Key="SettingsGroupSpacing">24</x:Double>

    <!-- The widest a page's column gets (AdwPreferencesPage's clamp). -->
    <x:Double x:Key="SettingsPageMaxWidth">600</x:Double>

    <!-- A page's column: 24 above and below, 12 at the sides. -->
    <Thickness x:Key="SettingsPagePadding">12,24,12,24</Thickness>

    <!-- The width of an entry in a row (AdwEntryRow's field). -->
    <x:Double x:Key="SettingsEntryWidth">240</x:Double>

    <!-- A group's title (.heading). -->
    <Style
        x:Key="SettingsGroupHeaderStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="1,0,0,4" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <!-- A group's description (dim, under the title). -->
    <Style
        x:Key="SettingsGroupDescriptionStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="1,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The colours below are theme resources in styles, so that they are
         resolved in the theme of the window the element is in (the colour
         scheme sets it per window) and follow it when it changes; a brush
         taken from the application's resources has the theme of Windows. -->

    <!-- A wizard row flagged as the thing to fix (the GTK error class):
         its title in the critical colour. -->
    <Style x:Key="WizardErrorCardStyle" TargetType="tk:SettingsCard">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- The icon of a connection test's row: success, an error, anything
         else (dim), as macOS colours them. -->
    <Style x:Key="WizardResultSuccessIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="WizardResultErrorIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="WizardResultDimIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- The text under a field of the Jira assistant (jira_wizard.blp
         site_status, spaces_problem; the caption class): dim, or a problem
         in the critical colour (the GTK error class). -->
    <Style x:Key="JiraStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DimCaptionLabelStyle}" />
    <Style x:Key="JiraProblemTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionLabelStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- A button bar at the bottom of a wizard page: right-aligned, 12 px
         margins, 8 px apart (account_wizard.blp). -->
    <Style x:Key="WizardButtonBarStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Spacing" Value="8" />
    </Style>
</ResourceDictionary>
