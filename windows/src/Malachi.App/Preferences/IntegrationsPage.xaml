SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Preferences/IntegrationsPaneViewController.swift;
GTK: preferences.blp integrations_page (its texts set from
ui/internal/integrations in ui/internal/window/integrations_page.go). The
page's description under the navigation's title ("Services beside your
mail: issue trackers, calendars and CRM"), the group Connected Services
(integrations_group) with every account that is not a mail account
(AccountListSection: its description, the rows and the empty row
integrations_empty_row, "No integrations yet", "Add one from the list
below"), then the group Available Services (integrations_available_group):
a card per service of the catalogue (Integrations.Catalog: Jira, CalDAV
Calendar, eWay-CRM) with its icon, name and description and its Add… button, which
opens the service's assistant. Every text comes from Core's Integrations
and is set from code.
-->
<UserControl
    x:Class="Malachi.App.Preferences.IntegrationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Padding="{StaticResource SettingsPagePadding}"
                Spacing="{StaticResource SettingsGroupSpacing}">
                <TextBlock x:Name="PageDescription" Style="{StaticResource SettingsGroupDescriptionStyle}" />

                <StackPanel x:Name="ConnectedGroup">
                    <TextBlock
                        x:Name="ConnectedHeader"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border x:Name="ListSlot" />
                </StackPanel>

                <StackPanel x:Name="AvailableGroup" Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock
                        x:Name="AvailableHeader"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <tk:SettingsCard x:Name="JiraService" AutomationProperties.AutomationId="JiraService">
                        <Button
                            x:Name="AddJiraButton"
                            AutomationProperties.AutomationId="AddJiraIntegration"
                            Click="OnAddJiraClick" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="CalDAVService" AutomationProperties.AutomationId="CalDAVService">
                        <Button
                            x:Name="AddCalDAVButton"
                            AutomationProperties.AutomationId="AddCalDAVIntegration"
                            Click="OnAddCalDAVClick" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="EwayService" AutomationProperties.AutomationId="EwayService">
                        <Button
                            x:Name="AddEwayButton"
                            AutomationProperties.AutomationId="AddEwayIntegration"
                            Click="OnAddEwayClick" />
                    </tk:SettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
