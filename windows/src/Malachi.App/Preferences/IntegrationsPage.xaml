<UserControl
    x:Class="Malachi.App.Preferences.IntegrationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Padding="{StaticResource SettingsPagePadding}"
                Spacing="{StaticResource SettingsGroupSpacing}">
                <TextBlock x:Name="PageDescription" Style="{StaticResource SettingsGroupDescriptionStyle}" />

                <StackPanel x:Name="ConnectedGroup">
                    <TextBlock
                        x:Name="ConnectedHeader"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <Border x:Name="ListSlot" />
                    <!-- The local integrations' rows (IntegrationsPage.Local.cs), shown while one is connected. -->
                    <StackPanel
                        x:Name="LocalRows"
                        AutomationProperties.AutomationId="LocalIntegrations"
                        Spacing="4"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="AvailableGroup" Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock
                        x:Name="AvailableHeader"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <!-- A card per catalogue entry (IntegrationsPage.xaml.cs). -->
                    <StackPanel x:Name="ServiceCards" Spacing="{StaticResource SettingsCardSpacing}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
