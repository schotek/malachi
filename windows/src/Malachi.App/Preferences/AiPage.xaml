Port of macos/Sources/MalachiMail/Preferences/AIPaneViewController.swift;
GTK: preferences.blp ai_page. The group Assistant (assistant_group):
Assistant Uses (assistant_source: Claude Code, ChatGPT, or an AI provider
account; an entry that cannot run is insensitive and says why), Show the
Assistant Menu, Open In, and while In App is chosen Model (the models of
the provider in effect: Claude's fixed list, or ChatGPT's catalogue; none
for an AI provider account, whose models are chosen on its card in
Integrations). Its texts come from ui/internal/assistant, set in code
(AiPage.xaml.cs, AiPage.ChatGpt.cs). The group Board (board_triage_group,
AiPage.Board.cs): the board's triage, its consent, model, automatic runs,
status and the tokens of the last 24 hours; its texts come from
ui/internal/board. Above them the group About You (about_you_group) and the
assistant's proposals (about_you_pending_group), built in code
(AiPage.Profile.cs); their texts come from ui/internal/assistant profile.go.
The groups MCP, ChatGPT and the Claude Code row moved to the windows of the
local integrations in Integrations (ClaudeIntegrationWindow,
ChatGptIntegrationWindow; docs/plans/ai-api.md §7.3).
-->
<UserControl
    x:Class="Malachi.App.Preferences.AiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Padding="{StaticResource SettingsPagePadding}"
                Spacing="{StaticResource SettingsGroupSpacing}">
                <!-- About You and the assistant's proposals (AiPage.Profile.cs), built in code. -->
                <StackPanel
                    x:Name="AboutYouGroup"
                    AutomationProperties.AutomationId="AboutYouGroup"
                    Spacing="{StaticResource SettingsCardSpacing}" />
                <StackPanel
                    x:Name="ProfilePendingGroup"
                    AutomationProperties.AutomationId="ProfilePendingGroup"
                    Spacing="{StaticResource SettingsCardSpacing}"
                    Visibility="Collapsed" />
                <StackPanel x:Name="AssistantGroup" Spacing="{StaticResource SettingsCardSpacing}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="AssistantHeading"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <!-- Set Up in Integrations…, while nothing is set up (Assistant.NothingSetUp) -->
                        <Button
                            x:Name="AssistantSetUpButton"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="AssistantSetUp"
                            Click="OnAssistantSetUpClick"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="AssistantDescription" Style="{StaticResource SettingsGroupDescriptionStyle}" />
                    <tk:SettingsCard x:Name="AssistantProviderRow">
                        <ComboBox x:Name="AssistantProviderBox" MinWidth="220" AutomationProperties.AutomationId="AssistantProvider" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="AssistantMenuRow">
                        <ToggleSwitch x:Name="AssistantMenuSwitch" AutomationProperties.AutomationId="AssistantMenu" Toggled="OnAssistantMenuToggled" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="AssistantTargetRow">
                        <ComboBox
                            x:Name="AssistantTargetBox"
                            MinWidth="200"
                            AutomationProperties.AutomationId="AssistantTarget" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="AssistantModelRow" Visibility="Collapsed">
                        <ComboBox
                            x:Name="AssistantModelBox"
                            MinWidth="200"
                            AutomationProperties.AutomationId="AssistantModel" />
                    </tk:SettingsCard>
                    <!-- Model over ChatGPT: the provider's default and Codex's catalogue (CodexModelChoice). -->
                    <tk:SettingsCard x:Name="AssistantChatGptModelRow" Visibility="Collapsed">
                        <ComboBox
                            x:Name="AssistantChatGptModelBox"
                            MinWidth="220"
                            AutomationProperties.AutomationId="AssistantChatGptModel" />
                    </tk:SettingsCard>
                </StackPanel>

                <!-- The board's triage (AiPage.Board.cs), shown while it is offered. -->
                <StackPanel
                    x:Name="BoardGroup"
                    Spacing="{StaticResource SettingsCardSpacing}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="BoardHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <TextBlock
                        x:Name="BoardDescription"
                        AutomationProperties.AutomationId="BoardTriageDescription"
                        Style="{StaticResource SettingsGroupDescriptionStyle}"
                        Visibility="Collapsed" />
                    <tk:SettingsCard x:Name="BoardConsentRow">
                        <ToggleSwitch
                            x:Name="BoardConsentSwitch"
                            AutomationProperties.AutomationId="BoardTriageConsent"
                            Toggled="OnBoardConsentToggled" />
                    </tk:SettingsCard>
                    <!-- Triage These Accounts: a check box per enabled account (AiPage.Board.cs). -->
                    <tk:SettingsCard x:Name="BoardAccountsRow">
                        <tk:SettingsCard.Description>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="BoardAccountsSubtitle"
                                    AutomationProperties.AutomationId="BoardTriageAccountsSubtitle"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <StackPanel
                                    x:Name="BoardAccountsList"
                                    Margin="0,4,0,0"
                                    AutomationProperties.AutomationId="BoardTriageAccounts"
                                    Spacing="0" />
                            </StackPanel>
                        </tk:SettingsCard.Description>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardModelRow">
                        <ComboBox
                            x:Name="BoardModelBox"
                            MinWidth="200"
                            AutomationProperties.AutomationId="BoardTriageModel" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardChatGptModelRow" Visibility="Collapsed">
                        <ComboBox
                            x:Name="BoardChatGptModelBox"
                            MinWidth="220"
                            AutomationProperties.AutomationId="BoardTriageChatGptModel"
                            SelectionChanged="OnBoardChatGptModelChanged" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardAutoRow">
                        <ToggleSwitch
                            x:Name="BoardAutoSwitch"
                            AutomationProperties.AutomationId="BoardTriageAuto"
                            Toggled="OnBoardAutoToggled" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardIntervalRow">
                        <ComboBox
                            x:Name="BoardIntervalBox"
                            MinWidth="160"
                            AutomationProperties.AutomationId="BoardTriageInterval"
                            SelectionChanged="OnBoardIntervalChanged" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardDailyRow">
                        <ComboBox
                            x:Name="BoardDailyBox"
                            MinWidth="160"
                            AutomationProperties.AutomationId="BoardTriageDaily"
                            SelectionChanged="OnBoardDailyChanged" />
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardStatusRow">
                        <tk:SettingsCard.Description>
                            <TextBlock
                                x:Name="BoardStatusText"
                                AutomationProperties.AutomationId="BoardTriageStatus"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </tk:SettingsCard.Description>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="BoardUsageRow" Visibility="Collapsed">
                        <tk:SettingsCard.Description>
                            <TextBlock
                                x:Name="BoardUsageDetail"
                                AutomationProperties.AutomationId="BoardTriageUsageDetail"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </tk:SettingsCard.Description>
                        <TextBlock
                            x:Name="BoardUsageValue"
                            AutomationProperties.AutomationId="BoardTriageUsage"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Typography.NumeralAlignment="Tabular" />
                    </tk:SettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
