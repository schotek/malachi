<UserControl
    x:Class="Malachi.App.Preferences.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        AutomationProperties.AutomationId="PrefsSecurity"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Padding="{StaticResource SettingsPagePadding}"
                Spacing="{StaticResource SettingsGroupSpacing}">
                <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock
                        x:Name="GroupHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <TextBlock
                        x:Name="GroupDescription"
                        Style="{StaticResource SettingsGroupDescriptionStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ImportButton"
                        Margin="0,8,0,8"
                        AutomationProperties.AutomationId="PrefsSecurityImport"
                        Click="OnImportClick" />
                    <TextBlock
                        x:Name="LoadFailedText"
                        AutomationProperties.AutomationId="PrefsSecurityError"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource SettingsGroupDescriptionStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="EmptyText"
                        AutomationProperties.AutomationId="PrefsSecurityEmpty"
                        Style="{StaticResource SettingsGroupDescriptionStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <!-- One card per stored key. -->
                    <StackPanel x:Name="KeysHost" Spacing="{StaticResource SettingsCardSpacing}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
