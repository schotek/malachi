SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Preferences/JiraAccount/JiraAccountViewController.swift
and JiraAccountWindowController.swift; GTK: jira_account.blp
(jira_account_dialog, Adw.Dialog 600×680). The settings of a Jira account
as an owned modal window over the window it was opened from (ModalDialog):
the title bar with the page's title; the banner of a failed call under it;
one scrolling page clamped to the Preferences' width with its groups: the
site (its address with the deployment at the end, the account's name, the
user it signs in as, Replace Token…), the spaces (a card of check boxes
whose list scrolls on its own past 336 px, "No spaces" when there are none,
why the choice cannot be saved), the synchronisation, the folders (a switch
per view and the picker of the closed statuses), the notification e-mails
(the mode with its hint, the senders) and the comments posted by bots (the
bot accounts, the hidden lines, the name prefixes); at the bottom the call
under way at the start and Save (the default) and Cancel at the end, in the
order of a Windows dialog. The rows that depend on the account are built
in code (JiraAccountWindow.xaml.cs, JiraListEditor, JiraStatusPicker).
Everything from the site or the stored configuration is plain text.
-->
<Window
    x:Class="Malachi.App.Preferences.JiraAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:local="using:Malachi.App.Preferences"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:wizard="using:Malachi.App.Wizard">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="Header"
            Grid.Row="0"
            AutomationProperties.AutomationId="JiraAccountHeader"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />

        <InfoBar
            x:Name="Banner"
            Grid.Row="1"
            AutomationProperties.AutomationId="JiraAccountBanner"
            CornerRadius="0"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel
                    MaxWidth="{StaticResource SettingsPageMaxWidth}"
                    Padding="{StaticResource SettingsPagePadding}"
                    Spacing="{StaticResource SettingsGroupSpacing}">

                    <!-- site_group -->
                    <StackPanel x:Name="SiteGroup" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock
                            x:Name="SiteTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <!-- address_row: the address as its description, the deployment at the end. -->
                        <tk:SettingsCard x:Name="AddressRow">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="AddressText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </tk:SettingsCard.Description>
                            <TextBlock x:Name="DeploymentLabel" Style="{StaticResource DimLabelStyle}" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="NameRow">
                            <TextBox
                                x:Name="NameBox"
                                MinWidth="{StaticResource SettingsEntryWidth}"
                                AutomationProperties.AutomationId="JiraAccountName"
                                KeyDown="OnNameKeyDown"
                                TextChanged="OnNameChanged" />
                        </tk:SettingsCard>
                        <!-- user_row: the user's name at the end, the address as the description. -->
                        <tk:SettingsCard x:Name="UserRow">
                            <tk:SettingsCard.Description>
                                <TextBlock x:Name="UserDetail" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </tk:SettingsCard.Description>
                            <TextBlock
                                x:Name="UserLabel"
                                MaxWidth="220"
                                IsTextSelectionEnabled="True"
                                MaxLines="1"
                                Style="{StaticResource DimLabelStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="TokenRow">
                            <Button
                                x:Name="TokenButton"
                                AutomationProperties.AutomationId="JiraReplaceToken"
                                Click="OnReplaceTokenClick" />
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- spaces_group -->
                    <StackPanel x:Name="SpacesGroup" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock
                            x:Name="SpacesTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <TextBlock x:Name="SpacesDescription" Style="{StaticResource SettingsGroupDescriptionStyle}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid>
                                <ListView
                                    x:Name="SpacesList"
                                    MaxHeight="336"
                                    Padding="0,4"
                                    AutomationProperties.AutomationId="JiraAccountSpaces"
                                    IsItemClickEnabled="False"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="wizard:JiraSpaceItem">
                                            <CheckBox
                                                Click="OnSpaceClick"
                                                IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                                <TextBlock
                                                    MaxLines="1"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="NoSpaces"
                                    Margin="16,14"
                                    Style="{StaticResource DimLabelStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <TextBlock
                            x:Name="SpacesProblem"
                            Margin="0,6,0,0"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource JiraProblemTextStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- sync_group -->
                    <StackPanel x:Name="SyncGroup" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock
                            x:Name="SyncTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <tk:SettingsCard x:Name="OfflineRow">
                            <ComboBox
                                x:Name="OfflineBox"
                                AutomationProperties.AutomationId="JiraAccountOffline"
                                SelectionChanged="OnOfflineChanged" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="OnlyMineRow">
                            <ToggleSwitch
                                x:Name="OnlyMineSwitch"
                                AutomationProperties.AutomationId="JiraAccountOnlyMine"
                                Toggled="OnOnlyMineToggled" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="ShowEventsRow">
                            <ToggleSwitch
                                x:Name="ShowEventsSwitch"
                                AutomationProperties.AutomationId="JiraAccountShowEvents"
                                Toggled="OnShowEventsToggled" />
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- folders_group: the switches of the views and the picker, built in code. -->
                    <StackPanel x:Name="FoldersGroup" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock
                            x:Name="FoldersTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                    </StackPanel>

                    <!-- notification_group: the mode, then the list of senders. -->
                    <StackPanel x:Name="NotificationGroup" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock
                            x:Name="NotificationTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                        <tk:SettingsCard x:Name="ModeRow">
                            <ComboBox
                                x:Name="ModeBox"
                                AutomationProperties.AutomationId="JiraAccountNotificationMode"
                                SelectionChanged="OnModeChanged" />
                        </tk:SettingsCard>
                    </StackPanel>

                    <!-- bots_group: the bot accounts, the hidden lines and the name prefixes. -->
                    <StackPanel x:Name="BotsGroup" Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock
                            x:Name="BotsTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SettingsGroupHeaderStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid
            Grid.Row="3"
            Margin="12"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- progress_spinner and window_title's subtitle: the call under way. -->
            <StackPanel
                x:Name="Progress"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="ProgressSpinner"
                    Width="16"
                    Height="16"
                    IsActive="False" />
                <TextBlock
                    x:Name="ProgressText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource DimLabelStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                x:Name="SaveButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="JiraAccountSave"
                Click="OnSaveClick"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Grid.Column="2"
                l:MnemonicLabel.Text="{l:T Msgid='_Cancel'}"
                AutomationProperties.AutomationId="JiraAccountCancel"
                Click="OnCancelClick" />
        </Grid>

        <controls:ToastHost x:Name="ToastsHost" Grid.Row="2" />
    </Grid>
</Window>
