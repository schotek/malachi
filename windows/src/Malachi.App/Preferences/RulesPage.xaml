Port of macos/Sources/MalachiMail/Preferences/RulesPaneViewController.swift;
GTK: ui/data/ui/preferences.blp (rules_page) and
ui/internal/window/rules_page.go (docs/plans/rules.md R14, T2).
Preferences → Rules, right after Integrations: the description of what
rules do, the Add Rule… button, the rules in the order the daemon runs
them (a ListView of cards, as the account lists: a click selects a row,
Ctrl+Up and Ctrl+Down move the selected one, a row is dragged by its
handle only) and the empty state. A row, in the order of the GTK row: the
drag handle, the name over the conditions, the actions and the account
with how often the rule acted, the warning of a rule the daemon turned
off, the sending icon of a rule that sends mail, the switch, Edit and
Remove. Everything shown comes from the rule, which may come from mail:
plain text.
-->
<UserControl
    x:Class="Malachi.App.Preferences.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:local="using:Malachi.App.Preferences"
    xmlns:res="using:Malachi.App.Resources"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Preferences/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer
        AutomationProperties.AutomationId="PrefsRules"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        IsTabStop="False"
        VerticalScrollBarVisibility="Auto">
        <!-- A Grid between the ScrollViewer and the clamped column: a ScrollViewer centres a child with a MaxWidth of its own off to the side. -->
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource SettingsPageMaxWidth}"
                Padding="{StaticResource SettingsPagePadding}"
                Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock
                    x:Name="DescriptionText"
                    AutomationProperties.AutomationId="PrefsRulesDescription"
                    Style="{StaticResource SettingsGroupDescriptionStyle}" />
                <TextBlock
                    x:Name="ErrorText"
                    AutomationProperties.AutomationId="PrefsRulesError"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource SettingsGroupDescriptionStyle}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="AddButton"
                    Margin="0,0,0,8"
                    AutomationProperties.AutomationId="PrefsRulesAdd"
                    Click="OnAddClick"
                    Style="{StaticResource AccentButtonStyle}" />

                <ListView
                    x:Name="RuleList"
                    AllowDrop="True"
                    AutomationProperties.AutomationId="PrefsRulesList"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnDragItemsCompleted"
                    DragItemsStarting="OnDragItemsStarting"
                    ItemsSource="{x:Bind Rows}"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionChanged="OnSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                            <Setter Property="MinHeight" Value="64" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RuleRowView">
                            <Grid
                                MinHeight="62"
                                ColumnSpacing="12"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="2,12"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Tag="DragHandle"
                                    ToolTipService.ToolTip="{l:T Msgid='Drag to reorder, or press Ctrl+Up and Ctrl+Down'}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind res:Icons.Glyph('list-drag-handle')}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Padding="0,8"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyLabelStyle}"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource DimCaptionLabelStyle}"
                                        Text="{x:Bind Conditions, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource DimCaptionLabelStyle}"
                                        Text="{x:Bind Actions, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource DimCaptionLabelStyle}"
                                        Text="{x:Bind Scope, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource DimCaptionLabelStyle}"
                                        Text="{x:Bind Status, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <InfoBar
                                        Margin="0,4,0,0"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{x:Bind Problem, Mode=OneWay}"
                                        Severity="Warning"
                                        Visibility="{x:Bind ProblemVisibility, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind OutgoingLabel}"
                                        FontSize="16"
                                        Glyph="{x:Bind res:Icons.Glyph('mail-send')}"
                                        ToolTipService.ToolTip="{x:Bind OutgoingLabel}"
                                        Visibility="{x:Bind OutgoingVisibility, Mode=OneWay}" />
                                    <ToggleSwitch
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="RuleEnabled"
                                        AutomationProperties.Name="{l:T Msgid='Turn the rule on or off'}"
                                        IsOn="{x:Bind IsOn, Mode=OneWay}"
                                        OffContent="{x:Null}"
                                        OnContent="{x:Null}"
                                        Toggled="OnRowToggled"
                                        ToolTipService.ToolTip="{l:T Msgid='Turn the rule on or off'}" />
                                    <Button
                                        AutomationProperties.AutomationId="EditRule"
                                        AutomationProperties.Name="{l:T Msgid='Edit Rule…'}"
                                        Click="OnEditClick"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{l:T Msgid='Edit Rule…'}">
                                        <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('document-edit')}" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="RemoveRule"
                                        AutomationProperties.Name="{l:T Msgid='Remove Rule'}"
                                        Click="OnRemoveClick"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{l:T Msgid='Remove Rule'}">
                                        <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('user-trash')}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- No rules yet. -->
                <StackPanel
                    x:Name="EmptyState"
                    Padding="0,24"
                    AutomationProperties.AutomationId="PrefsRulesEmpty"
                    HorizontalAlignment="Center"
                    Spacing="4"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="EmptyTitleText"
                        HorizontalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SettingsGroupHeaderStyle}" />
                    <TextBlock
                        x:Name="EmptyDescriptionText"
                        TextAlignment="Center"
                        Style="{StaticResource SettingsGroupDescriptionStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
