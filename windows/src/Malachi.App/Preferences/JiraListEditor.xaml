Port of macos/Sources/MalachiMail/Preferences/JiraAccount/JiraListEditorView.swift;
GTK: ui/internal/jiraaccount/lists.go (listEditor, a row of a boxed list).
One list of texts of a Jira account's settings as a card: the title and its
explanation (dim caption), the entries with their remove buttons (built in
code), the field with Add, the suggestions (built in code) and why the entry
typed last was not added (the critical colour).
-->
<UserControl
    x:Class="Malachi.App.Preferences.JiraListEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reader="using:Malachi.App.Reader"
    IsTabStop="False">
    <Border
        Padding="16,12,16,14"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource ControlCornerRadius}">
        <StackPanel Spacing="6">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="TitleLabel"
                    Style="{StaticResource BodyLabelStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SubtitleLabel"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="EntriesBox" Visibility="Collapsed" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FieldBox"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False" />
                <Button x:Name="AddButton" Grid.Column="1" />
            </Grid>
            <reader:WrapBox
                x:Name="SuggestionsBox"
                ChildSpacing="6"
                LineSpacing="6"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ProblemText"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionLabelStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
