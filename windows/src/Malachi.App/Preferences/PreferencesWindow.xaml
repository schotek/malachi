SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Preferences/PreferencesWindowController.swift;
GTK: preferences.blp preferences_dialog (Adw.PreferencesDialog titled
"Preferences"). One window for the whole app, on Mica, its title bar
with the icon and "Preferences"; below it a NavigationView whose pane
holds the four pages of the Blueprint in its order, each with the icon
GTK names (Accounts: system-users, General: preferences-system,
Appearance: applications-graphics, AI: applications-science), and the
visible page with the toast overlay over it. There is no search field
(windows/README.md, as macOS) and no Settings item of the NavigationView's
own. As Windows Settings does, the pane keeps its labels while the window
is at least 720 px wide and shrinks to its icons below that (the
NavigationView's Auto mode, never hidden), so that a narrow window leaves
the page its width; the button that opens it over the page is shown only
then.
-->
<Window
    x:Class="Malachi.App.Preferences.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:res="using:Malachi.App.Resources">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Where Mica is not available the window paints itself. -->
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />

        <TitleBar
            x:Name="Header"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Title="{l:T Msgid='Preferences'}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="PreferencesNavigation"
            CompactModeThresholdWidth="0"
            DisplayModeChanged="OnNavigationDisplayModeChanged"
            ExpandedModeThresholdWidth="720"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="AccountsItem"
                    AutomationProperties.AutomationId="AccountsPage"
                    Content="{l:T Msgid='Accounts'}"
                    Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind res:Icons.Glyph('system-users')}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="GeneralItem"
                    AutomationProperties.AutomationId="GeneralPage"
                    Content="{l:T Msgid='General'}"
                    Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind res:Icons.Glyph('preferences-system')}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AppearanceItem"
                    AutomationProperties.AutomationId="AppearancePage"
                    Content="{l:T Msgid='Appearance'}"
                    Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind res:Icons.Glyph('applications-graphics')}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AiItem"
                    AutomationProperties.AutomationId="AiPage"
                    Content="{l:T Msgid='AI'}"
                    Tag="ai">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind res:Icons.Glyph('applications-science')}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <ContentControl
                    x:Name="PageHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False" />
                <controls:ToastHost x:Name="ToastsHost" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
