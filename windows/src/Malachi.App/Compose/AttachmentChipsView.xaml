SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Compose/AttachmentChipsView.swift; GTK:
ui/data/ui/compose.blp (attachments_box) and ui/internal/compose/compose.go
(addChip). The attachment chips under the editor, hidden while there is
nothing to show: a card per attachment with the type icon (a paperclip, or
a picture for an inline image), the name cut at 24 characters with the whole
name as its tooltip, the size, and Remove. Names come from the backend,
sanitised, and are shown as plain text. A chip is a group named after its
file (ChipGroup), so that Narrator says whose Remove it is.
-->
<UserControl
    x:Class="Malachi.App.Compose.AttachmentChipsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:local="using:Malachi.App.Compose"
    xmlns:p="using:Malachi.Core.Presentation"
    xmlns:res="using:Malachi.App.Resources"
    IsTabStop="False">
    <ItemsControl x:Name="ChipsList" IsTabStop="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <local:ChipWrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="p:ComposeAttachmentChip">
                <local:ChipGroup
                    Padding="8,2,2,2"
                    AutomationProperties.Name="{x:Bind FullName}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind res:Icons.Glyph(Icon)}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            MaxLines="1"
                            Style="{StaticResource BodyLabelStyle}"
                            Text="{x:Bind Name}"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind FullName}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource DimCaptionLabelStyle}"
                            Text="{x:Bind Size}" />
                        <Button
                            Padding="6"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="{x:Bind FullName}"
                            AutomationProperties.Name="{l:T Msgid='Remove'}"
                            Click="OnRemoveClick"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="{l:T Msgid='Remove'}">
                            <FontIcon FontSize="12" Glyph="{x:Bind res:Icons.Glyph('window-close')}" />
                        </Button>
                    </StackPanel>
                </local:ChipGroup>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
