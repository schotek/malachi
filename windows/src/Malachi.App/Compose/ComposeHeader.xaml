SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Compose/ComposeHeaderView.swift; GTK:
ui/data/ui/compose.blp (header_rows and the header_labels size group) and
ui/internal/style (box.compose-headers). The card of header fields, one line
per field, in the Blueprint's order: From (the identities), To with the
Cc/Bcc button, Cc and Bcc (hidden until asked for, each with the separator
above it), Subject. The labels share one column (the size group); the rows
are 30 px high and padded 12 px left and right, the separators run from edge
to edge. The fields sit on the card rather than being controls of their own:
no background, no border, no focus rectangle (the caret says which one takes
typing), the From drop-down flat with a tint under the pointer. The
recipient rows are RecipientTokenBoxes: the finished addresses are badges,
an unparsable entry a red one (GTK's .error was a red row), and a row grows
by the lines its badges wrap onto. Everything typed or listed here is plain
text.
-->
<UserControl
    x:Class="Malachi.App.Compose.ComposeHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:local="using:Malachi.App.Compose"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- The drop-down on the card: no slab behind the sender, a
                     tint under the pointer and while open (style.go). -->
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ComboBoxBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ComboBoxBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
                <!-- High contrast keeps the system's own look. -->
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>

            <!-- A field on the card (Entry has-frame: false): the text on the
                 card, 30 px high, a caret and nothing else. -->
            <Style x:Key="ComposeFieldTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="0,5,0,5" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Auto"
                                    IsDeferredScrollingEnabled="False"
                                    IsTabStop="False"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled" />
                                <Border
                                    Margin="0,0,0,2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The recipient labels override the alignment: they stay level
                 with the first line of a row that wraps onto more. -->
            <Style x:Key="ComposeFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DimLabelStyle}">
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ComposeSeparatorStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The card (.card): one surface, the fields on it. -->
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <!-- header_labels: as wide as the widest label. -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- From -->
            <TextBlock
                x:Name="FromLabel"
                Grid.Row="0"
                Style="{StaticResource ComposeFieldLabelStyle}"
                Text="{l:T Msgid='From'}" />
            <ComboBox
                x:Name="FromBox"
                Grid.Row="0"
                Grid.Column="1"
                Height="30"
                MinHeight="30"
                Margin="0,0,12,0"
                Padding="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ComposeFrom"
                AutomationProperties.LabeledBy="{x:Bind FromLabel}"
                SelectionChanged="OnFromSelectionChanged"
                UseSystemFocusVisuals="False">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            MaxLines="1"
                            Text="{x:Bind}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Rectangle Grid.Row="1" Style="{StaticResource ComposeSeparatorStyle}" />

            <!-- To, and the Cc/Bcc button -->
            <TextBlock
                x:Name="ToLabel"
                Grid.Row="2"
                Margin="12,5,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource ComposeFieldLabelStyle}"
                Text="{l:T Msgid='To'}" />
            <Grid
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,12,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:RecipientTokenBox
                    x:Name="ToBox"
                    AutomationProperties.AutomationId="ComposeTo"
                    AutomationProperties.LabeledBy="{x:Bind ToLabel}" />
                <Button
                    x:Name="CcBccButton"
                    Grid.Column="1"
                    Margin="0,2,0,0"
                    Padding="8,2,8,2"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="ComposeCcBcc"
                    Click="OnCcBccClick"
                    Content="{l:T Msgid='Cc/Bcc'}"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>

            <Rectangle
                x:Name="CcSeparator"
                Grid.Row="3"
                Style="{StaticResource ComposeSeparatorStyle}"
                Visibility="Collapsed" />

            <!-- Cc -->
            <TextBlock
                x:Name="CcLabel"
                Grid.Row="4"
                Margin="12,5,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource ComposeFieldLabelStyle}"
                Text="{l:T Msgid='Cc'}"
                Visibility="Collapsed" />
            <local:RecipientTokenBox
                x:Name="CcBox"
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,0,12,0"
                AutomationProperties.AutomationId="ComposeCc"
                AutomationProperties.LabeledBy="{x:Bind CcLabel}"
                Visibility="Collapsed" />

            <Rectangle
                x:Name="BccSeparator"
                Grid.Row="5"
                Style="{StaticResource ComposeSeparatorStyle}"
                Visibility="Collapsed" />

            <!-- Bcc -->
            <TextBlock
                x:Name="BccLabel"
                Grid.Row="6"
                Margin="12,5,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource ComposeFieldLabelStyle}"
                Text="{l:T Msgid='Bcc'}"
                Visibility="Collapsed" />
            <local:RecipientTokenBox
                x:Name="BccBox"
                Grid.Row="6"
                Grid.Column="1"
                Margin="0,0,12,0"
                AutomationProperties.AutomationId="ComposeBcc"
                AutomationProperties.LabeledBy="{x:Bind BccLabel}"
                Visibility="Collapsed" />

            <Rectangle Grid.Row="7" Style="{StaticResource ComposeSeparatorStyle}" />

            <!-- Subject -->
            <TextBlock
                x:Name="SubjectLabel"
                Grid.Row="8"
                Style="{StaticResource ComposeFieldLabelStyle}"
                Text="{l:T Msgid='Subject'}" />
            <TextBox
                x:Name="SubjectBox"
                Grid.Row="8"
                Grid.Column="1"
                Margin="0,0,12,0"
                AutomationProperties.AutomationId="ComposeSubject"
                AutomationProperties.LabeledBy="{x:Bind SubjectLabel}"
                Style="{StaticResource ComposeFieldTextBoxStyle}" />
        </Grid>
    </Border>
</UserControl>
