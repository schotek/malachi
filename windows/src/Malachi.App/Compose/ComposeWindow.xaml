Port of macos/Sources/MalachiMail/Compose/ComposeWindowController.swift
(buildContent, ComposeToolbar); GTK: ui/data/ui/compose.blp
(compose_window, compose_menu) and ui/data/ui/editor.blp (the editor view).
A compose window, top to bottom as compose.blp:

- the header bar as the window's title bar (docs/windows-port.md §11.3): Attach
  at the start, the title (the subject, or "New Message", shortened as
  Adw.WindowTitle shortens it), the assistant's rewrite (✦, while it can
  run; ComposeWindow.Rewrite.cs), the Draft Menu (Save Draft, Attach Files…,
  Insert Image…, Discard) and the accented Send at the end, on Mica; a narrow
  window shows Send without its label and no app icon
  (ComposeWindow.HeaderBar.cs);
- the content, which is the compose pane (ComposePane.xaml, Layout.Window):
  under the toast overlay the card of header fields, or in comment mode the
  card of the issue in its place, the formatting bar, the plain-text hint,
  the editor filling the rest, the attachment chips; the status line at the
  bottom.
-->
<Window
    x:Class="Malachi.App.Compose.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:reader="using:Malachi.App.Reader"
    xmlns:res="using:Malachi.App.Resources">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Where Mica is not available the window paints itself. -->
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />

        <!-- compose.blp's Adw.HeaderBar. -->
        <TitleBar
            x:Name="ComposeTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <!-- The title fills the middle from where the TitleBar's own
                     title would start, and is shortened at its end. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <!-- [start] attach_button -->
                <Button
                    x:Name="AttachButton"
                    Width="40"
                    Height="32"
                    Margin="4,0,0,0"
                    Padding="0"
                    AutomationProperties.AutomationId="ComposeAttach"
                    AutomationProperties.Name="{l:T Msgid='Attach Files'}"
                    Click="OnAttachClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{l:T Msgid='Attach Files'}">
                    <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('mail-attachment')}" />
                </Button>
            </TitleBar.LeftHeader>
            <!-- window_title: the subject in the bar's middle column, which
                 shrinks, rather than TitleBar.Title, whose column never
                 shortens and pushes the end buttons under the window's own.
                 A TextBlock is no control: the TitleBar keeps it a place to
                 drag the window by. -->
            <TitleBar.Content>
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TitleBarForegroundBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel
                    x:Name="EndButtons"
                    Margin="0,0,4,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <!-- [end] rewrite_button: the assistant's rewrite (ui/internal/assistant,
                         the In App target), shown while the one-shot requests can run;
                         its flyout is rewrite_popover (ComposeWindow.Rewrite.cs). -->
                    <Button
                        x:Name="RewriteButton"
                        Width="40"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="ComposeRewrite"
                        Click="OnRewriteClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('malachi-assistant')}" />
                        <FlyoutBase.AttachedFlyout>
                            <!-- rewrite_popover: the presets and the user's own instruction,
                                 the answer as plain text while it arrives and when it is
                                 there, and what to do with it. Every text is set in code;
                                 the answer is TextBox.Text, never markup. -->
                            <Flyout x:Name="RewriteFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="380" Spacing="10">
                                    <TextBlock x:Name="RewriteTitle" Style="{StaticResource HeadingLabelStyle}" />
                                    <reader:WrapBox
                                        x:Name="RewritePresets"
                                        ChildSpacing="6"
                                        LineSpacing="6" />
                                    <TextBox x:Name="RewriteCustom" AutomationProperties.AutomationId="ComposeRewriteInstruction" />
                                    <StackPanel
                                        x:Name="RewriteStatus"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="Collapsed">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="True" />
                                        <TextBlock x:Name="RewriteStatusLabel" Style="{StaticResource DimCaptionLabelStyle}" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="RewriteResult"
                                        Height="140"
                                        AutomationProperties.AutomationId="ComposeRewriteResult"
                                        IsReadOnly="True"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="RewriteError"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RewriteDiscard" />
                                        <Button x:Name="RewriteInsert" Grid.Column="2" />
                                        <Button
                                            x:Name="RewriteReplace"
                                            Grid.Column="3"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                    <!-- [end] the Draft Menu (compose_menu) -->
                    <Button
                        x:Name="DraftMenuButton"
                        Width="40"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="ComposeDraftMenu"
                        AutomationProperties.Name="{l:T Msgid='Draft Menu'}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{l:T Msgid='Draft Menu'}">
                        <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('view-more')}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="SaveDraftItem"
                                    Click="OnSaveDraftClick"
                                    l:MnemonicLabel.Text="{l:T Msgid='_Save Draft'}" />
                                <MenuFlyoutItem
                                    x:Name="AttachFilesItem"
                                    Click="OnAttachClick"
                                    l:MnemonicLabel.Text="{l:T Msgid='Attach _Files…'}" />
                                <MenuFlyoutItem
                                    x:Name="InsertImageItem"
                                    Click="OnInsertImageClick"
                                    l:MnemonicLabel.Text="{l:T Msgid='Insert _Image…'}" />
                                <MenuFlyoutSeparator x:Name="DiscardSeparator" />
                                <MenuFlyoutItem
                                    x:Name="DiscardItem"
                                    Click="OnDiscardClick"
                                    l:MnemonicLabel.Text="{l:T Msgid='_Discard'}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- [end] send_button: suggested-action, Ctrl+Enter -->
                    <Button
                        x:Name="SendButton"
                        Height="32"
                        Padding="12,0,14,0"
                        AutomationProperties.AutomationId="ComposeSend"
                        Click="OnSendClick"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{l:T Msgid='Send (Ctrl+Enter)'}">
                        <StackPanel
                            x:Name="SendContent"
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('mail-send')}" />
                            <TextBlock x:Name="SendLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- The content: the compose pane (ComposePane, Layout.Window): the
             header fields, the formatting bar, the editor, the chips, the
             status line, and the toast overlay over them. -->
        <Border x:Name="PaneSlot" Grid.Row="1" />
    </Grid>
</Window>
