<!--
SPDX-FileCopyrightText: 2026 Vladislav Janeček
SPDX-License-Identifier: GPL-3.0-or-later

Port of the pills of an issue-tracker account (ui/internal/widget/pill.go
with the issue-pill, internal-pill and kind-badge rules of
ui/internal/style); macOS: Shared/IssuePill.swift and PillLabel. An issue's
status in the message list, on the issue card and in the conversation view
(a status to do, or of no known category, in grey, one in progress in
blue, a done one in green: GTK's alpha(@blue_3, 0.3) and alpha(@green_4,
0.3)), the Internal badge of a service-desk comment (alpha(@orange_3,
0.35)), and the kind capsule after an account's heading in the sidebar
(alpha(@window_fg_color, 0.1), its text at 75 %, bold, 70 %), and the
neutral tag of a bulk message in the message list (label.issue-pill.bulk-pill:
the plain fill, its text at 75 %). The text is the window's; high contrast
keeps the system's button face. Merged into
App.xaml; Controls/IssuePill switches between the fills with its visual
states, so a change of theme repaints them.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="IssuePillPlainBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="IssuePillInProgressBrush" Color="#4D62A0EA" />
            <SolidColorBrush x:Key="IssuePillDoneBrush" Color="#4D2EC27E" />
            <SolidColorBrush x:Key="IssuePillInternalBrush" Color="#59FFA348" />
            <SolidColorBrush x:Key="KindBadgeForegroundBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="BulkPillForegroundBrush" Color="#BFFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="IssuePillPlainBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="IssuePillInProgressBrush" Color="#4D62A0EA" />
            <SolidColorBrush x:Key="IssuePillDoneBrush" Color="#4D2EC27E" />
            <SolidColorBrush x:Key="IssuePillInternalBrush" Color="#59FFA348" />
            <SolidColorBrush x:Key="KindBadgeForegroundBrush" Color="#BF000000" />
            <SolidColorBrush x:Key="BulkPillForegroundBrush" Color="#BF000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="IssuePillPlainBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="IssuePillInProgressBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="IssuePillDoneBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="IssuePillInternalBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="KindBadgeForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="BulkPillForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- label.issue-pill: padding 0 7px, a round end, 80 %. -->
    <Style x:Key="IssuePillBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,0,7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource IssuePillPlainBrush}" />
    </Style>
    <Style x:Key="IssuePillTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <!-- set_max_width_chars(24) -->
        <Setter Property="MaxWidth" Value="170" />
    </Style>

    <!-- label.kind-badge: padding 0 4px, radius 4, 70 %, bold. -->
    <Style x:Key="KindBadgeBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4,0,4,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource IssuePillPlainBrush}" />
    </Style>
    <Style x:Key="KindBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource KindBadgeForegroundBrush}" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
</ResourceDictionary>
