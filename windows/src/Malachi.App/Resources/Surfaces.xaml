SPDX-License-Identifier: GPL-3.0-or-later

The surfaces and status colours of elements built in code: a card (the
assistant panel's proposals, drafts and events, Preferences → AI → Profile,
the board's message cards), the subtle fill of a strip (the user's question
in the assistant panel, the eWay-CRM bar), and an icon or a menu item in the
dim or critical colour. Merged into App.xaml.

The colours are theme resources in styles, so they are resolved in the theme
of the window the element is in (the colour scheme sets RequestedTheme on
each window's root, Shell/WindowTracker.cs) and follow it when it changes;
a brush taken from Application.Current.Resources in code has the theme of
Windows instead, so a dark window would keep a light card under white text.
Code assigns these styles; it never reads a brush from the resources.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A card: the default card fill with its stroke. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A card set apart from its neighbours (the user's own message on the
         board): the secondary card fill with the same stroke. -->
    <Style x:Key="SecondaryCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A strip on the subtle fill, without a stroke. -->
    <Style x:Key="SubtleFillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- An icon in the dim text colour (.dim-label). -->
    <Style x:Key="DimIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- An icon in the critical colour (the GTK error class). -->
    <Style x:Key="CriticalIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- A destructive menu item (the GTK destructive-action class): its text
         in the critical colour. -->
    <Style x:Key="CriticalMenuFlyoutItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
</ResourceDictionary>
