Port of macos/Sources/MalachiMail/App/Typography.swift (Typo, Tint): the
libadwaita style classes of the Blueprints (ui/internal/style) as WinUI
text styles and brushes, merged into App.xaml. The names say which GTK
class they stand for; the sizes follow the Windows type ramp where
libadwaita's body text is 14 px there (Body), and GTK's where a Blueprint
sets one (title-1 20 px bold, the status pages). Colours are theme
resources, so they follow the colour scheme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The plain-text body of a message in the monospaced face
         (.message-body with monospace-plain-text). -->
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- dim-label: secondary text. -->
    <StaticResource x:Key="DimLabelBrush" ResourceKey="TextFillColorSecondaryBrush" />

    <!-- The body text of libadwaita. -->
    <Style x:Key="BodyLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />

    <!-- .heading: bold body. -->
    <Style x:Key="HeadingLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

    <!-- .title-1: the title of a status page. -->
    <Style x:Key="Title1LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- .title-2: the subject of a message. -->
    <Style x:Key="Title2LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- .caption. -->
    <Style x:Key="CaptionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}" />

    <!-- .caption.dim-label: the status line, notes under lists. -->
    <Style x:Key="DimCaptionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- .dim-label on body text. -->
    <Style x:Key="DimLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
