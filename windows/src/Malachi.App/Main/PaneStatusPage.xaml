SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Shared/StatusPageView.swift and
Sidebar/SidebarStatusView.swift; GTK: Adw.StatusPage (window.blp
folder_status_page and list_status_page). The illustration (a GTK icon,
none for the Loading… page), the title, the description and an optional
child (the list's Try Again), centred, at most 400 wide with insets 36/12,
scrolling when the pane is too short. Compact is the sidebar's size
(SidebarStatusView: a smaller icon and title for a pane of 200 to 320).
Every text is plain: a description may carry the backend's error detail.
-->
<UserControl
    x:Class="Malachi.App.Main.PaneStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="Column"
            MaxWidth="400"
            Margin="12,36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                x:Name="Illustration"
                Margin="0,0,0,24"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource Title1LabelStyle}" />
            <TextBlock
                x:Name="DescriptionText"
                HorizontalAlignment="Center"
                IsTextSelectionEnabled="True"
                Style="{StaticResource BodyLabelStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <ContentPresenter x:Name="ChildHost" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
