SPDX-License-Identifier: GPL-3.0-or-later

Port of window.blp's status_button (sync_spinner, connection_icon,
sync_label; spacing 8; tooltip Sync Status; labelled by the line) and its
status_popover (a clamp of 320: status_accounts, a boxed list with one row
per account and one for its unsent messages, and status_daemon); macOS:
MainWindow/StatusBarViewController.swift (a bar across the window's
bottom edge, 26 high with its top line, inset 12) and
StatusPopoverViewController.swift. Where GTK has the line at the bottom of
the sidebar, it spans the window here, so that it stays in sight with the
sidebar folded away (windows/README.md). The line and the rows are Core's
(SyncController.Line, StatusPopover); account names and the backend's
details are plain text.
-->
<UserControl
    x:Class="Malachi.App.Main.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:main="using:Malachi.App.Main"
    xmlns:p="using:Malachi.Core.Presentation"
    xmlns:res="using:Malachi.App.Resources"
    IsTabStop="False">
    <Grid Height="26">
        <!-- The top line between the panes and the bar. -->
        <Rectangle
            Height="1"
            VerticalAlignment="Top"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Button
            x:Name="StatusButton"
            Margin="6,1,6,0"
            Padding="6,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="StatusLine"
            IsEnabled="False"
            Style="{StaticResource SubtleButtonStyle}"
            ToolTipService.ToolTip="{l:T Msgid='Sync Status'}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="SyncSpinner"
                    Width="14"
                    Height="14"
                    IsActive="False"
                    Visibility="Collapsed" />
                <FontIcon
                    x:Name="ConnectionIcon"
                    Grid.Column="1"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="SyncLabel"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
            <Button.Flyout>
                <Flyout
                    x:Name="StatusFlyout"
                    Closed="OnFlyoutClosed"
                    Opening="OnFlyoutOpening"
                    Placement="TopEdgeAlignedLeft">
                    <Flyout.FlyoutPresenterStyle>
                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="MaxWidth" Value="400" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel
                        x:Name="FlyoutContent"
                        Width="320"
                        Spacing="12">
                        <!-- status_accounts: a boxed list. -->
                        <Border
                            x:Name="StatusAccounts"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <ItemsControl x:Name="AccountRows" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:StatusPopoverRow">
                                        <main:StatusRowView Row="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <!-- status_daemon. -->
                        <TextBlock
                            x:Name="StatusDaemon"
                            AutomationProperties.AutomationId="StatusDaemon"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource DimCaptionLabelStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
