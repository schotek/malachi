SPDX-License-Identifier: GPL-3.0-or-later

Port of the message page's header bar of ui/data/ui/window.blp: by default
(the Windows variant of ui/internal/toolbar) Reply, Reply All and Forward
at the start; at the end More Actions (message_menu_model), the
Assistant's ✦ button and its panel's toggle (window.blp assistant_button,
assistant_panel_button, shown only while the Assistant is), the Star
toggle, Move to Trash and Archive, so that they read Archive, Trash |
eWay-CRM | Star, panel, ✦, More; the user arranges them in Preferences →
General → Toolbar (docs/plans/toolbar-customization.md W.4); and of
ui/internal/window/actions.go (setMessageActionsSensitive, setStar: the
star's icon and tooltip, the trash's tooltip for an outbox message);
macOS: MainWindow/MainToolbar.swift (the message section). Every button
runs a command of the main window (WindowCommands), enabled from the
selection's ActionFlags; icon-only buttons are named by their tooltips.
-->
<UserControl
    x:Class="Malachi.App.Main.MessageCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crm="using:Malachi.App.Crm"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:res="using:Malachi.App.Resources"
    xmlns:toolbars="using:Malachi.App.Toolbars"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The star is a flat toggle (GTK's flat header button): the
                 filled star in the accent colour says it is on, as in a
                 message window (MessageView.xaml). High contrast keeps
                 WinUI's own. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextFillColorDisabledBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="TextFillColorDisabledBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="HeaderButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- One strip in the order of the user's toolbar-mail layout, its
         message section (Toolbars/ToolbarStrip; docs/plans/toolbar-customization.md
         W.4): each control names its catalog item; the spaces and the
         flexible space are the strip's own. The panel's toggle is Windows'
         own (macOS's inspector section): before ✦, else before More
         Actions, else at the end. The new items of T10 (Mark as Read or
         Unread, Mark as Junk, Move To, Undo, Load Images) stand only where
         the user put them. -->
    <Grid
        x:Name="BarRoot"
        Height="44"
        Padding="6,0"
        Background="Transparent">
        <toolbars:ToolbarStrip x:Name="Strip">
            <Button
                x:Name="ReplyButton"
                toolbars:ToolbarStrip.Item="reply"
                AutomationProperties.AutomationId="ReplyButton"
                AutomationProperties.Name="{l:T Msgid='Reply'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Reply'}">
                <!-- Reply, or Comment on an issue: glyph and label set in code (ShowFlags). -->
                <FontIcon x:Name="ReplyGlyph" FontSize="16" />
            </Button>
            <Button
                x:Name="ReplyAllButton"
                toolbars:ToolbarStrip.Item="replyAll"
                AutomationProperties.AutomationId="ReplyAllButton"
                AutomationProperties.Name="{l:T Msgid='Reply All'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Reply All'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('mail-reply-all-symbolic')}" />
            </Button>
            <Button
                x:Name="ForwardButton"
                toolbars:ToolbarStrip.Item="forward"
                AutomationProperties.AutomationId="ForwardButton"
                AutomationProperties.Name="{l:T Msgid='Forward'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Forward'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('mail-forward-symbolic')}" />
            </Button>
            <Button
                x:Name="ArchiveButton"
                toolbars:ToolbarStrip.Item="archive"
                AutomationProperties.AutomationId="ArchiveButton"
                AutomationProperties.Name="{l:T Msgid='Archive'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Archive'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('folder-download-symbolic')}" />
            </Button>
            <!-- The gap after it is the layout's space (window.blp trash_button margin-end). -->
            <Button
                x:Name="TrashButton"
                toolbars:ToolbarStrip.Item="trash"
                AutomationProperties.AutomationId="TrashButton"
                AutomationProperties.Name="{l:T Msgid='Move to Trash'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Move to Trash'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('user-trash-symbolic')}" />
            </Button>
            <!-- crm_button (docs/eway.md §2.6): the eWay-CRM button, between two
                 spaces of the default layout (owner, Gate B 2026-10-17); hidden
                 without an eWay-CRM account or for rows that cannot be saved
                 (MainWindow.Crm.cs). -->
            <crm:CrmToolbarButton
                x:Name="CrmCommand"
                toolbars:ToolbarStrip.Item="crm"
                VerticalAlignment="Center" />
            <!-- star_button: a toggle showing the selection's flagged state;
                 its glyph is set in code only (ShowFlags), so no one-time
                 binding puts the empty star back when the bar loads. -->
            <ToggleButton
                x:Name="StarButton"
                Width="36"
                Height="32"
                Padding="0"
                toolbars:ToolbarStrip.Item="star"
                AutomationProperties.AutomationId="StarButton"
                AutomationProperties.Name="{l:T Msgid='Star'}"
                ToolTipService.ToolTip="{l:T Msgid='Star'}">
                <FontIcon x:Name="StarGlyph" FontSize="16" />
            </ToggleButton>
            <!-- assistant_panel_button: opens and folds the assistant panel,
                 shown while the Assistant is on and In App chosen (tooltip
                 and visibility from MainWindow.Assistant.cs). -->
            <ToggleButton
                x:Name="AssistantPanelToggle"
                Width="36"
                Height="32"
                Padding="0"
                toolbars:ToolbarStrip.Pin="before:assistant,moreActions"
                AutomationProperties.AutomationId="AssistantPanelToggle"
                Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('sidebar-show-right-symbolic')}" />
            </ToggleButton>
            <!-- assistant_button: the Assistant menu, shown while the
                 Assistant is (its flyout, tooltip and visibility from code). -->
            <Button
                x:Name="AssistantButton"
                toolbars:ToolbarStrip.Item="assistant"
                AutomationProperties.AutomationId="AssistantButton"
                Style="{StaticResource HeaderButtonStyle}"
                Visibility="Collapsed">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('malachi-assistant-symbolic')}" />
            </Button>
            <Button
                x:Name="MoreButton"
                toolbars:ToolbarStrip.Item="moreActions"
                AutomationProperties.AutomationId="MoreButton"
                AutomationProperties.Name="{l:T Msgid='More Actions'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='More Actions'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('view-more-symbolic')}" />
                <Button.Flyout>
                    <!-- message_menu_model; on opening, the actions the bar does not
                         show come first (MessageCommandBar.xaml.cs OnMoreOpening). -->
                    <MenuFlyout
                        x:Name="MoreMenu"
                        Opening="OnMoreOpening"
                        Placement="BottomEdgeAlignedRight">
                        <!-- win.junk: disabled where there is no junk folder to go to. -->
                        <MenuFlyoutItem x:Name="MenuJunk" Text="{l:T Msgid='Mark as Junk'}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuMarkUnread" l:MnemonicLabel.Text="{l:T Msgid='Mark as _Unread'}" />
                        <MenuFlyoutItem x:Name="MenuMarkRead" l:MnemonicLabel.Text="{l:T Msgid='Mark as _Read'}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuLoadImages" l:MnemonicLabel.Text="{l:T Msgid='Load _Images'}" />
                        <MenuFlyoutItem x:Name="MenuTrustSender" l:MnemonicLabel.Text="{l:T Msgid='Always Load Images From This _Sender'}" />
                        <!-- Print (Ctrl+P), the owner's addition of 2026-11-04 until the
                             toolbar's Print item; Windows-only string: the key name. -->
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="MenuPrint"
                            AutomationProperties.AutomationId="MenuPrint"
                            l:MnemonicLabel.Text="{l:T Msgid='_Print…'}"
                            KeyboardAcceleratorTextOverride="Ctrl+P" />
                        <!-- The status of a Jira issue (hidden-when: action-disabled). -->
                        <MenuFlyoutSeparator x:Name="MenuChangeStatusSeparator" Visibility="Collapsed" />
                        <MenuFlyoutItem x:Name="MenuChangeStatus" Text="{l:T Msgid='Change Status'}" Visibility="Collapsed" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <!-- markRead (O3): one button, Mark as Read while a selected row is
                 unread, else Mark as Unread (glyph and label from ShowFlags). -->
            <Button
                x:Name="MarkReadButton"
                toolbars:ToolbarStrip.Item="markRead"
                AutomationProperties.AutomationId="MarkReadButton"
                Style="{StaticResource HeaderButtonStyle}">
                <FontIcon x:Name="MarkReadGlyph" FontSize="16" />
            </Button>
            <Button
                x:Name="JunkButton"
                toolbars:ToolbarStrip.Item="junk"
                AutomationProperties.AutomationId="JunkButton"
                AutomationProperties.Name="{l:T Msgid='Mark as Junk'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Mark as Junk'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('mail-mark-junk-symbolic')}" />
            </Button>
            <!-- moveTo: the folders of the selection's account, filled on opening
                 by the window (the list's Move To, context_menus.go moveToMenu). -->
            <Button
                x:Name="MoveToButton"
                toolbars:ToolbarStrip.Item="moveTo"
                AutomationProperties.AutomationId="MoveToButton"
                AutomationProperties.Name="{l:T Msgid='Move To'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Move To'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('folder-symbolic')}" />
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="MoveToMenu"
                        Opening="OnMoveToOpening"
                        Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
            </Button>
            <Button
                x:Name="UndoButton"
                toolbars:ToolbarStrip.Item="undo"
                AutomationProperties.AutomationId="UndoButton"
                AutomationProperties.Name="{l:T Msgid='Undo'}"
                Style="{StaticResource HeaderButtonStyle}"
                ToolTipService.ToolTip="{l:T Msgid='Undo'}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('edit-undo-symbolic')}" />
            </Button>
            <Button
                x:Name="LoadPicturesButton"
                toolbars:ToolbarStrip.Item="loadPictures"
                AutomationProperties.AutomationId="LoadPicturesButton"
                Style="{StaticResource HeaderButtonStyle}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('insert-image-symbolic')}" />
            </Button>
            <Button
                x:Name="PrintButton"
                toolbars:ToolbarStrip.Item="print"
                AutomationProperties.AutomationId="PrintButton"
                Style="{StaticResource HeaderButtonStyle}">
                <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('document-print-symbolic')}" />
            </Button>
        </toolbars:ToolbarStrip>
    </Grid>
</UserControl>
