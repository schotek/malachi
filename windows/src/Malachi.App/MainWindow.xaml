The main window (ui/data/ui/window.blp; macos MainWindowController and
MainContentViewController), the frame of docs/windows-port.md §11.1: the
TitleBar on Mica with the icon, "Malachi Mail" and the search box in the
middle; below it the panes of window.blp; the status line across the
bottom edge (26 px). The panes are regions the wave-2 screens fill
(MainWindow.Sidebar, MessageList, Reader, StatusBar); the toast overlay
covers the message pane, as window.blp's toast_overlay does. Until the
screens exist the regions are empty, and a summary in their place shows
the connection, the status line and the counts of what the mailbox
loaded, with a provisional status line at the bottom.
-->
<Window
    x:Class="Malachi.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:res="using:Malachi.App.Resources">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Where Mica is not available the window paints itself. -->
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />

        <!-- The title bar: icon, title, and the search box in the middle
             (Ctrl+F, Ctrl+E; window.blp search_entry). The back and pane
             buttons of the narrow layouts are the main window's (wave 2). -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="240"
                MaxWidth="480"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SearchBox"
                PlaceholderText="{l:T Msgid='Search Mail'}">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon FontSize="12" Glyph="{x:Bind res:Icons.Glyph('edit-find')}" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </TitleBar>

        <!-- The panes of window.blp: folders | messages | message. -->
        <Grid x:Name="PanesHost" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
                <ColumnDefinition x:Name="ListColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl
                x:Name="SidebarRegion"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False" />
            <ContentControl
                x:Name="ListRegion"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False" />
            <Grid x:Name="MessagePane" Grid.Column="2">
                <ContentControl
                    x:Name="ReaderRegion"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False" />
                <controls:ToastHost x:Name="ToastsHost" />
            </Grid>

            <!-- Provisional (until the wave-2 screens fill the regions):
                 what the shell knows. Windows-only strings. -->
            <StackPanel
                x:Name="ShellSummary"
                Grid.ColumnSpan="3"
                MaxWidth="400"
                Margin="36,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Image
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Source="ms-appx:///Assets/Malachi.ico" />
                <TextBlock
                    x:Name="SummaryTitle"
                    AutomationProperties.AutomationId="SummaryTitle"
                    Style="{StaticResource Title1LabelStyle}"
                    Text="{x:Bind res:Bind.AppName}" />
                <TextBlock
                    x:Name="SummaryConnection"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="SummaryConnection"
                    Style="{StaticResource BodyLabelStyle}"
                    Text="{x:Bind res:Bind.ConnectionText(Sync.Connection), Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SummaryHeading"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="SummaryHeading"
                    Style="{StaticResource HeadingLabelStyle}"
                    Text="{x:Bind HeadingText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SummaryCounts"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="SummaryCounts"
                    Style="{StaticResource DimLabelStyle}"
                    Text="{x:Bind CountsText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- The status line across the bottom edge (window.blp status_button,
             at the bottom of the window as on macOS). -->
        <ContentControl
            x:Name="StatusBarRegion"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            IsTabStop="False">
            <Grid
                x:Name="ProvisionalStatusLine"
                Height="26"
                Padding="12,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind Sync.Line.Spinning, Mode=OneWay, FallbackValue=False}"
                    Visibility="{x:Bind res:Bind.Visible(Sync.Line.Spinning), Mode=OneWay, FallbackValue=Collapsed}" />
                <FontIcon
                    Grid.Column="1"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind res:Icons.Glyph(Sync.Line.Icon), Mode=OneWay}"
                    Visibility="{x:Bind res:Bind.VisibleIfText(Sync.Line.Icon), Mode=OneWay, FallbackValue=Collapsed}" />
                <TextBlock
                    x:Name="StatusLineText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="StatusLine"
                    MaxLines="1"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    Text="{x:Bind Sync.Line.Text, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </ContentControl>
    </Grid>
</Window>
