The main window (ui/data/ui/window.blp; macos MainWindowController,
MainSplitViewController and MainContentViewController), docs/windows-port.md
§11.1: the TitleBar on Mica with the icon, "Malachi Mail", the search box
in the middle and, in the narrow layouts, the pane and back buttons; below
it the panes of window.blp, outer_split's sidebar (SidebarPane) beside
inner_split's list (MessageListPane) and message page (its header bar,
MessageCommandBar, over the reader's region and the toast overlay, as
window.blp's toast_overlay covers the message page's content); the status
line across the bottom edge (StatusBarView, 26 px). The sidebar is the
SplitView's pane: inline while the window is wider than 900, an overlay
opened from the title bar at 900 or less; at 600 or less list and message
are one stack with the title bar's back button (MainWindow.Panes.cs, Core's
PaneLayout). The pane widths are dragged with the toolkit's sizers
(window.blp's ranges on the columns).
-->
<Window
    x:Class="Malachi.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:main="using:Malachi.App.Main"
    xmlns:res="using:Malachi.App.Resources"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Where Mica is not available the window paints itself. -->
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />

        <!-- The title bar: icon, title, and the search box in the middle
             (Ctrl+F, Ctrl+E; window.blp search_entry); the pane button
             opens the folded sidebar, the back button leaves the message
             of the narrow stack. The bar itself is no tab stop: it has no
             action, its buttons and the box are the stops. -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            BackRequested="OnBackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            IsTabStop="False"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="240"
                MaxWidth="480"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SearchBox"
                AutomationProperties.Name="{l:T Msgid='Search'}"
                PlaceholderText="{l:T Msgid='Search Mail'}">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon FontSize="12" Glyph="{x:Bind res:Icons.Glyph('edit-find')}" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </TitleBar>

        <!-- outer_split: the sidebar beside the list and message. -->
        <SplitView
            x:Name="PaneSplit"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="True"
            IsTabStop="False"
            OpenPaneLength="240"
            PaneBackground="Transparent"
            PaneClosed="OnPaneClosed">
            <SplitView.Pane>
                <Grid>
                    <!-- The overlay of a folded sidebar is opaque. -->
                    <Border
                        x:Name="OverlayBackground"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="0,1,1,0"
                        Visibility="Collapsed" />
                    <main:SidebarPane x:Name="SidebarPane" AutomationProperties.AutomationId="Sidebar" />
                </Grid>
            </SplitView.Pane>

            <!-- inner_split: the list beside the message page. -->
            <Grid x:Name="ContentPanes">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="ListColumn"
                        Width="380"
                        MinWidth="280"
                        MaxWidth="460" />
                    <ColumnDefinition x:Name="MessageColumn" Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <!-- The content layer the list and the message sit on. -->
                <Border
                    x:Name="ContentLayer"
                    Grid.ColumnSpan="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0" />
                <main:MessageListPane x:Name="ListPane" AutomationProperties.AutomationId="MessageListPane" />
                <Rectangle
                    x:Name="ListDivider"
                    Width="1"
                    HorizontalAlignment="Right"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid x:Name="MessagePane" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <main:MessageCommandBar x:Name="MessageCommands" AutomationProperties.AutomationId="MessageCommands" />
                    <ContentControl
                        x:Name="ReaderRegion"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        IsTabStop="False" />
                    <controls:ToastHost x:Name="ToastsHost" Grid.Row="1" />
                </Grid>
                <!-- The list's width (inner_split, 280 to 460). -->
                <tk:GridSplitter
                    x:Name="ListSplitter"
                    Width="8"
                    AutomationProperties.AccessibilityView="Raw"
                    Margin="0,0,-4,0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    IsThumbVisible="False"
                    ResizeBehavior="CurrentAndNext"
                    ResizeDirection="Columns" />
                <!-- The sidebar's width (outer_split, 200 to 320). -->
                <tk:PropertySizer
                    x:Name="SidebarSizer"
                    Width="8"
                    AutomationProperties.AccessibilityView="Raw"
                    Margin="-4,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Binding="{x:Bind PaneSplit.OpenPaneLength, Mode=TwoWay}"
                    IsThumbVisible="False"
                    Maximum="320"
                    Minimum="200" />
            </Grid>
        </SplitView>

        <!-- The status line across the bottom edge (window.blp status_button,
             at the bottom of the window as on macOS). -->
        <main:StatusBarView x:Name="StatusLine" Grid.Row="2" />
    </Grid>
</Window>
