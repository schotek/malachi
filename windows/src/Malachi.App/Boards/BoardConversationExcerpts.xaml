Port of the text fallback of macos/Sources/MalachiMail/Board/BoardConversationBlock.swift
(the excerpts of board.get, shown while there is no HTML: the samples, a
failure, a message without an HTML part); GTK: the collapsed cards of
window/board_conversation.go. The detail's default conversation part:
"Conversation · 3 messages", the loading or failure note with Try Again,
and a card per message (sender · date, its plain text), oldest first. The
HTML cards (BoardConversationBlock over CardWebView) replace it through
BoardDetailView.ConversationPart. Every text is the view model's, plain.
-->
<UserControl
    x:Class="Malachi.App.Boards.BoardConversationExcerpts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="ExcerptCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style
            x:Key="ExcerptMetaStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="ExcerptTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <TextBlock
            x:Name="Heading"
            AutomationProperties.HeadingLevel="Level3"
            Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel
            x:Name="NoteRow"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="NoteText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <HyperlinkButton
                x:Name="RetryLink"
                Padding="0"
                AutomationProperties.AutomationId="BoardMessagesRetry"
                Click="OnRetryClick"
                Visibility="Collapsed" />
        </StackPanel>
        <StackPanel x:Name="Cards" Spacing="8" />
    </StackPanel>
</UserControl>
