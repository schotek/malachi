SPDX-License-Identifier: GPL-3.0-or-later

Port of BoardCaseContentView (macos/Sources/MalachiMail/Board/BoardViews.swift)
in the List style; GTK: ui/data/ui/board_row.blp (widget.NewBoardRow). A
case: the state's bar on the leading edge, the other party (bold while
unread) with the unread dot and the time, the title (the assistant's mark
in front of its own), two lines of snippet, and the meta line: the state
pill, the deadline (red when overdue), the account, the issue, when a
snoozed case comes back, attachments and the message count. Every text is
the view model's, already cleaned, set as TextBlock.Text.
-->
<UserControl
    x:Class="Malachi.App.Boards.BoardRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:boards="using:Malachi.App.Boards"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:res="using:Malachi.App.Resources"
    IsTabStop="False">
    <Grid Padding="0,8,4,8" ColumnSpacing="9">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Due">
                <VisualState x:Name="DueNormal" />
                <VisualState x:Name="DueOverdue">
                    <VisualState.Setters>
                        <Setter Target="DueText.Foreground" Value="{ThemeResource BoardOverdueForegroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <boards:BoardStateSwatch x:Name="Bar" Corners="1.5" />
        <StackPanel Grid.Column="1" Spacing="2">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PersonText"
                    MaxLines="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Ellipse
                    x:Name="UnreadDot"
                    Grid.Column="1"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    x:Name="TimeText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="MarkText"
                    Margin="0,0,4,0"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource BoardAssistantBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
            <TextBlock
                x:Name="SnippetText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,3,0,0"
                Orientation="Horizontal"
                Spacing="6">
                <boards:BoardStatePill x:Name="StatePill" />
                <Border
                    x:Name="DueChip"
                    Background="{ThemeResource BoardDueFillBrush}"
                    Style="{StaticResource BoardPillBorderStyle}">
                    <TextBlock
                        x:Name="DueText"
                        Foreground="{ThemeResource BoardDueForegroundBrush}"
                        Style="{StaticResource BoardPillTextStyle}" />
                </Border>
                <Border
                    x:Name="AccountTag"
                    Background="{ThemeResource IssuePillPlainBrush}"
                    Style="{StaticResource BoardPillBorderStyle}">
                    <TextBlock
                        x:Name="AccountText"
                        MaxWidth="120"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BoardPillTextStyle}" />
                </Border>
                <controls:IssuePill x:Name="IssueTag" />
                <TextBlock
                    x:Name="RemindText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <FontIcon
                    x:Name="AttachmentIcon"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind res:Icons.Glyph('mail-attachment')}" />
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
