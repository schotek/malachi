Port of BoardTodayTileView (macos/Sources/MalachiMail/Board/BoardTodayViewController.swift);
GTK: boardTileView (window/board_today.go). A count tile of the Today page
("3 Hot"): the count, large and bold in the state's colour (the
assistant's for the commitments), over its title; a rounded card, warmer
while it is the Hot tile. The colours are visual states' ThemeResources.
-->
<UserControl
    x:Class="Malachi.App.Boards.BoardTodayTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BoardHotTileFillBrush" Color="#1FFF6B60" />
                    <SolidColorBrush x:Key="BoardHotTileBorderBrush" Color="#66FF6B60" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BoardHotTileFillBrush" Color="#12D70015" />
                    <SolidColorBrush x:Key="BoardHotTileBorderBrush" Color="#59D70015" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BoardHotTileFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BoardHotTileBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="Card"
        Padding="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Kinds">
                <VisualState x:Name="Info" />
                <VisualState x:Name="Hot">
                    <VisualState.Setters>
                        <Setter Target="CountText.Foreground" Value="{ThemeResource BoardHotBrush}" />
                        <Setter Target="Card.Background" Value="{ThemeResource BoardHotTileFillBrush}" />
                        <Setter Target="Card.BorderBrush" Value="{ThemeResource BoardHotTileBorderBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="You">
                    <VisualState.Setters>
                        <Setter Target="CountText.Foreground" Value="{ThemeResource BoardYouBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Them">
                    <VisualState.Setters>
                        <Setter Target="CountText.Foreground" Value="{ThemeResource BoardThemBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Commitments">
                    <VisualState.Setters>
                        <Setter Target="CountText.Foreground" Value="{ThemeResource BoardAssistantBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel>
            <TextBlock
                x:Name="CountText"
                FontSize="28"
                FontWeight="Bold"
                Foreground="{ThemeResource BoardInfoBrush}"
                MaxLines="1"
                TextWrapping="NoWrap" />
            <TextBlock
                x:Name="TitleText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
