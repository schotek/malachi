Port of macos/Sources/MalachiMail/Board/BoardTodayViewController.swift
(loadView, the table's rows, BoardTodayContainer, BoardTodaySideView,
BoardTodayCard); GTK: the board_today_* widgets of ui/data/ui/board_page.blp
and window/board_today.go. The board's Today style ("Dnes"): the greeting
and the count tiles over one list of what is hot, the top of what waits
for the user ("and N more"), and what the assistant says the user
promised; beside it (under it below 760) the deadlines, grouped from
Overdue on, and the calendar's placeholder. Every text is a cleaned plain
string of the view model, set as TextBlock.Text.
-->
<UserControl
    x:Class="Malachi.App.Boards.BoardTodayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:boards="using:Malachi.App.Boards"
    AutomationProperties.AutomationId="BoardToday"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="boards:BoardRowItem">
            <boards:BoardRowView Row="{x:Bind Row}" />
        </DataTemplate>
        <DataTemplate x:Key="CommitmentTemplate" x:DataType="boards:BoardCommitmentItem">
            <boards:BoardCommitmentView Commitment="{x:Bind Commitment}" />
        </DataTemplate>
        <DataTemplate x:Key="SectionTemplate" x:DataType="boards:BoardTodaySectionItem">
            <boards:BoardStateHeading Margin="0,14,0,4" Section="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="HeadingTemplate" x:DataType="boards:BoardHeadingItem">
            <Grid Padding="0,14,0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{ThemeResource BoardAssistantBrush}"
                    Style="{StaticResource BoardSectionTitleStyle}"
                    Text="{x:Bind Title}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BoardCountTextStyle}"
                    Text="{x:Bind CountText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TextTemplate" x:DataType="boards:BoardTodayTextItem">
            <TextBlock
                Padding="0,8,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind Text}"
                TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="MoreTemplate" x:DataType="boards:BoardTodayMoreItem">
            <TextBlock
                Padding="0,8,0,8"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind Text}" />
        </DataTemplate>
        <boards:BoardItemTemplateSelector
            x:Key="ItemSelector"
            CommitmentTemplate="{StaticResource CommitmentTemplate}"
            HeadingTemplate="{StaticResource HeadingTemplate}"
            MoreTemplate="{StaticResource MoreTemplate}"
            RowTemplate="{StaticResource RowTemplate}"
            SectionTemplate="{StaticResource SectionTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />
        <!-- A deadline group's caption (Overdue, Today, …) and the line without a deadline. -->
        <Style
            x:Key="DueCaptionStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style
            x:Key="DueEmptyStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" SizeChanged="OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SideColumn" Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="SideRow" Height="0" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="TodayList"
            Padding="0,0,0,12"
            AutomationProperties.AutomationId="BoardTodayList"
            ContainerContentChanging="OnContainerContentChanging"
            ContextRequested="OnContextRequested"
            ItemTemplateSelector="{StaticResource ItemSelector}"
            PreviewKeyDown="OnListKeyDown"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single"
            SingleSelectionFollowsFocus="False">
            <ListView.Header>
                <StackPanel Padding="16,20,16,4" Spacing="2">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="26"
                        FontWeight="Bold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="PhraseText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Grid
                        x:Name="Tiles"
                        Margin="0,12,0,0"
                        ColumnSpacing="8" />
                </StackPanel>
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="12,0,12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <ScrollViewer
            x:Name="Side"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,20,16,16" Spacing="12">
                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel x:Name="DueStack" Spacing="4">
                        <TextBlock x:Name="DeadlinesText" Style="{StaticResource BoardSectionTitleStyle}" />
                    </StackPanel>
                </Border>
                <Grid>
                    <Rectangle
                        RadiusX="8"
                        RadiusY="8"
                        Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                        StrokeDashArray="4,3"
                        StrokeThickness="1" />
                    <StackPanel Padding="14" Spacing="6">
                        <TextBlock x:Name="CalendarTitleText" Style="{StaticResource BoardSectionTitleStyle}" />
                        <TextBlock
                            x:Name="CalendarBodyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
