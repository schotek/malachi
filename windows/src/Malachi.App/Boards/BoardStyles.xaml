<!--
SPDX-FileCopyrightText: 2026 Vladislav Janeček
SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/Board/BoardAppearance.swift (BoardPalette,
the measures of BoardMetrics the rows use); GTK: the board-* rules of
ui/internal/style (board-state-dot-*, board-state-*, board-assistant-box,
board-assistant-mark). The board's colours as theme brushes, light and
dark, so a change of theme repaints them: a state's accent (its bar, its
dot, its section title: Hot red, Waiting for You blue, Waiting for Them
brown, For Your Information grey), the state pill (the accent at low alpha,
grey for the informational state), what the assistant wrote (indigo, its
boxes at low alpha), the due chip (orange at low alpha, in brown text) and
the selected row's bar. High contrast keeps the system's colours. Merged
into App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="BoardHotBrush" Color="#FF6B60" />
            <SolidColorBrush x:Key="BoardYouBrush" Color="#4AA3FF" />
            <SolidColorBrush x:Key="BoardThemBrush" Color="#C4A27A" />
            <SolidColorBrush x:Key="BoardInfoBrush" Color="#A0FFFFFF" />
            <SolidColorBrush x:Key="BoardHotPillBrush" Color="#33FF6B60" />
            <SolidColorBrush x:Key="BoardYouPillBrush" Color="#334AA3FF" />
            <SolidColorBrush x:Key="BoardThemPillBrush" Color="#33C4A27A" />
            <SolidColorBrush x:Key="BoardInfoPillBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BoardAssistantBrush" Color="#8E8CFF" />
            <SolidColorBrush x:Key="BoardAssistantFillBrush" Color="#1A8E8CFF" />
            <SolidColorBrush x:Key="BoardAssistantBorderBrush" Color="#558E8CFF" />
            <SolidColorBrush x:Key="BoardDueForegroundBrush" Color="#E0B98A" />
            <SolidColorBrush x:Key="BoardDueFillBrush" Color="#33FF9F0A" />
            <SolidColorBrush x:Key="BoardOverdueForegroundBrush" Color="#FF6B60" />
            <SolidColorBrush x:Key="BoardBoxBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="BoardPanelBrush" Color="#202020" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BoardHotBrush" Color="#D70015" />
            <SolidColorBrush x:Key="BoardYouBrush" Color="#0063C7" />
            <SolidColorBrush x:Key="BoardThemBrush" Color="#8A6A45" />
            <SolidColorBrush x:Key="BoardInfoBrush" Color="#99000000" />
            <SolidColorBrush x:Key="BoardHotPillBrush" Color="#26D70015" />
            <SolidColorBrush x:Key="BoardYouPillBrush" Color="#260063C7" />
            <SolidColorBrush x:Key="BoardThemPillBrush" Color="#268A6A45" />
            <SolidColorBrush x:Key="BoardInfoPillBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="BoardAssistantBrush" Color="#4B48C9" />
            <SolidColorBrush x:Key="BoardAssistantFillBrush" Color="#144B48C9" />
            <SolidColorBrush x:Key="BoardAssistantBorderBrush" Color="#4D4B48C9" />
            <SolidColorBrush x:Key="BoardDueForegroundBrush" Color="#7A5A2E" />
            <SolidColorBrush x:Key="BoardDueFillBrush" Color="#26FF9500" />
            <SolidColorBrush x:Key="BoardOverdueForegroundBrush" Color="#D70015" />
            <SolidColorBrush x:Key="BoardBoxBorderBrush" Color="#26000000" />
            <SolidColorBrush x:Key="BoardPanelBrush" Color="#F9F9F9" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BoardHotBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BoardYouBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BoardThemBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BoardInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BoardHotPillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BoardYouPillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BoardThemPillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BoardInfoPillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BoardAssistantBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BoardAssistantFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BoardAssistantBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BoardDueForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="BoardDueFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BoardOverdueForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BoardBoxBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BoardPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- A pill of the board (a state, a due date, an account): as label.issue-pill. -->
    <Style x:Key="BoardPillBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,0,7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="BoardPillTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="170" />
    </Style>

    <!-- The detail's boxes (the "why", the summary, the suggested reply): BoardBox. -->
    <Style x:Key="BoardBoxStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderBrush" Value="{ThemeResource BoardBoxBorderBrush}" />
    </Style>

    <!-- A section's title in the list (its state's colour, bold). -->
    <Style
        x:Key="BoardSectionTitleStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A count beside a filter or a section's title. -->
    <Style
        x:Key="BoardCountTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- The navigation column's caption (Board, Accounts). -->
    <Style
        x:Key="BoardCaptionStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="12,8,12,4" />
    </Style>
</ResourceDictionary>
