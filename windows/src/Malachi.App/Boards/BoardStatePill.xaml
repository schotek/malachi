SPDX-License-Identifier: GPL-3.0-or-later

Port of the state pill of macos/Sources/MalachiMail/Board/BoardDetailViewController.swift
(IssueStatusPill painted with BoardPalette.colours) and of the rows' state
tag; GTK: the board-state-pill and board-state-* rules of ui/internal/style.
A state's name on its accent at low alpha, in the accent (grey for For Your
Information, as a status to do). The colours are a visual state's
ThemeResource (Boards/BoardStyles.xaml); the text is the board's own.
-->
<UserControl
    x:Class="Malachi.App.Boards.BoardStatePill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center"
    IsTabStop="False">
    <Border
        x:Name="Fill"
        Background="{ThemeResource BoardInfoPillBrush}"
        Style="{StaticResource BoardPillBorderStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="States">
                <VisualState x:Name="Info" />
                <VisualState x:Name="Hot">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource BoardHotPillBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource BoardHotBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="You">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource BoardYouPillBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource BoardYouBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Them">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource BoardThemPillBrush}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource BoardThemBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock
            x:Name="Label"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BoardPillTextStyle}" />
    </Border>
</UserControl>
