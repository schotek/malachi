Port of macos/Sources/MalachiMail/Calendar/EventDetailViewController.swift
(loadView, rebuild, header, title, row, videoCallView, peopleView,
responsePullDown, notesView, footer, addError) and EventDetailViews.swift
(EventDetailNotesView); GTK: the event detail follows (docs/calendar.md
§6.4), its rows are ui/internal/calendar/detail.go (Detail). The content of
the event detail flyout (docs/calendar.md §5.5, artboard 3), 380 wide, top
to bottom: the header line (the calendar's colour, "Work · Calendar", the
account's kind capsule), the title (bold, selectable), the rows with their
glyphs (the time on two lines for a timed event within one day, the
recurrence, the place, Join Video Call with the host, the people line with
the attendees, Show All, "You: …" ▾, the notes as grey plain text with the
daemon's links under them, Show Invitation in Mail), the footer (Edit,
Remove from Calendar or Delete, a spacer, ✦ ▾) and the inline error under
it. Every string of the event is set from code as TextBlock.Text or a
button's string content (no markup), already cleaned by Core.
-->
<UserControl
    x:Class="Malachi.App.Calendars.EventDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="EventDetail"
    IsTabStop="True"
    UseSystemFocusVisuals="False">
    <StackPanel
        x:Name="Rows"
        Width="380"
        Padding="16,14,16,12"
        Spacing="10">

        <!-- The header line: the colour square, "Work · Calendar", the kind capsule. -->
        <Grid x:Name="Header" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="Swatch"
                Width="10"
                Height="10"
                VerticalAlignment="Center"
                CornerRadius="2.5" />
            <TextBlock
                x:Name="CalendarLine"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EventDetailCalendar"
                MaxLines="1"
                Style="{StaticResource DimCaptionLabelStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <Border
                x:Name="KindBadge"
                Grid.Column="2"
                Style="{StaticResource KindBadgeBorderStyle}"
                Visibility="Collapsed">
                <TextBlock x:Name="KindText" Style="{StaticResource KindBadgeTextStyle}" />
            </Border>
        </Grid>

        <!-- The title: 17, bold, selectable, wrapping. -->
        <TextBlock
            x:Name="TitleText"
            AutomationProperties.AutomationId="EventDetailTitle"
            AutomationProperties.HeadingLevel="Level1"
            FontSize="17"
            FontWeight="SemiBold"
            IsTextSelectionEnabled="True"
            TextWrapping="Wrap" />

        <!-- Until the event arrives. -->
        <ProgressRing
            x:Name="LoadingRing"
            Width="16"
            Height="16"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="EventDetailLoading"
            IsActive="False"
            Visibility="Collapsed" />

        <!-- clock: the date, then "10:00–11:30 · 1 h 30 min" (or one line). -->
        <Grid x:Name="TimeRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: Recent. -->
            <FontIcon
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE823;" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock
                    x:Name="TimeFirst"
                    AutomationProperties.AutomationId="EventDetailTime"
                    Style="{StaticResource BodyLabelStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="TimeSecond"
                    AutomationProperties.AutomationId="EventDetailTimeRange"
                    Style="{StaticResource DimLabelStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- repeat: the rule's text. -->
        <Grid x:Name="RepeatRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: RepeatAll. -->
            <FontIcon
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8EE;" />
            <TextBlock
                x:Name="RepeatText"
                Grid.Column="1"
                AutomationProperties.AutomationId="EventDetailRepeat"
                Style="{StaticResource BodyLabelStyle}"
                TextWrapping="Wrap" />
        </Grid>

        <!-- mappin.and.ellipse: the place. -->
        <Grid x:Name="LocationRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: MapPin. -->
            <FontIcon
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE707;" />
            <TextBlock
                x:Name="LocationText"
                Grid.Column="1"
                AutomationProperties.AutomationId="EventDetailLocation"
                IsTextSelectionEnabled="True"
                Style="{StaticResource BodyLabelStyle}"
                TextWrapping="Wrap" />
        </Grid>

        <!-- link: Join Video Call and the host in grey. -->
        <Grid x:Name="VideoRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: Link. -->
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE71B;" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6">
                <HyperlinkButton
                    x:Name="JoinButton"
                    Padding="0"
                    AutomationProperties.AutomationId="EventDetailJoin"
                    Click="OnJoinClick" />
                <TextBlock
                    x:Name="VideoHost"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EventDetailVideoHost"
                    MaxLines="1"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- person.2: the people line, the attendees, Show All, "You: …" ▾. -->
        <Grid x:Name="PeopleRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: People. -->
            <FontIcon
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE716;" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    x:Name="PeopleLine"
                    AutomationProperties.AutomationId="EventDetailPeople"
                    Style="{StaticResource BodyLabelStyle}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="AttendeeList" Spacing="2" />
                <HyperlinkButton
                    x:Name="ShowAllButton"
                    Padding="0"
                    AutomationProperties.AutomationId="EventDetailShowAll"
                    Click="OnShowAllClick"
                    FontSize="12" />
                <DropDownButton
                    x:Name="ResponseButton"
                    Margin="0,4,0,0"
                    AutomationProperties.AutomationId="EventDetailResponse">
                    <DropDownButton.Flyout>
                        <MenuFlyout
                            x:Name="ResponseMenu"
                            Opening="OnResponseMenuOpening"
                            Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- note.text: grey plain text, scrolled beyond 160; the daemon's links under it. -->
        <Grid x:Name="NotesRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: QuickNote. -->
            <FontIcon
                Margin="0,8,0,0"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE70B;" />
            <StackPanel Grid.Column="1" Spacing="4">
                <Border
                    Padding="8,6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <ScrollViewer
                        MaxHeight="160"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="NotesText"
                            AutomationProperties.AutomationId="EventDetailNotes"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource DimCaptionLabelStyle}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
                <StackPanel x:Name="NotesLinks" Spacing="0" />
            </StackPanel>
        </Grid>

        <!-- envelope: Show Invitation in Mail. -->
        <Grid x:Name="InvitationRow" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Segoe Fluent Icons: Mail. -->
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE715;" />
            <HyperlinkButton
                x:Name="InvitationButton"
                Grid.Column="1"
                Padding="0"
                AutomationProperties.AutomationId="EventDetailShowInvitation"
                Click="OnShowInvitationClick" />
        </Grid>

        <!-- The footer: Edit, Remove from Calendar / Delete, a spacer, ✦ ▾. -->
        <Grid
            x:Name="Footer"
            Padding="0,10,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="EditButton"
                AutomationProperties.AutomationId="EventDetailEdit"
                Click="OnEditClick" />
            <Button
                x:Name="RemoveButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="EventDetailRemove"
                Click="OnRemoveClick" />
            <DropDownButton
                x:Name="AssistantButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="EventDetailAssistant">
                <FontIcon x:Name="AssistantIcon" FontSize="16" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem
                            x:Name="AskItem"
                            AutomationProperties.AutomationId="EventDetailAskAssistant"
                            Click="OnAskClick" />
                        <MenuFlyoutItem
                            x:Name="FindTimeItem"
                            AutomationProperties.AutomationId="EventDetailFindAnotherTime"
                            Click="OnFindAnotherTimeClick" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- A write's error, the Core text by code. -->
        <TextBlock
            x:Name="ErrorText"
            AutomationProperties.AutomationId="EventDetailError"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionLabelStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
