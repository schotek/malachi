<UserControl
    x:Class="Malachi.App.Calendars.CalendarContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendars="using:Malachi.App.Calendars"
    IsTabStop="False"
    SizeChanged="OnSizeChanged">
    <Grid x:Name="Columns">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="AssistantColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <calendars:CalendarSidebar x:Name="Sidebar" />

        <Border
            x:Name="ViewsLayer"
            Grid.Column="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Style="{StaticResource CalendarSurfaceStyle}">
            <Grid x:Name="ViewsHost">
                <calendars:CalendarWeekView x:Name="Week" Visibility="Collapsed" />
                <calendars:CalendarMonthView x:Name="Month" Visibility="Collapsed" />
                <calendars:CalendarAgendaView x:Name="Agenda" Visibility="Collapsed" />
                <Grid x:Name="EmptyHostGrid" />
            </Grid>
        </Border>

        <!-- The assistant panel's slot (D28): the window moves its panel in and back. -->
        <Grid
            x:Name="AssistantSlot"
            Grid.Column="2"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0" />
            <Grid x:Name="AssistantHostGrid" />
        </Grid>
    </Grid>
</UserControl>
