<UserControl
    x:Class="Malachi.App.Calendars.CustomRepeatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="EveryText" VerticalAlignment="Center" />
            <NumberBox
                x:Name="IntervalBox"
                Width="110"
                AutomationProperties.AutomationId="EventEditorRepeatInterval"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnIntervalChanged" />
            <ComboBox
                x:Name="UnitBox"
                MinWidth="110"
                AutomationProperties.AutomationId="EventEditorRepeatUnit"
                SelectionChanged="OnUnitChanged" />
        </StackPanel>
        <StackPanel
            x:Name="DaysRow"
            Orientation="Horizontal"
            Spacing="4" />
        <Button
            x:Name="DoneButton"
            AutomationProperties.AutomationId="EventEditorRepeatDone"
            Click="OnDoneClick"
            Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
</UserControl>
