Port of macos/Sources/MalachiMail/EventEditor/EventEditorWindowController.swift
(init, EventEditorToolbar); GTK: the event editor follows
(docs/calendar.md §6.4). One New Event / Edit Event window
(docs/calendar.md §5.6, artboard 5; 760×800): its header bar as the window's
tall TitleBar on Mica (Attach at the start, "New Event" / "Edit Event" in the
middle, ✦ ▾ at the end with Find a Free Slot and Ask the Assistant…), then
under the window's toast overlay the form (EventEditorPane). As the compose
window's (ComposeWindow.xaml), the title is a TextBlock of the bar's middle
column, which shrinks, and the bar keeps it as a place to drag the window by.
-->
<Window
    x:Class="Malachi.App.Calendars.EventEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:local="using:Malachi.App.Calendars"
    xmlns:res="using:Malachi.App.Resources">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Where Mica is not available the window paints itself. -->
        <Border
            x:Name="SolidBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed" />

        <TitleBar
            x:Name="EditorTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Malachi.ico" />
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <!-- Attach (the file dialog; the chips under Notes). -->
                <Button
                    x:Name="AttachButton"
                    Width="40"
                    Height="32"
                    Margin="4,0,0,0"
                    Padding="0"
                    AutomationProperties.AutomationId="EventEditorAttach"
                    Click="OnAttachClick"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('mail-attachment')}" />
                </Button>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <TextBlock
                    x:Name="TitleText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EventEditorWindowTitle"
                    Foreground="{ThemeResource TitleBarForegroundBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- ✦ ▾: Find a Free Slot; Ask the Assistant… while the panel exists. -->
                <DropDownButton
                    x:Name="AssistantButton"
                    Height="32"
                    Margin="0,0,4,0"
                    AutomationProperties.AutomationId="EventEditorAssistant">
                    <FontIcon FontSize="16" Glyph="{x:Bind res:Icons.Glyph('malachi-assistant')}" />
                    <DropDownButton.Flyout>
                        <MenuFlyout
                            x:Name="AssistantMenu"
                            Opening="OnAssistantMenuOpening"
                            Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                x:Name="FindFreeSlotItem"
                                AutomationProperties.AutomationId="EventEditorFindFreeSlot"
                                Click="OnFindFreeSlotClick" />
                            <MenuFlyoutItem
                                x:Name="AskAssistantItem"
                                AutomationProperties.AutomationId="EventEditorAskAssistant"
                                Click="OnAskAssistantClick" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <local:EventEditorPane x:Name="Pane" />
            <controls:ToastHost x:Name="ToastsHost" />
        </Grid>
    </Grid>
</Window>
