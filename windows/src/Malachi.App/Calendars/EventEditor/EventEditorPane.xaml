Port of macos/Sources/MalachiMail/EventEditor/EventEditorViewController.swift
(loadView, buildFields, buildGrid, EventEditorFieldFrame); GTK: the event
editor follows (docs/calendar.md §6.4), its rows are
ui/internal/calendar/editor.go (Field, Fields, FieldLabel). The form of a New
Event / Edit Event window (docs/calendar.md §5.6, artboard 5, M7): a label
column of 110 (right aligned) and the fields, in Cal.Fields' order: the title
(no label, the placeholder "Title"), Calendar with "All Day:" and its switch
at the right, Starts with the time-zone link, Ends, Repeat (Custom… opens a
flyout), Location with Add Video Call ▾, Attendees (the compose window's
RecipientTokenBox in a field's frame, with its suggestions), Availability
(only when the calendar's account answers free/busy), Alert, Notes (plain
text, growing to fill the height) and the attachment chips under them; then
the inline errors with Reload Event and the footer (Delete at the left in
Edit mode, the note of who sends the invitations, Cancel, the primary
button). The form scrolls when the window is shorter than it. Every string
from the server is plain text (TextBox.Text, TextBlock.Text); every label
is set from code (Cal.FieldLabel and friends).
-->
<UserControl
    x:Class="Malachi.App.Calendars.EventEditorPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compose="using:Malachi.App.Compose"
    xmlns:local="using:Malachi.App.Calendars"
    xmlns:reader="using:Malachi.App.Reader"
    AutomationProperties.AutomationId="EventEditor"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- A label of the form's column (secondaryLabelColor, right aligned). -->
        <Style x:Key="EditorLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollMode="Disabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="Form"
                Padding="20,16,24,16"
                ColumnSpacing="10"
                RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="72" />
                </Grid.RowDefinitions>

                <!-- The title: no label, the placeholder "Title". -->
                <TextBox
                    x:Name="TitleBox"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    AutomationProperties.AutomationId="EventEditorTitle"
                    FontSize="15"
                    TextChanged="OnTitleChanged" />

                <!-- Calendar, then "All Day:" and its switch at the right. -->
                <TextBlock
                    x:Name="CalendarLabel"
                    Grid.Row="1"
                    Style="{StaticResource EditorLabelStyle}" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="CalendarBox"
                        MinWidth="220"
                        AutomationProperties.AutomationId="EventEditorCalendar"
                        SelectionChanged="OnCalendarChosen" />
                    <TextBlock
                        x:Name="AllDayLabel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <ToggleSwitch
                        x:Name="AllDaySwitch"
                        Grid.Column="3"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="EventEditorAllDay"
                        Toggled="OnAllDayToggled" />
                </Grid>

                <!-- Starts: the date, the time and the time-zone link. -->
                <TextBlock
                    x:Name="StartLabel"
                    Grid.Row="2"
                    Style="{StaticResource EditorLabelStyle}" />
                <reader:WrapBox
                    Grid.Row="2"
                    Grid.Column="1"
                    ChildSpacing="8"
                    LineSpacing="6">
                    <CalendarDatePicker
                        x:Name="StartDate"
                        AutomationProperties.AutomationId="EventEditorStartDate"
                        DateChanged="OnStartDateChanged" />
                    <TimePicker
                        x:Name="StartTime"
                        AutomationProperties.AutomationId="EventEditorStartTime"
                        SelectedTimeChanged="OnStartTimeChanged" />
                    <HyperlinkButton
                        x:Name="ZoneButton"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="EventEditorTimeZone"
                        FontSize="12">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout
                                x:Name="ZoneFlyout"
                                Closed="OnZoneFlyoutClosed"
                                Placement="BottomEdgeAlignedLeft" />
                        </FlyoutBase.AttachedFlyout>
                    </HyperlinkButton>
                </reader:WrapBox>

                <!-- Ends: the date (an all-day event's last day) and the time. -->
                <TextBlock
                    x:Name="EndLabel"
                    Grid.Row="3"
                    Style="{StaticResource EditorLabelStyle}" />
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <CalendarDatePicker
                        x:Name="EndDate"
                        AutomationProperties.AutomationId="EventEditorEndDate"
                        DateChanged="OnEndDateChanged" />
                    <TimePicker
                        x:Name="EndTime"
                        AutomationProperties.AutomationId="EventEditorEndTime"
                        SelectedTimeChanged="OnEndTimeChanged" />
                </StackPanel>

                <!-- Repeat: Core's choices; Custom… opens the flyout. -->
                <TextBlock
                    x:Name="RepeatLabel"
                    Grid.Row="4"
                    Style="{StaticResource EditorLabelStyle}" />
                <ComboBox
                    x:Name="RepeatBox"
                    Grid.Row="4"
                    Grid.Column="1"
                    MinWidth="220"
                    AutomationProperties.AutomationId="EventEditorRepeat"
                    SelectionChanged="OnRepeatChosen">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout
                            x:Name="RepeatFlyout"
                            Closed="OnRepeatFlyoutClosed"
                            Placement="BottomEdgeAlignedLeft" />
                    </FlyoutBase.AttachedFlyout>
                </ComboBox>

                <!-- Location and Add Video Call ▾. -->
                <TextBlock
                    x:Name="LocationLabel"
                    Grid.Row="5"
                    Style="{StaticResource EditorLabelStyle}" />
                <Grid
                    Grid.Row="5"
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="LocationBox"
                        AutomationProperties.AutomationId="EventEditorLocation"
                        TextChanged="OnLocationChanged" />
                    <DropDownButton
                        x:Name="VideoButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="EventEditorVideoCall">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- Segoe Fluent Icons: Video. -->
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="14"
                                Glyph="&#xE714;" />
                            <TextBlock
                                x:Name="VideoTitle"
                                MaxWidth="200"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout
                                x:Name="VideoMenu"
                                Opening="OnVideoMenuOpening"
                                Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <!-- Attendees: the compose window's badges in a field's frame. -->
                <TextBlock
                    x:Name="AttendeesLabel"
                    Grid.Row="6"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource EditorLabelStyle}" />
                <Border
                    x:Name="AttendeesFrame"
                    Grid.Row="6"
                    Grid.Column="1"
                    MinHeight="32"
                    Padding="8,3"
                    Background="{ThemeResource TextControlBackground}"
                    BorderBrush="{ThemeResource TextControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <compose:RecipientTokenBox
                        x:Name="AttendeesBox"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="EventEditorAttendees" />
                </Border>

                <!-- Availability: only when the calendar's account answers free/busy. -->
                <TextBlock
                    x:Name="AvailabilityLabel"
                    Grid.Row="7"
                    VerticalAlignment="Top"
                    Style="{StaticResource EditorLabelStyle}" />
                <StackPanel
                    x:Name="AvailabilityPanel"
                    Grid.Row="7"
                    Grid.Column="1"
                    Spacing="4">
                    <local:AvailabilityView x:Name="Availability" />
                    <TextBlock
                        x:Name="SummaryText"
                        AutomationProperties.AutomationId="EventEditorAvailabilitySummary"
                        Style="{StaticResource DimCaptionLabelStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            x:Name="NextSlotButton"
                            Padding="0"
                            AutomationProperties.AutomationId="EventEditorNextFreeSlot"
                            Click="OnNextSlotClick"
                            FontSize="12" />
                        <TextBlock
                            x:Name="FreeSlotText"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="EventEditorFreeSlot"
                            MaxLines="1"
                            Style="{StaticResource DimCaptionLabelStyle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Alert. -->
                <TextBlock
                    x:Name="AlertLabel"
                    Grid.Row="8"
                    Style="{StaticResource EditorLabelStyle}" />
                <ComboBox
                    x:Name="AlertBox"
                    Grid.Row="8"
                    Grid.Column="1"
                    MinWidth="220"
                    AutomationProperties.AutomationId="EventEditorAlert"
                    SelectionChanged="OnAlertChosen" />

                <!-- Notes (plain text, taking the height left) and the chips. -->
                <TextBlock
                    x:Name="NotesLabel"
                    Grid.Row="9"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource EditorLabelStyle}" />
                <Grid
                    Grid.Row="9"
                    Grid.Column="1"
                    RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="NotesBox"
                        MinHeight="72"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        AutomationProperties.AutomationId="EventEditorNotes"
                        PreviewKeyDown="OnNotesPreviewKeyDown"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextChanged="OnNotesChanged"
                        TextWrapping="Wrap" />
                    <compose:AttachmentChipsView x:Name="Chips" Grid.Row="1" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- The inline errors with Reload Event, then the footer. -->
        <Grid
            Grid.Row="1"
            Padding="20,10,20,14"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="ErrorRow"
                ColumnSpacing="10"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ErrorText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EventEditorError"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource BodyLabelStyle}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="ReloadButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="EventEditorReload"
                    Click="OnReloadClick" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="DeleteButton"
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="EventEditorDelete"
                    Click="OnDeleteClick"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="FooterText"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EventEditorFooter"
                    MaxLines="2"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="EventEditorCancel"
                    Click="OnCancelClick" />
                <Button
                    x:Name="PrimaryButton"
                    Grid.Column="3"
                    AutomationProperties.AutomationId="EventEditorSave"
                    Click="OnPrimaryClick"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
