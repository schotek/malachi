SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/EventEditor/AvailabilityView.swift; GTK:
the event editor follows (docs/calendar.md §6.4), the rows are
ui/internal/calendar/availability.go (AvailabilityRow, AxisSpan). The
editor's availability rows (docs/calendar.md §5.6): per person a name and a
lane over the start's day from 8:00 to 18:00 with the busy spans grey
(tentative lighter) and the proposed time green; a person without free/busy
reads "availability unknown". The hours along the top, every two hours, are
the axis. The drawing is made in code on the surface; the hidden swatches
give it the window's theme colours (a brush looked up in the application's
resources would have the system's theme, docs/windows-port.md §11.3).
-->
<UserControl
    x:Class="Malachi.App.Calendars.AvailabilityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="EventEditorAvailability"
    IsTabStop="False">
    <Grid>
        <Canvas x:Name="Surface" />
        <!-- The theme's colours for the drawing (never shown). -->
        <Grid Visibility="Collapsed">
            <Rectangle x:Name="BusySwatch" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
            <Rectangle x:Name="TentativeSwatch" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
            <Rectangle x:Name="LaneSwatch" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Rectangle x:Name="TickSwatch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Rectangle x:Name="ProposedSwatch" Fill="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
            <Rectangle x:Name="ProposedEdgeSwatch" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
            <Rectangle x:Name="NameSwatch" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
            <Rectangle x:Name="DimSwatch" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
            <Rectangle x:Name="UnknownSwatch" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
