<UserControl
    x:Class="Malachi.App.Calendars.CalendarAgendaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendars="using:Malachi.App.Calendars"
    xmlns:res="using:Malachi.App.Resources"
    AutomationProperties.AutomationId="CalendarAgendaView"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="HeadingTemplate" x:DataType="calendars:AgendaEntry">
            <TextBlock
                Margin="10,12,10,4"
                MaxLines="1"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Heading}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="ItemTemplate" x:DataType="calendars:AgendaEntry">
            <Grid
                Height="28"
                Margin="10,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" MaxWidth="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Time}"
                    TextTrimming="CharacterEllipsis" />
                <Ellipse
                    Grid.Column="1"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{x:Bind calendars:CalendarAgendaView.DotBrush(Color)}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    MaxLines="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextDecorations="{x:Bind calendars:CalendarAgendaView.Decorations(Struck)}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Place}"
                    TextTrimming="CharacterEllipsis" />
                <Border
                    Grid.Column="4"
                    Style="{StaticResource CalendarAgendaBadgeStyle}"
                    Visibility="{x:Bind res:Bind.VisibleIfText(Badge)}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Badge}" />
                </Border>
            </Grid>
        </DataTemplate>
        <calendars:AgendaTemplateSelector
            x:Key="EntrySelector"
            HeadingTemplate="{StaticResource HeadingTemplate}"
            ItemTemplate="{StaticResource ItemTemplate}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="HeadingText"
            Margin="20,10,20,4"
            AutomationProperties.AutomationId="CalendarListHeading"
            AutomationProperties.HeadingLevel="Level1"
            MaxLines="1"
            Style="{StaticResource SubtitleTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed" />
        <ListView
            x:Name="List"
            Grid.Row="1"
            Padding="0,0,0,8"
            AutomationProperties.AutomationId="CalendarAgendaList"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemTemplateSelector="{StaticResource EntrySelector}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Margin="40,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="CalendarListEmpty"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
