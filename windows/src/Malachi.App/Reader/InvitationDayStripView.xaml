Port of macos/Sources/MalachiMail/MessageView/InvitationDayStripView.swift;
GTK: none yet (docs/calendar.md §5.7, Cal.DayStripOf). The invitation
card's mini day strip: an axis over the working hours of the invitation's
day with its whole hours labelled underneath, the busy spans of the
visible calendars as grey blocks, and the invitation's own slot as a
dashed blue block with its time above it. Drawn in code on the canvas
(InvitationDayStripView.xaml.cs); everything drawn is geometry and the
application's own time strings. A screen reader reads the card's clock
and conflict lines instead, so the strip is no element of its own.
-->
<UserControl
    x:Class="Malachi.App.Reader.InvitationDayStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False"
    Visibility="Collapsed">
    <UserControl.Resources>
        <!-- What the strip draws, by style: theme resources resolved in the
             window's theme and following it (a brush from the application's
             resources would have the theme of Windows). -->
        <Style x:Key="DayStripAxisStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="DayStripTickStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="DayStripLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <!-- The invitation's slot: a faint fill under a dashed outline, and
             its time, in the attention colour. -->
        <Style x:Key="DayStripSlotFillStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorAttentionBrush}" />
            <Setter Property="Opacity" Value="0.15" />
        </Style>
        <Style x:Key="DayStripSlotStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="{ThemeResource SystemFillColorAttentionBrush}" />
        </Style>
        <Style x:Key="DayStripSlotLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
        </Style>
    </UserControl.Resources>
    <Canvas
        x:Name="Surface"
        HorizontalAlignment="Stretch"
        SizeChanged="OnSizeChanged" />
</UserControl>
