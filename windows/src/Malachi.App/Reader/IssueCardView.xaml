SPDX-License-Identifier: GPL-3.0-or-later

Port of ui/internal/window/issue_card.go (newIssueCard; the card and
issue-card classes, button.issue-key, menubutton.issue-status-button of
ui/internal/style); macOS: MessageView/IssueCardView.swift and
IssueStatusPill. The issue card over the headers of a Jira message: the key
as a link to the issue (plain, selectable text where it may not open), the
status as a pill, which is the Change Status menu where the account
changes statuses (a spinner in it while a transition runs), the Internal
badge of an internal service-desk comment, who relayed the comment ("via
…") and whether it was edited, then Assignee, Priority, Type and Reporter
wrapping as the width allows. Core's IssueCardState says what; every text
but the labels comes from the site and is plain.
-->
<UserControl
    x:Class="Malachi.App.Reader.IssueCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:reader="using:Malachi.App.Reader"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- menubutton.issue-status-button: the pill's shape and colours,
                 its fill switched by the visual states below. -->
            <Style x:Key="StatusButtonStyle" TargetType="DropDownButton" BasedOn="{StaticResource DefaultDropDownButtonStyle}">
                <Setter Property="Padding" Value="8,1,6,1" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="Card"
        Padding="12,10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusKinds">
                <VisualState x:Name="Plain">
                    <VisualState.Setters>
                        <Setter Target="StatusButton.Background" Value="{ThemeResource IssuePillPlainBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="InProgress">
                    <VisualState.Setters>
                        <Setter Target="StatusButton.Background" Value="{ThemeResource IssuePillInProgressBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Done">
                    <VisualState.Setters>
                        <Setter Target="StatusButton.Background" Value="{ThemeResource IssuePillDoneBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="6">
            <reader:WrapBox ChildSpacing="8" LineSpacing="4">
                <!-- The key: a link to the issue on the account's own site. -->
                <HyperlinkButton
                    x:Name="KeyButton"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="IssueKeyButton"
                    Click="OnKeyClick">
                    <TextBlock x:Name="KeyButtonText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                </HyperlinkButton>
                <TextBlock
                    x:Name="KeyLabel"
                    VerticalAlignment="Center"
                    FontSize="16"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <!-- The Change Status menu (transitionMenu): its items are
                     built when it opens (IssueCardView.xaml.cs). -->
                <DropDownButton
                    x:Name="StatusButton"
                    AutomationProperties.AutomationId="IssueStatusButton"
                    Style="{StaticResource StatusButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Name="StatusText"
                            MaxWidth="170"
                            VerticalAlignment="Center"
                            FontSize="11"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <ProgressRing
                            x:Name="StatusSpinner"
                            Width="12"
                            Height="12"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="StatusMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <controls:IssuePill x:Name="PlainStatus" />
                <controls:IssuePill x:Name="InternalPill" IsInternal="True" />
                <TextBlock
                    x:Name="ViaLabel"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="EditedLabel"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    Style="{StaticResource DimCaptionLabelStyle}" />
            </reader:WrapBox>
            <!-- Assignee, Priority, Type, Reporter (jira.Card.Rows). -->
            <reader:WrapBox x:Name="Fields" ChildSpacing="16" LineSpacing="4" />
        </StackPanel>
    </Border>
</UserControl>
