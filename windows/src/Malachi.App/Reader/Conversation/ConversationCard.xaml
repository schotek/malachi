SPDX-License-Identifier: GPL-3.0-or-later

Port of ui/internal/window/conversation_card.go (newConvCard, buildHeader,
makeDetails, makeBulkBar, makeRemoteBar, makePicturesBar, convBar); macOS:
MessageView/ConversationCardView.swift and ConversationCardHeader.swift.
One message of the conversation view, a card with a hairline border and
rounded corners that clip its body: the top part (card padding less the
border) with the header (the fold arrow, every card's, the unread dot, the sender, the recipients' disclosure, the
Jira badges via, Internal and Edited, which go to a second line where they
do not fit, then the hover buttons, which keep their room while hidden, and
the date), the recipients, the attachment chips and the hint; the folded
card's preview; the bulk-mail, remote-image and pictures bars; and the body: the wait,
plain text, or the HTML host, white, in which the card's web view sits
while the card is live; and under it the "•••" that shows or hides the
quoted history the daemon cut (ConversationCardView.swift quotedButton). A
double click on the header, the padding above it included, opens the
message as one on its row in the list does (openOnDoubleClick). Every text is set in code, plain (Text properties
only); the web view gets the sanitiser's output only.
-->
<UserControl
    x:Class="Malachi.App.Reader.Conversation.ConversationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:l="using:Malachi.App.Localization"
    xmlns:reader="using:Malachi.App.Reader"
    IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Reader/ChipStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Reader/Conversation/ConversationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        x:Name="Frame"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10"
        DoubleTapped="OnFrameDoubleTapped">
        <StackPanel x:Name="Root">
            <StackPanel
                x:Name="Top"
                Margin="13,9,13,8"
                Spacing="8">
                <Grid x:Name="Header" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <reader:WrapBox ChildSpacing="8" LineSpacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="FoldButton"
                                AutomationProperties.AutomationId="ConversationFold"
                                Click="OnFoldClick"
                                Style="{StaticResource ConversationCardButtonStyle}"
                                Visibility="Collapsed">
                                <FontIcon x:Name="FoldGlyph" FontSize="12" />
                            </Button>
                            <Ellipse x:Name="UnreadDot" Style="{StaticResource ConversationUnreadStyle}" Visibility="Collapsed" />
                            <TextBlock x:Name="SenderLabel" Style="{StaticResource ConversationSenderStyle}" />
                            <ToggleButton
                                x:Name="Disclosure"
                                AutomationProperties.AutomationId="ConversationRecipients"
                                Click="OnDisclosureClick"
                                Style="{StaticResource ConversationCardToggleStyle}">
                                <FontIcon x:Name="DisclosureGlyph" FontSize="12" />
                            </ToggleButton>
                        </StackPanel>
                        <TextBlock
                            x:Name="ViaLabel"
                            VerticalAlignment="Center"
                            MaxLines="1"
                            Style="{StaticResource ConversationCaptionStyle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                        <controls:IssuePill x:Name="InternalPill" IsInternal="True" />
                        <TextBlock
                            x:Name="EditedLabel"
                            VerticalAlignment="Center"
                            Style="{StaticResource ConversationCaptionStyle}"
                            Visibility="Collapsed" />
                    </reader:WrapBox>
                    <!-- The hover buttons: shown while the pointer is over the card
                         or one of them has the focus; hidden, they keep their room
                         (the header's height never changes) and take no clicks, but
                         Tab still reaches them. -->
                    <StackPanel
                        x:Name="Buttons"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="ReplyButton"
                            AutomationProperties.AutomationId="ConversationReply"
                            Click="OnReplyClick"
                            Style="{StaticResource ConversationCardButtonStyle}">
                            <FontIcon x:Name="ReplyGlyph" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="ReplyAllButton"
                            AutomationProperties.AutomationId="ConversationReplyAll"
                            AutomationProperties.Name="{l:T Msgid='Reply All'}"
                            Click="OnReplyAllClick"
                            Style="{StaticResource ConversationCardButtonStyle}"
                            ToolTipService.ToolTip="{l:T Msgid='Reply All'}">
                            <FontIcon x:Name="ReplyAllGlyph" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="ForwardButton"
                            AutomationProperties.AutomationId="ConversationForward"
                            AutomationProperties.Name="{l:T Msgid='Forward'}"
                            Click="OnForwardClick"
                            Style="{StaticResource ConversationCardButtonStyle}"
                            ToolTipService.ToolTip="{l:T Msgid='Forward'}">
                            <FontIcon x:Name="ForwardGlyph" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        x:Name="DateLabel"
                        Grid.Column="2"
                        Margin="0,3,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource ConversationCaptionStyle}" />
                </Grid>

                <!-- The recipients (window.blp message_addresses), made when first opened. -->
                <Grid
                    x:Name="Details"
                    x:Load="False"
                    ColumnSpacing="12"
                    RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="FromLabel"
                        Margin="0,3,0,0"
                        Style="{StaticResource ConversationCaptionStyle}"
                        Text="{l:T Msgid='From'}" />
                    <reader:WrapBox
                        x:Name="FromChips"
                        Grid.Column="1"
                        ChildSpacing="4"
                        LineSpacing="4" />
                    <TextBlock
                        x:Name="ToLabel"
                        Grid.Row="1"
                        Margin="0,3,0,0"
                        Style="{StaticResource ConversationCaptionStyle}"
                        Text="{l:T Msgid='To'}" />
                    <reader:WrapBox
                        x:Name="ToChips"
                        Grid.Row="1"
                        Grid.Column="1"
                        ChildSpacing="4"
                        LineSpacing="4" />
                    <TextBlock
                        x:Name="CcLabel"
                        Grid.Row="2"
                        Margin="0,3,0,0"
                        Style="{StaticResource ConversationCaptionStyle}"
                        Text="{l:T Msgid='Cc'}" />
                    <reader:WrapBox
                        x:Name="CcChips"
                        Grid.Row="2"
                        Grid.Column="1"
                        ChildSpacing="4"
                        LineSpacing="4" />
                </Grid>

                <reader:WrapBox
                    x:Name="Chips"
                    ChildSpacing="6"
                    LineSpacing="6"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="Hint"
                    Style="{StaticResource ConversationCaptionStyle}"
                    Text="{l:T Msgid='The formatted version of this message could not be shown safely; this is its plain text.'}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- The folded card's preview: the summary's snippet, two lines at
                 most; a click opens the card. -->
            <TextBlock
                x:Name="Preview"
                Margin="13,0,13,9"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="2"
                Tapped="OnPreviewTapped"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- The remote-image bar and the pictures bar (window.blp remote_bar,
                 pictures_bar), made when first shown. -->
            <StackPanel x:Name="Bars">
                <!-- bulk_bar, the first of the bars (window/bulk.go makeBulkBar):
                     what the message is and the Unsubscribe button. -->
                <reader:BulkStripView
                    x:Name="BulkBar"
                    BarPadding="13,6"
                    x:Load="False"
                    ActionClicked="OnBulkClick" />
                <Border
                    x:Name="RemoteBar"
                    Padding="13,6"
                    x:Load="False"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="Collapsed">
                    <reader:BarPanel LineSpacing="6" Spacing="12">
                        <ProgressRing
                            x:Name="RemoteSpinner"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="RemoteLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="RemoteLoad"
                            VerticalAlignment="Center"
                            AllowFocusOnInteraction="False"
                            Click="OnLoadImagesClick"
                            l:MnemonicLabel.Text="{l:T Msgid='Load _Images'}" />
                        <Button
                            x:Name="RemoteTrust"
                            VerticalAlignment="Center"
                            AllowFocusOnInteraction="False"
                            Click="OnTrustSenderClick"
                            ToolTipService.ToolTip="{l:T Msgid='Load remote images now and whenever this sender writes'}"
                            l:MnemonicLabel.Text="{l:T Msgid='Always From This _Sender'}" />
                    </reader:BarPanel>
                </Border>
                <Border
                    x:Name="PicturesBar"
                    Padding="13,6"
                    x:Load="False"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="Collapsed">
                    <reader:BarPanel LineSpacing="6" Spacing="12">
                        <ProgressRing
                            x:Name="PicturesSpinner"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="PicturesLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="PicturesDownload"
                            VerticalAlignment="Center"
                            AllowFocusOnInteraction="False"
                            Click="OnDownloadPicturesClick"
                            l:MnemonicLabel.Text="{l:T Msgid='_Download Pictures'}" />
                    </reader:BarPanel>
                </Border>
            </StackPanel>

            <!-- The body: the wait, the plain text, or the HTML. -->
            <Grid x:Name="Body">
                <TextBlock
                    x:Name="WaitLabel"
                    Height="160"
                    Margin="13,0,13,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource ConversationCaptionStyle}"
                    Text="{l:T Msgid='Loading…'}" />
                <TextBlock
                    x:Name="TextBody"
                    Margin="13,2,13,9"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Grid
                    x:Name="HtmlHost"
                    Background="White"
                    Visibility="Collapsed" />
            </Grid>

            <!-- The "•••" under the body, while the card is open. -->
            <reader:QuotedTextButton
                x:Name="QuotedButton"
                Margin="13,6,13,9"
                Click="OnQuotedClick" />
        </StackPanel>
    </Border>
</UserControl>
