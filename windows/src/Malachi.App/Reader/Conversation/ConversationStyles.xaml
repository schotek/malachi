SPDX-License-Identifier: GPL-3.0-or-later

Port of ui/internal/window/conversation_rows.go (convCSS); macOS:
ConversationRow.swift and ConversationCardView.swift (the colours). The
look of the conversation view, whose rows and cards are built in code: the
timeline's line and dots (alpha(currentColor, 0.3): the disabled text
colour), the card's small flat buttons (.conversation-card-button: 24 wide,
20 high), the sender (.conversation-sender: semibold), the unread dot, the
texts in small secondary type, and the frame of a draft card (a message
card's, for the card built in code); for the chat layout
(docs/plans/chat-view.md D3, D6; macOS ConversationBubbleView.swift and
ConversationTint, GTK convCSS .chat-bubble, .chat-bubble-mine,
.chat-placeholder) the bubble's frame, the user's own bubble (the card's
fill under a tint of the accent colour at 12 % and a border of the accent
colour; high contrast: the window's colours and the highlight's border),
the others' bubble (the card's fill under 6 % of the text colour, a light
grey; high contrast: the window's colour),
the dimmed placeholder, and the paperclip pill (the issue pill in the bulk
tag's colours), and the chat layout's toggle (its size and type,
ConversationChatToggleStyle; its checked colours are
ConversationChatToggle.xaml). Merged into the conversation view with
ChipStyles.xaml, and in code into the board's conversation block
(BoardConversationBlock.cs, whose chat shows the same bubbles and toggle),
so that the theme resources follow the window's colour scheme; not into
App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The recipients' disclosure is a flat toggle: open, it keeps the
         subtle tint of a pressed flat button rather than WinUI's accent
         block (GTK's flat toggle). The layout toggle overrides these in its
         own resources (ConversationChatToggle.xaml).
         High contrast keeps WinUI's own. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <SolidColorBrush x:Key="ConversationMineBubbleTintBrush" Opacity="0.12" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="ConversationOtherBubbleTintBrush" Opacity="0.06" Color="White" />
            <StaticResource x:Key="ConversationMineBubbleBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <SolidColorBrush x:Key="ConversationMineBubbleTintBrush" Opacity="0.12" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="ConversationOtherBubbleTintBrush" Opacity="0.06" Color="Black" />
            <StaticResource x:Key="ConversationMineBubbleBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ConversationMineBubbleTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ConversationOtherBubbleTintBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ConversationMineBubbleBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="ConversationLineStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
    </Style>
    <Style x:Key="ConversationDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource TextFillColorDisabledBrush}" />
    </Style>
    <Style x:Key="ConversationUnreadStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style
        x:Key="ConversationCardButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The chat layout's toggle (Mail's strip, the board's conversation
         heading): its size and type; its checked colours are
         ConversationChatToggle.xaml, merged into the toggle's own
         resources. -->
    <Style x:Key="ConversationChatToggleStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="8,3,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ConversationCardToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A draft card (ConversationDraftView): the frame of a message card
         (ConversationCard.xaml Frame), built in code. -->
    <Style x:Key="ConversationDraftCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="ConversationSenderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="ConversationCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A bubble of the chat (ConversationBubbleView): someone else's is a
         card, 1 px inside it to the padding of a card's header (13, 9). -->
    <Style x:Key="ConversationBubbleStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- The user's own bubble: the card's fill under the tint (its inner
         layer, ConversationMineTintStyle) and a border of the accent colour. -->
    <Style x:Key="ConversationMineBubbleStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ConversationMineBubbleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="ConversationMineTintStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ConversationMineBubbleTintBrush}" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <!-- The others' bubble: a light grey, 6 % of the text's colour (black
         in the light theme, white in the dark) over the card's fill, so it
         stands apart from the white cards and the pane; high contrast keeps
         the system's window colour. A transparent chat web view shows it. -->
    <Style x:Key="ConversationOtherTintStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ConversationOtherBubbleTintBrush}" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <!-- The bubble's text: the theme's text, or the snippet dimmed while the
         body is not there (.chat-placeholder). -->
    <Style x:Key="ConversationBubbleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>
    <!-- The links of a bubble's HTML document in the dark theme (its
         Foreground is read, ConversationBubbleView.Palette). -->
    <Style x:Key="ConversationBubbleLinkStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="ConversationBubblePlaceholderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>
    <!-- The paperclip pill of a bubble's header (macOS ConversationClipPill):
         an issue pill, a little tighter at the sides, in the bulk tag's
         colours (BulkPillForegroundBrush on the plain fill). -->
    <Style
        x:Key="ConversationClipPillStyle"
        BasedOn="{StaticResource IssuePillBorderStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="6,1,6,1" />
    </Style>
    <Style x:Key="ConversationClipIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource BulkPillForegroundBrush}" />
    </Style>
    <Style
        x:Key="ConversationClipCountStyle"
        BasedOn="{StaticResource IssuePillTextStyle}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource BulkPillForegroundBrush}" />
    </Style>
</ResourceDictionary>
