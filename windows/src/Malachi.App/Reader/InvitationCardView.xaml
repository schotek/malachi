SPDX-License-Identifier: GPL-3.0-or-later

Port of macos/Sources/MalachiMail/MessageView/InvitationCardView.swift
(build, the date tile InvitationDateTile, the proposal popover
InvitationProposalViewController); GTK: none yet (docs/calendar.md §5.7,
artboard 4). The invitation card above a message's header, in the reading
pane, a message window and a conversation card, drawn from an
InvitationController (the parsed part of message.get, never its HTML):
the date tile at the start; the pill and the bold title; the clock line,
an update's former values, the location with Join Video Call, the people
line, the conflict strip, the mini day strip; then "Add to:" (a ComboBox
of the targets, a label when the server chose the calendar, nothing
without targets) with Accept / Tentative / Decline (its menu has Decline
Without Reply), the reply note and Propose New Time…. After answering the
state strip with Change Response and Show in Calendar replaces the
buttons; the user's own event has its state line with Show in Calendar. A
reply message is one line beside its pill, a cancellation says so and
offers Remove from Calendar. Every string is a TextBlock.Text set from
code (InvitationCardView.xaml.cs); the card is collapsed for none.
-->
<UserControl
    x:Class="Malachi.App.Reader.InvitationCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Malachi.App.Controls"
    xmlns:reader="using:Malachi.App.Reader"
    AutomationProperties.AutomationId="InvitationCard"
    IsTabStop="False"
    Visibility="Collapsed">
    <Border
        x:Name="Card"
        Padding="12,10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <VisualStateManager.VisualStateGroups>
            <!-- The tile's band in the pill's colour. -->
            <VisualStateGroup x:Name="Bands">
                <VisualState x:Name="BandInvitation" />
                <VisualState x:Name="BandUpdate">
                    <VisualState.Setters>
                        <Setter Target="TileBand.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="BandCancelled">
                    <VisualState.Setters>
                        <Setter Target="TileBand.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- The conflict strip: orange with conflicts, grey without. -->
            <VisualStateGroup x:Name="Conflicts">
                <VisualState x:Name="NoConflict">
                    <VisualState.Setters>
                        <Setter Target="ConflictLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="ConflictIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Conflict">
                    <VisualState.Setters>
                        <Setter Target="ConflictLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="ConflictIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="Outer" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The date tile: the weekday on a band in the pill's colour,
                 the day large, the month under it. -->
            <Border
                x:Name="Tile"
                Width="52"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Border
                        x:Name="TileBand"
                        Padding="2"
                        Background="{ThemeResource SystemFillColorAttentionBrush}"
                        CornerRadius="7,7,0,0">
                        <TextBlock
                            x:Name="TileWeekday"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorInverseBrush}"
                            MaxLines="1"
                            TextTrimming="Clip" />
                    </Border>
                    <TextBlock
                        x:Name="TileDay"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        MaxLines="1" />
                    <TextBlock
                        x:Name="TileMonth"
                        Margin="2,0,2,6"
                        HorizontalAlignment="Center"
                        MaxLines="1"
                        Style="{StaticResource DimCaptionLabelStyle}"
                        TextTrimming="Clip" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="Column"
                Grid.Column="1"
                Spacing="4">
                <!-- The pill and the bold title (a reply's one line). -->
                <Grid x:Name="TitleRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:InvitationPill x:Name="Pill" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <TextBlock
                        x:Name="TitleLabel"
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        MaxLines="2"
                        Style="{StaticResource HeadingLabelStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Grid>
                <TextBlock
                    x:Name="ClockLabel"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyLabelStyle}"
                    TextWrapping="Wrap" />
                <!-- An update's former values, one grey line each. -->
                <StackPanel x:Name="PreviousStack" Spacing="2" />
                <Grid x:Name="LocationRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="LocationLabel"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyLabelStyle}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Name="JoinButton"
                        Grid.Column="1"
                        Padding="4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="InvitationJoin"
                        Click="OnJoinClick" />
                </Grid>
                <TextBlock
                    x:Name="PeopleLabel"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource DimCaptionLabelStyle}"
                    TextWrapping="Wrap" />
                <!-- The conflict strip ("No conflicts in your calendars" without one). -->
                <Grid
                    x:Name="ConflictRow"
                    Margin="0,0,0,2"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="ConflictIcon"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12" />
                    <TextBlock
                        x:Name="ConflictLabel"
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource CaptionLabelStyle}"
                        TextWrapping="Wrap" />
                </Grid>
                <reader:InvitationDayStripView x:Name="DayStrip" Margin="0,0,0,4" />
                <!-- A line for an invitation that cannot be answered; the
                     user's own event has Show in Calendar on it. -->
                <Grid x:Name="StateRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StateLabel"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource DimCaptionLabelStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="StateShowButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="InvitationShowInCalendar"
                        Click="OnShowClick" />
                </Grid>
                <!-- Add to: with Accept / Tentative / Decline. -->
                <reader:WrapBox
                    x:Name="ActionsRow"
                    ChildSpacing="8"
                    LineSpacing="6">
                    <TextBlock
                        x:Name="AddToLabel"
                        VerticalAlignment="Center"
                        Style="{StaticResource DimLabelStyle}" />
                    <ComboBox
                        x:Name="TargetBox"
                        MinWidth="160"
                        MaxWidth="280"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="InvitationTarget"
                        SelectionChanged="OnTargetChanged" />
                    <TextBlock
                        x:Name="TargetLabel"
                        MaxWidth="280"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="InvitationTargetLabel"
                        MaxLines="1"
                        Style="{StaticResource BodyLabelStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="AcceptButton"
                        AutomationProperties.AutomationId="InvitationAccept"
                        Click="OnAcceptClick"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="TentativeButton"
                        AutomationProperties.AutomationId="InvitationTentative"
                        Click="OnTentativeClick" />
                    <SplitButton
                        x:Name="DeclineButton"
                        AutomationProperties.AutomationId="InvitationDecline"
                        Click="OnDeclineClick">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    x:Name="DeclineWithoutReplyItem"
                                    AutomationProperties.AutomationId="InvitationDeclineWithoutReply"
                                    Click="OnDeclineWithoutReplyClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <ProgressRing
                        x:Name="Spinner"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />
                </reader:WrapBox>
                <!-- After answering: the state strip, Change Response, Show in Calendar. -->
                <Grid x:Name="StripRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="CheckIcon"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        x:Name="StripLabel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyLabelStyle}"
                        TextWrapping="Wrap" />
                    <DropDownButton
                        x:Name="ChangeButton"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="InvitationChangeResponse">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ChangeMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        x:Name="ShowButton"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="InvitationShowInCalendar"
                        Click="OnShowClick" />
                </Grid>
                <!-- A cancellation's Remove from Calendar. -->
                <StackPanel x:Name="CancelRow" Orientation="Horizontal">
                    <Button
                        x:Name="RemoveButton"
                        AutomationProperties.AutomationId="InvitationRemove"
                        Click="OnRemoveClick" />
                </StackPanel>
                <!-- The reply note under the buttons. -->
                <StackPanel x:Name="NotesStack" Spacing="2" />
                <StackPanel x:Name="ProposeRow" Orientation="Horizontal">
                    <Button
                        x:Name="ProposeButton"
                        Padding="8,2"
                        AutomationProperties.AutomationId="InvitationPropose"
                        FontSize="12">
                        <Button.Flyout>
                            <Flyout
                                x:Name="ProposeFlyout"
                                Opening="OnProposeOpening"
                                Placement="Bottom">
                                <StackPanel MinWidth="280" Spacing="10">
                                    <TextBlock x:Name="ProposeHeading" Style="{StaticResource HeadingLabelStyle}" />
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            x:Name="StartsLabel"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyLabelStyle}" />
                                        <CalendarDatePicker
                                            x:Name="StartDate"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="InvitationProposeStartDate"
                                            DateChanged="OnProposalChanged" />
                                        <TimePicker
                                            x:Name="StartTime"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="InvitationProposeStartTime"
                                            TimeChanged="OnProposalTimeChanged" />
                                        <TextBlock
                                            x:Name="EndsLabel"
                                            Grid.Row="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyLabelStyle}" />
                                        <CalendarDatePicker
                                            x:Name="EndDate"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="InvitationProposeEndDate"
                                            DateChanged="OnProposalChanged" />
                                        <TimePicker
                                            x:Name="EndTime"
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            AutomationProperties.AutomationId="InvitationProposeEndTime"
                                            TimeChanged="OnProposalTimeChanged" />
                                    </Grid>
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            x:Name="ProposalCancel"
                                            AutomationProperties.AutomationId="InvitationProposeCancel"
                                            Click="OnProposalCancelClick" />
                                        <Button
                                            x:Name="ProposalSend"
                                            AutomationProperties.AutomationId="InvitationProposeSend"
                                            Click="OnProposalSendClick"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="ErrorLabel"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionLabelStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
