malachi-credentials.exe: the daemon's keyring helper over Windows Credential
Manager (MALACHI_KEYRING=helper, the protocol of
backend/internal/auth/helper; docs/windows-port.md §10). It depends on
nothing else of the client. The GUI subsystem keeps a console window from
flashing on every call, and NativeAOT keeps a process per operation cheap.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>malachi-credentials</AssemblyName>
    <RootNamespace>Malachi.Credentials</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <!-- The NativeAOT runtime in step with the compiler pinned in
         Directory.Build.targets (Directory.Packages.props). -->
    <RuntimeFrameworkVersion>$(MalachiSdkPackVersion)</RuntimeFrameworkVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Malachi.Credentials.Tests" />
  </ItemGroup>
</Project>
