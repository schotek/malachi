<!--
SPDX-FileCopyrightText: 2026 Vladislav Janeček
SPDX-License-Identifier: GPL-3.0-or-later

Every NuGet version of the Windows client, in one place. The projects name
packages without versions; each project's packages.lock.json records what
the restore resolved and is committed. A new package needs its reason in
the commit message (CLAUDE.md); the set below is the one decided in
docs/windows-port.md §0.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The packages the SDK adds by itself: the trimming analyzers
         (Microsoft.NET.ILLink.Tasks, for IsAotCompatible) and the NativeAOT
         compiler of malachi-credentials with its runtime. The SDK takes the
         version of the runtime it bundles, so the lock files would change
         with every SDK that global.json rolls forward to, and a locked
         restore on CI would fail over it. Pinned here instead
         (Directory.Build.targets, Malachi.Credentials.csproj); raise it
         with a .NET servicing release. -->
    <MalachiSdkPackVersion>10.0.11</MalachiSdkPackVersion>
    <!-- The Windows App SDK release the component packages below belong
         to. Its Runtime package is only downloaded (Malachi.App.csproj,
         PackageDownload, which takes an exact version and no central
         entry): one DLL of its framework MSIX is missing from the
         component packages (docs/windows-port.md §10). Raise it with the
         component versions, and re-test AppNotificationManager.Register()
         without that DLL on every bump. -->
    <MalachiWindowsAppRuntimeVersion>2.5.1</MalachiWindowsAppRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The app: WinUI 3 and WebView2 as the component packages of
         Windows App SDK 2.5.1 (spikes2/APP-SPIKES.md §1): the metapackage
         adds ~60 MB of AI and ML runtime a mail client never uses.
         InteractiveExperiences is pinned to 2.1.9 because WinUI 2.3.9 asks
         for 2.1.8, which was never published (NU1603). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!-- Only as ExcludeAssets="all" (Malachi.App.csproj): the toolkit's 8.2
         packages depend on the metapackage 1.6, which would otherwise come
         in whole beside the 2.x components (MSB4011, APP-SPIKES.md §2.1). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <!-- Core and the platform services. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- SIWC ID tokens are validated by the maintained Microsoft JWT library. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />
    <!-- Tests: xUnit v3 on Microsoft.Testing.Platform (global.json). -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- The strings check of Malachi.Conventions.Tests (docs/windows-port.md
         §9): the C# parser, to find the msgids handed to L10n.T/N/C. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
