using Gtk 4.0;
using Adw 1;
// The Add CalDAV Calendar sheet (docs/calendar.md §5.9, §6.5 G17;
// window/calendar_caldav.go over calendarctl.CalDAVWizardController, the
// port of CalDAVSheetController.swift). Every text is set from Go (the
// reference is ui/internal/calendar/caldav.go), so this file has no
// translatable strings. Everything from the server is plain text.
Adw.Dialog caldav_sheet {
  content-width: 560;
  content-height: 560;
  focus-widget: caldav_server;

  child: Adw.ToolbarView caldav_sheet_page {
    [top]
    Adw.HeaderBar caldav_sheet_header {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button caldav_cancel {
        can-shrink: true;
      }

      [end]
      Button caldav_add {
        can-shrink: true;

        styles [
          "suggested-action",
        ]
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;

      child: Adw.Clamp {
        maximum-size: 512;

        child: Box caldav_column {
          orientation: vertical;
          spacing: 14;
          margin-top: 12;
          margin-bottom: 24;
          margin-start: 24;
          margin-end: 24;

          // The servers it speaks to.
          Label caldav_subtitle {
            use-markup: false;
            wrap: true;
            xalign: 0;

            styles [
              "dim-label",
            ]
          }

          ListBox caldav_fields {
            selection-mode: none;

            styles [
              "boxed-list",
            ]

            Adw.EntryRow caldav_name {
              use-markup: false;
            }

            Adw.EntryRow caldav_server {
              use-markup: false;
              input-purpose: url;
              input-hints: no_spellcheck;
            }

            Adw.EntryRow caldav_username {
              use-markup: false;
              input-hints: no_spellcheck;
            }

            Adw.PasswordEntryRow caldav_password {
              use-markup: false;
            }
          }

          // The password goes to the keyring.
          Label caldav_password_note {
            use-markup: false;
            wrap: true;
            xalign: 0;

            styles [
              "dim-label",
              "caption",
            ]
          }

          Box {
            spacing: 10;

            Button caldav_discover {
              halign: start;
            }

            Spinner caldav_spinner {
              visible: false;
            }

            Label caldav_progress {
              use-markup: false;
              ellipsize: end;
              xalign: 0;
              hexpand: true;

              styles [
                "dim-label",
              ]
            }
          }

          // The error: as wide as the cards, wrapping.
          Box caldav_error {
            spacing: 10;
            visible: false;

            styles [
              "card",
            ]

            Image {
              icon-name: "dialog-warning-symbolic";
              valign: start;
              margin-top: 10;
              margin-start: 12;

              styles [
                "error",
              ]
            }

            Label caldav_error_label {
              use-markup: false;
              wrap: true;
              wrap-mode: word_char;
              xalign: 0;
              hexpand: true;
              margin-top: 10;
              margin-bottom: 10;
              margin-end: 12;
            }
          }

          // The calendars are at another host (a redirect).
          Label caldav_server_changed {
            use-markup: false;
            wrap: true;
            wrap-mode: word_char;
            xalign: 0;
            visible: false;

            styles [
              "dim-label",
            ]
          }

          ListBox caldav_certificate_list {
            selection-mode: none;
            visible: false;

            styles [
              "boxed-list",
            ]

            Adw.ActionRow caldav_certificate {
              use-markup: false;
              subtitle-selectable: true;

              [suffix]
              Button caldav_trust {
                valign: center;
                visible: false;
              }
            }
          }

          // "Calendars", the found line and the calendars with checkboxes.
          Box caldav_calendars_box {
            orientation: vertical;
            spacing: 6;
            visible: false;

            Label caldav_calendars_heading {
              use-markup: false;
              xalign: 0;

              styles [
                "heading",
              ]
            }

            Label caldav_found {
              use-markup: false;
              wrap: true;
              xalign: 0;

              styles [
                "dim-label",
                "caption",
              ]
            }

            ListBox caldav_calendars {
              selection-mode: none;
              margin-top: 6;

              styles [
                "boxed-list",
              ]
            }
          }

          // "Address Books" and the server's CardDAV collections, without
          // checkboxes: which are shown is chosen in Preferences → Contacts.
          Box caldav_books_box {
            orientation: vertical;
            spacing: 6;
            visible: false;

            Label caldav_books_heading {
              use-markup: false;
              xalign: 0;

              styles [
                "heading",
              ]
            }

            ListBox caldav_books {
              selection-mode: none;
              margin-top: 6;

              styles [
                "boxed-list",
              ]
            }
          }

          ListBox caldav_mail_list {
            selection-mode: none;
            visible: false;

            styles [
              "boxed-list",
            ]

            Adw.ComboRow caldav_mail {
              use-markup: false;
            }
          }

          Label caldav_footer {
            use-markup: false;
            wrap: true;
            xalign: 0;

            styles [
              "dim-label",
              "caption",
            ]
          }
        };
      };
    };
  };
}
