using Gtk 4.0;
using Adw 1;
// Stand-alone message window, opened by double-clicking (or Enter on) a row
// in the message list. Object IDs are looked up from
// ui/internal/window/message_window.go; keep them in sync.
Adw.Window message_window {
  default-width: 820;
  default-height: 620;
  width-request: 360;
  height-request: 294;
  focus-widget: message_scroller;

  ShortcutController {
    Shortcut {
      trigger: "Escape";
      action: "action(window.close)";
    }
  }

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Message");
      };

      [start]
      Button reply_button {
        icon-name: "mail-reply-sender-symbolic";
        tooltip-text: _("Reply");
      }

      [start]
      Button reply_all_button {
        icon-name: "mail-reply-all-symbolic";
        tooltip-text: _("Reply All");
      }

      [start]
      Button forward_button {
        icon-name: "mail-forward-symbolic";
        tooltip-text: _("Forward");
      }

      [end]
      Button trash_button {
        icon-name: "user-trash-symbolic";
        tooltip-text: _("Move to Trash");
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: ScrolledWindow message_scroller {
        hscrollbar-policy: never;
        // Receives the initial focus (see focus-widget on the window) so the
        // selectable subject label is not focused and select-all'd on open.
        focusable: true;

        child: Adw.Clamp {
          maximum-size: 900;
          tightening-threshold: 700;

          child: Box {
            orientation: vertical;
            spacing: 12;
            margin-start: 24;
            margin-end: 24;
            margin-top: 24;
            margin-bottom: 24;

            Label message_subject {
              xalign: 0;
              wrap: true;
              selectable: true;

              styles [
                "title-2",
              ]
            }

            Label message_from {
              xalign: 0;
              wrap: true;
              selectable: true;

              styles [
                "dim-label",
              ]
            }

            Separator {}

            // Plain-text placeholder; see window.blp for the rendering note.
            Label message_body {
              xalign: 0;
              yalign: 0;
              wrap: true;
              wrap-mode: word_char;
              selectable: true;
              vexpand: true;
              // Zoom and font come from ui/internal/style.
              styles [
                "message-body",
              ]
            }
          };
        };
      };
    };
  };
}
