using Gtk 4.0;
using Adw 1;
// Compose window. Object IDs are looked up from ui/internal/compose;
// keep them in sync. The rich-text editor (ui/internal/editor) is appended
// to editor_slot from Go. In comment mode (compose/comment.go)
// comment_header replaces header_rows, and the toolbar keeps the controls
// of a comment's formats (their ids are compose/comment.go toolbarFormats).
Adw.Window compose_window {
  title: _("New Message");
  default-width: 760;
  default-height: 640;
  width-request: 360;
  height-request: 420;
  focus-widget: to_row;
  // Capture phase: these must win over the WebKit view, which otherwise
  // claims the key events.
  ShortcutController {
    propagation-phase: capture;

    Shortcut {
      trigger: "<Control>Return";
      action: "action(compose.send)";
    }

    Shortcut {
      trigger: "<Control>s";
      action: "action(compose.save)";
    }
  }

  // Bubble phase, as in message_window.blp, so in-window dialogs and
  // popovers see Escape first.
  ShortcutController {
    Shortcut {
      trigger: "Escape";
      action: "action(window.close)";
    }
  }

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("New Message");
      };

      [start]
      Button attach_button {
        icon-name: "mail-attachment-symbolic";
        tooltip-text: _("Attach Files");
        action-name: "compose.attach";
      }

      [end]
      Button send_button {
        action-name: "compose.send";
        tooltip-text: _("Send (Ctrl+Enter)");

        child: Adw.ButtonContent {
          icon-name: "mail-send-symbolic";
          label: _("_Send");
          use-underline: true;
        };

        styles [
          "suggested-action",
        ]
      }

      [end]
      MenuButton {
        icon-name: "view-more-symbolic";
        menu-model: compose_menu;
        tooltip-text: _("Draft Menu");
      }

      // The assistant's rewrite (ui/internal/assistant, the In App
      // target): icon, tooltip, visibility and rewrite_popover come from
      // Go (compose/rewrite.go).
      [end]
      Button rewrite_button {
        visible: false;
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Box {
        orientation: vertical;

        // One line per field: a label of uniform width (size_group below)
        // and the entry beside it. Adw.EntryRow stacks its title above the
        // text, which cost the header more height than the editor itself
        // had. Density is CSS (.compose-headers in ui/internal/style).
        Box header_rows {
          orientation: vertical;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 6;

          styles [
            "card",
            "compose-headers",
          ]

          Box {
            spacing: 12;

            Label from_label {
              label: _("From");
              xalign: 0;

              styles [
                "dim-label",
              ]
            }

            DropDown from_row {
              hexpand: true;

              accessibility {
                labelled-by: from_label;
              }

              styles [
                "flat",
              ]
            }
          }

          Separator {}

          Box {
            spacing: 12;

            Label to_label {
              label: _("To");
              xalign: 0;

              styles [
                "dim-label",
              ]
            }

            Entry to_row {
              hexpand: true;
              has-frame: false;

              accessibility {
                labelled-by: to_label;
              }
            }

            Button cc_bcc_button {
              label: _("Cc/Bcc");
              valign: center;

              styles [
                "flat",
              ]
            }
          }

          Separator cc_separator {
            visible: false;
          }

          Box cc_box {
            spacing: 12;
            visible: false;

            Label cc_label {
              label: _("Cc");
              xalign: 0;

              styles [
                "dim-label",
              ]
            }

            Entry cc_row {
              hexpand: true;
              has-frame: false;

              accessibility {
                labelled-by: cc_label;
              }
            }
          }

          Separator bcc_separator {
            visible: false;
          }

          Box bcc_box {
            spacing: 12;
            visible: false;

            Label bcc_label {
              label: _("Bcc");
              xalign: 0;

              styles [
                "dim-label",
              ]
            }

            Entry bcc_row {
              hexpand: true;
              has-frame: false;

              accessibility {
                labelled-by: bcc_label;
              }
            }
          }

          Separator {}

          Box {
            spacing: 12;

            Label subject_label {
              label: _("Subject");
              xalign: 0;

              styles [
                "dim-label",
              ]
            }

            Entry subject_row {
              hexpand: true;
              has-frame: false;

              accessibility {
                labelled-by: subject_label;
              }
            }
          }
        }

        // Comment mode only: the issue a comment goes to (title and
        // summary are set from Go, plain text from the site) and, on a
        // service-desk request, who reads it (toggles added from Go).
        Box comment_header {
          visible: false;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;
          margin-bottom: 6;

          styles [
            "card",
          ]

          Box {
            orientation: vertical;
            hexpand: true;
            spacing: 4;
            margin-start: 12;
            margin-end: 12;
            margin-top: 10;
            margin-bottom: 10;

            Box {
              spacing: 12;

              Label comment_title {
                xalign: 0;
                hexpand: true;
                ellipsize: end;
                use-markup: false;

                styles [
                  "heading",
                ]
              }

              Adw.ToggleGroup comment_visibility {
                visible: false;
                valign: center;
                homogeneous: true;
              }
            }

            Label comment_summary {
              visible: false;
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;
              lines: 2;
              ellipsize: end;
              use-markup: false;

              styles [
                "dim-label",
              ]
            }
          }
        }

        // Every control keeps focus in the editor so commands act on the
        // page selection.
        Box format_toolbar {
          orientation: horizontal;
          spacing: 2;
          margin-start: 6;
          margin-end: 6;

          styles [
            "toolbar",
          ]

          ToggleButton bold_button {
            icon-name: "format-text-bold-symbolic";
            tooltip-text: _("Bold (Ctrl+B)");
            focus-on-click: false;
          }

          ToggleButton italic_button {
            icon-name: "format-text-italic-symbolic";
            tooltip-text: _("Italic (Ctrl+I)");
            focus-on-click: false;
          }

          ToggleButton underline_button {
            icon-name: "format-text-underline-symbolic";
            tooltip-text: _("Underline (Ctrl+U)");
            focus-on-click: false;
          }

          Separator {
            orientation: vertical;
          }

          MenuButton block_button {
            label: _("Paragraph");
            menu-model: block_menu;
            tooltip-text: _("Paragraph Style");
            focus-on-click: false;
          }

          MenuButton align_button {
            icon-name: "format-justify-left-symbolic";
            menu-model: align_menu;
            tooltip-text: _("Alignment");
            focus-on-click: false;
          }

          Separator {
            orientation: vertical;
          }

          ToggleButton ul_button {
            icon-name: "view-list-bullet-symbolic";
            tooltip-text: _("Bulleted List");
            focus-on-click: false;
          }

          ToggleButton ol_button {
            icon-name: "view-list-ordered-symbolic";
            tooltip-text: _("Numbered List");
            focus-on-click: false;
          }

          ToggleButton quote_button {
            icon-name: "format-indent-more-symbolic";
            tooltip-text: _("Quote");
            focus-on-click: false;
          }

          Separator {
            orientation: vertical;
          }

          MenuButton link_button {
            icon-name: "insert-link-symbolic";
            tooltip-text: _("Insert Link");
            focus-on-click: false;

            popover: Popover link_popover {
              child: Box {
                spacing: 6;
                margin-top: 6;
                margin-bottom: 6;
                margin-start: 6;
                margin-end: 6;

                Entry link_entry {
                  placeholder-text: "https://";
                  width-chars: 32;
                }

                Button link_apply {
                  label: _("Insert");

                  styles [
                    "suggested-action",
                  ]
                }
              };
            };
          }

          ColorDialogButton color_button {
            tooltip-text: _("Text Colour");
            focus-on-click: false;

            dialog: ColorDialog {
              with-alpha: false;
            };
          }

          Button image_button {
            icon-name: "insert-image-symbolic";
            tooltip-text: _("Insert Image");
            action-name: "compose.insert-image";
            focus-on-click: false;
          }

          Button clear_button {
            icon-name: "edit-clear-symbolic";
            tooltip-text: _("Clear Formatting");
            focus-on-click: false;
          }
        }

        // Shown instead of the toolbar while only plain text is sent
        // (compose/draft.go richText).
        Label plain_text_hint {
          label: _("This message will be sent as plain text.");
          xalign: 0;
          visible: false;
          margin-start: 12;
          margin-end: 12;
          margin-top: 4;
          margin-bottom: 4;

          styles [
            "caption",
            "dim-label",
          ]
        }

        // Shows the view background until the editor has painted.
        Box editor_slot {
          orientation: vertical;
          vexpand: true;

          styles [
            "view",
          ]
        }

        // Attachment chips; shown only when non-empty.
        FlowBox attachments_box {
          visible: false;
          selection-mode: none;
          max-children-per-line: 6;
          homogeneous: false;
          margin-start: 12;
          margin-end: 12;
          margin-top: 6;
          margin-bottom: 6;
        }
      };
    };

    [bottom]
    Box {
      margin-start: 12;
      margin-end: 12;
      margin-top: 4;
      margin-bottom: 4;

      Label draft_status {
        xalign: 0;
        hexpand: true;
        ellipsize: end;

        styles [
          "dim-label",
          "caption",
        ]
      }
    }
  };
}

menu compose_menu {
  section {
    // Disabled in comment mode, and then hidden.
    item {
      label: _("_Save Draft");
      action: "compose.save";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Attach _Files…");
      action: "compose.attach";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Insert _Image…");
      action: "compose.insert-image";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Discard");
      action: "compose.discard";
    }
  }
}

menu block_menu {
  item {
    label: _("Paragraph");
    action: "compose.block";
    target: "p";
  }

  item {
    label: _("Heading 1");
    action: "compose.block";
    target: "h1";
  }

  item {
    label: _("Heading 2");
    action: "compose.block";
    target: "h2";
  }

  item {
    label: _("Heading 3");
    action: "compose.block";
    target: "h3";
  }
}

menu align_menu {
  item {
    label: _("Left");
    action: "compose.align";
    target: "left";
  }

  item {
    label: _("Center");
    action: "compose.align";
    target: "center";
  }

  item {
    label: _("Right");
    action: "compose.align";
    target: "right";
  }
}

// The header field labels share one width so the entries line up.
SizeGroup header_labels {
  mode: horizontal;

  widgets [
    from_label,
    to_label,
    cc_label,
    bcc_label,
    subject_label,
  ]
}

// The rewrite's popover, parented to rewrite_button from Go: the presets
// and the user's own instruction, the answer as plain text (never markup)
// while it arrives and when it is there, and what to do with it. Every
// text comes from ui/internal/assistant, set in Go.
Popover rewrite_popover {
  child: Box {
    orientation: vertical;
    spacing: 10;
    width-request: 380;
    margin-top: 8;
    margin-bottom: 8;
    margin-start: 8;
    margin-end: 8;

    Label rewrite_title {
      use-markup: false;
      xalign: 0;

      styles [
        "heading",
      ]
    }

    Adw.WrapBox rewrite_presets {
      child-spacing: 6;
      line-spacing: 6;
    }

    Entry rewrite_custom {}

    Box rewrite_status {
      spacing: 6;
      visible: false;

      Adw.Spinner {}

      Label rewrite_status_label {
        use-markup: false;
        xalign: 0;

        styles [
          "caption",
          "dim-label",
        ]
      }
    }

    ScrolledWindow rewrite_result_scroll {
      height-request: 140;
      hscrollbar-policy: never;
      visible: false;

      styles [
        "card",
      ]

      child: TextView rewrite_result {
        editable: false;
        cursor-visible: false;
        wrap-mode: word_char;
        top-margin: 6;
        bottom-margin: 6;
        left-margin: 8;
        right-margin: 8;
      };
    }

    Label rewrite_error {
      use-markup: false;
      wrap: true;
      xalign: 0;
      visible: false;

      styles [
        "error",
      ]
    }

    Box {
      spacing: 8;

      Button rewrite_discard {
        use-underline: true;
      }

      Box {
        hexpand: true;
      }

      Button rewrite_insert {}

      Button rewrite_replace {
        styles [
          "suggested-action",
        ]
      }
    }
  };
}
