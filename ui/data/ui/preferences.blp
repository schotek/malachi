using Gtk 4.0;
using Adw 1;
// Preferences dialog, opened by the app.preferences action (Ctrl+,). Object
// IDs are looked up from ui/internal/window/preferences.go; keep them in sync.
//
// The "Accounts" page is owned by the daemon (account.list / account.remove
// / account.setEnabled; rows are built in ui/internal/window/accounts_page.go).
// The other pages are bound to GSettings (ui/internal/settings), except the
// "Mail" group, which is owned by the daemon and goes through config.get /
// config.set, and "Launch at Login", whose state is decided by the
// Background portal (ui/internal/background). In the "Mail" group,
// attachment_days, never_store_attachments and compress_store stay hidden
// until config.get reports them (a daemon that does not know them never
// does), and storage_row shows what system.storage says, asked again every
// few seconds while the dialog is open (hidden for a daemon without it).
// On the "AI" page the MCP switch has no setting of its own: it shows what
// malachi-mcp reports about the Claude configuration files
// (ui/internal/mcpsetup). The Assistant group under it is bound to the
// assistant-* keys and depends on that switch; its texts come from
// ui/internal/assistant, set in Go (window/preferences.go bindAssistant).
Adw.PreferencesDialog preferences_dialog {
  title: _("Preferences");
  search-enabled: true;

  Adw.PreferencesPage accounts_page {
    name: "accounts";
    title: _("Accounts");
    icon-name: "system-users-symbolic";

    Adw.PreferencesGroup accounts_group {
      title: _("Mail Accounts");

      // A menu of the two assistants: a mail account or a Jira account
      // (window/accounts_page.go, the "prefs" action group).
      header-suffix: MenuButton add_account_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add Account");
        valign: center;
        menu-model: add_account_menu;

        styles [
          "flat",
        ]
      };

      Adw.ActionRow accounts_empty_row {
        title: _("No accounts yet");
        subtitle: _("Use the + button to add one");
        sensitive: false;
      }
    }
  }

  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Startup");

      Adw.SwitchRow launch_at_login {
        title: _("Launch at Login");
        subtitle: _("Start hidden in the background when you log in");
      }

      Adw.SwitchRow run_in_background {
        title: _("Run in Background");
        subtitle: _("Closing the window keeps Malachi Mail running for notifications");
      }
    }

    Adw.PreferencesGroup {
      title: _("Board");

      Adw.ComboRow board_default_style {
        title: _("Default View");

        model: StringList {
          strings [
            C_("board style", "List"),
            C_("board style", "Columns"),
            _("Today"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Reading");

      Adw.SpinRow mark_read_delay {
        title: _("Mark as Read After");
        subtitle: _("Seconds a message must be shown before it is marked as read; 0 marks it immediately");

        adjustment: Adjustment {
          lower: 0;
          upper: 60;
          step-increment: 1;
          value: 2;
        };
      }

    }

    Adw.PreferencesGroup {
      title: _("Deleting");

      Adw.SwitchRow confirm_delete {
        title: _("Confirm Before Deleting");
        subtitle: _("Ask before moving a message to Trash");
        active: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Notifications");

      Adw.SwitchRow desktop_notifications {
        title: _("Show Desktop Notifications");
        active: true;
      }

      Adw.SwitchRow notification_sound {
        title: _("Play Sound");
        subtitle: _("Play the system new-mail sound");
      }
    }

    Adw.PreferencesGroup mail_group {
      title: _("Mail");
      description: _("Stored by the mail daemon.");

      Adw.ComboRow check_interval {
        title: _("Check for New Mail");
        selected: 1;

        model: StringList {
          strings [
            _("Manually"),
            _("Every 5 minutes"),
            _("Every 15 minutes"),
            _("Every 30 minutes"),
          ]
        };
      }

      Adw.ComboRow remote_images {
        title: _("Load Remote Images");

        model: StringList {
          strings [
            _("Never"),
            _("From Known Senders"),
            _("Always"),
          ]
        };
      }

      Adw.ComboRow offline_days {
        title: _("Keep Mail Offline For");
        subtitle: _("Older messages stay on the server and are not shown");

        model: StringList {
          strings [
            _("1 week"),
            _("1 month"),
            _("3 months"),
            _("1 year"),
            _("Everything"),
          ]
        };
      }

      // Preferences.attachmentOfflineDays per row (attachmentChoices in
      // preferences.go): -1, 7, 30, 90, 0.
      Adw.ComboRow attachment_days {
        title: _("Keep Attachments Offline For");
        subtitle: _("Large attachments of older messages stay on the server and are downloaded when you open them");
        selected: 4;
        visible: false;

        model: StringList {
          strings [
            _("Small Attachments Only"),
            _("1 week"),
            _("1 month"),
            _("3 months"),
            _("Everything"),
          ]
        };
      }

      // While on, attachment_days does not apply and is insensitive
      // (attachmentDaysApply in preferences.go).
      Adw.SwitchRow never_store_attachments {
        title: _("Never Store Attachments");
        subtitle: _("Attachments are downloaded whenever you open them and are gone when you quit");
        visible: false;
      }

      Adw.SwitchRow compress_store {
        title: _("Compress Stored Mail");
        subtitle: _("Uses less disk space; stored mail is converted in the background");
        visible: false;
      }

      // The total as the suffix, what compression saves and what stays on
      // the server as the subtitle (storageTexts in preferences.go).
      Adw.ActionRow storage_row {
        title: _("Disk Space Used");
        use-markup: false;

        [suffix]
        Label storage_size {
          valign: center;

          styles [
            "dim-label",
            "numeric",
          ]
        }
      }
    }
  }

  Adw.PreferencesPage appearance_page {
    name: "appearance";
    title: _("Appearance");
    icon-name: "applications-graphics-symbolic";

    Adw.PreferencesGroup {
      title: _("Theme");

      Adw.ComboRow color_scheme {
        title: _("Color Scheme");

        model: StringList {
          strings [
            _("Follow System"),
            _("Light"),
            _("Dark"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Message List");

      Adw.ComboRow list_density {
        title: _("Density");

        model: StringList {
          strings [
            _("Comfortable"),
            _("Compact"),
          ]
        };
      }

      Adw.SwitchRow group_by_conversation {
        title: _("Group by Conversation");
        subtitle: _("One row per conversation; expand it to see its messages");
      }

      Adw.SwitchRow show_preview_line {
        title: _("Show Preview Line");
        active: true;
      }

      Adw.SwitchRow show_avatars {
        title: _("Show Avatars");
        active: true;
      }

      Adw.SwitchRow monochrome_avatars {
        title: _("Monochrome Avatars");
        subtitle: _("Neutral grey instead of a colour per sender");
      }
    }

    Adw.PreferencesGroup {
      title: _("Message View");

      Adw.SwitchRow monospace_plain_text {
        title: _("Use Monospace Font for Plain Text");
      }

      Adw.SpinRow text_zoom {
        title: _("Text Zoom");
        subtitle: _("Percent");

        adjustment: Adjustment {
          lower: 50;
          upper: 200;
          step-increment: 10;
          value: 100;
        };
      }
    }
  }

  Adw.PreferencesPage ai_page {
    name: "ai";
    title: _("AI");
    icon-name: "applications-science-symbolic";

    Adw.PreferencesGroup mcp_group {
      title: _("MCP");
      description: _("Lets AI assistants read your mail and prepare drafts through the Model Context Protocol.");

      Adw.SwitchRow mcp_switch {
        title: _("Register with Claude");
        subtitle: _("Adds the malachi-mcp bridge to Claude Desktop and Claude Code on this computer");
      }
    }

    Adw.PreferencesGroup assistant_group {
      Adw.SwitchRow assistant_menu_switch {
        use-markup: false;
      }

      Adw.ComboRow assistant_target {
        use-markup: false;
      }

      // In App only: the claude the panel runs, and the model.
      Adw.ActionRow assistant_claude_code {
        use-markup: false;
        subtitle-selectable: true;
        visible: false;

        [suffix]
        Button assistant_claude_choose {
          valign: center;
        }
      }

      Adw.ComboRow assistant_model {
        use-markup: false;
        visible: false;
      }
    }

    // The board's triage, shown while it is offered (boardtriage
    // View.Offered: the Assistant shown with In App, and a board the
    // daemon has and has not turned off). The texts come from
    // ui/internal/board and ui/internal/assistant, set in Go
    // (window/preferences.go bindBoardTriage), and so do the items of the
    // combo rows; the description says why triage cannot run now.
    Adw.PreferencesGroup board_triage_group {
      title: _("Board");
      visible: false;

      Adw.SwitchRow board_triage_consent {
        use-markup: false;
      }

      // board-triage-model, apart from the panel's assistant-model.
      Adw.ComboRow board_triage_model {
        use-markup: false;
      }

      Adw.SwitchRow board_triage_auto {
        use-markup: false;
      }

      // autoTriageMinutes and autoTriageDailyCases of the daemon's
      // board.preferences.
      Adw.ComboRow board_triage_interval {
        use-markup: false;
      }

      Adw.ComboRow board_triage_daily {
        use-markup: false;
      }

      Adw.ActionRow board_triage_status {
        title: _("Status");
        use-markup: false;
      }

      // The tokens of the last 24 hours: the sum as the suffix, by kind
      // and the runs as the subtitle.
      Adw.ActionRow board_triage_usage {
        use-markup: false;
        visible: false;

        [suffix]
        Label board_triage_usage_value {
          valign: center;

          styles [
            "dim-label",
            "numeric",
          ]
        }
      }
    }
  }
}

menu add_account_menu {
  section {
    item {
      label: _("_Add Account…");
      action: "prefs.add-account";
    }

    item {
      label: _("Add _Jira Account…");
      action: "prefs.add-jira-account";
    }
  }
}
