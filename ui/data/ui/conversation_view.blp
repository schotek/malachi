using Gtk 4.0;
using Adw 1;
// The conversation page of the reading pane (window/conversation_host.go):
// a folded conversation row of the grouped list shows every member the
// folder holds in one of two layouts (docs/plans/chat-view.md). On top a
// fixed strip that does not scroll, its controls in the cards' column at
// the trailing end: Collapse All / Expand All of the timeline (label from
// Go, hidden in the chat and while fewer than two cards fold) and the
// layout toggle, bound to the setting conversation-chat-layout, its label
// and tooltip from Go as the setting stands (Show as Chat, Show as
// Thread). Under it a stack with the two layouts: the timeline
// (conversation_view.go: native cards on a timeline, the issue card of a
// Jira conversation in conversation_issue, then one row per item, filled
// from Go by conversation_card.go and conversation_rows.go) and the chat
// (conversation_chat.go: plain-text bubbles, the issue card across the
// column in conversation_chat_issue, rows from conversation_chat_row.go).
// Under the chat only, the quick-reply bar (conversation_reply_bar,
// window/quick_reply_bar.go). The window adds the page to message_stack
// as "conversation". The link under the pointer in any card shows in
// conversation_status; the spinner stands in while the members load.
Overlay conversation_page {
  styles [
    "conversation-pane",
  ]

  child: Box conversation_body {
    orientation: vertical;

    // The strip (docs/plans/chat-view.md D8, D9): in a clamp of the
    // column's width with the column's side insets, so that its controls
    // line up with the cards' trailing edge; 8 above, 6 below.
    Adw.Clamp conversation_strip_clamp {
      maximum-size: 900;
      tightening-threshold: 900;

      child: Box conversation_strip {
        orientation: horizontal;
        spacing: 12;
        halign: end;
        margin-start: 16;
        margin-end: 16;
        margin-top: 8;
        margin-bottom: 6;

        // Collapse All / Expand All (conversation_host.go setFoldAll): a
        // small flat link, hidden while it offers nothing.
        Button conversation_fold_all {
          valign: center;
          visible: false;

          styles [
            "flat",
            "fold-all",
          ]
        }

        // The layout toggle: checked while the chat shows.
        ToggleButton conversation_chat_toggle {
          valign: center;

          child: Adw.ButtonContent conversation_chat_toggle_content {
            icon-name: "malachi-chat-symbolic";
            can-shrink: true;
          };
        }
      };
    }

    Stack conversation_layouts {
      vexpand: true;
      hexpand: true;
      hhomogeneous: false;
      vhomogeneous: false;
      transition-type: none;

      StackPage {
        name: "timeline";

        child: ScrolledWindow conversation_scroller {
          hscrollbar-policy: never;
          vexpand: true;
          hexpand: true;

          // The column is 900 wide at most, its gutter included, like the
          // single message's.
          child: Adw.Clamp conversation_clamp {
            maximum-size: 900;
            tightening-threshold: 900;

            child: Box conversation_column {
              orientation: vertical;
              margin-start: 16;
              margin-end: 16;
              margin-top: 4;
              margin-bottom: 16;

              // The issue card, in the cards' column (after the gutter).
              Box conversation_issue {
                orientation: vertical;
                margin-start: 40;
                margin-top: 12;
                visible: false;
              }
            };
          };
        };
      }

      StackPage {
        name: "chat";

        child: ScrolledWindow conversation_chat_scroller {
          hscrollbar-policy: never;
          vexpand: true;
          hexpand: true;

          // The same column as the timeline's, without the gutter: the
          // avatars stand beside the bubbles.
          child: Adw.Clamp conversation_chat_clamp {
            maximum-size: 900;
            tightening-threshold: 900;

            child: Box conversation_chat_column {
              orientation: vertical;
              margin-start: 16;
              margin-end: 16;
              margin-top: 4;
              margin-bottom: 16;

              // The issue card, across the column.
              Box conversation_chat_issue {
                orientation: vertical;
                margin-top: 12;
                visible: false;
              }
            };
          };
        };
      }
    }

    // The quick-reply bar of the chat (window/quick_reply_bar.go,
    // docs/plans/chat-view.md §10, §11): a fixed row under the chat, a line
    // above it, its content in a clamp of the column's width with the
    // column's side insets. From the leading end: the mode button (icon and
    // label, its menu built from Go: Reply, Reply All, Forward…; the icon
    // alone in a narrow pane), on an issue a plain Comment label instead;
    // the field of one to five lines (the assistant panel's, then it
    // scrolls) with its placeholder; the Assistant, the toolbar's ✦ (icon,
    // tooltip, menu and visibility from Go); Open in a Window; Send. Hidden
    // outside the chat and while the controller hides it; texts from Go
    // except Send's tooltip.
    Box conversation_reply_bar {
      orientation: vertical;
      visible: false;

      Separator {}

      Adw.Clamp conversation_reply_clamp {
        maximum-size: 900;
        tightening-threshold: 900;

        child: Box conversation_reply_row {
          orientation: horizontal;
          spacing: 8;
          margin-start: 16;
          margin-end: 16;
          margin-top: 8;
          margin-bottom: 8;

          MenuButton conversation_reply_mode {
            valign: end;

            child: Adw.ButtonContent conversation_reply_mode_content {
              icon-name: "mail-reply-sender-symbolic";
              can-shrink: true;
            };
          }

          // An issue's only mode, a public comment: a label, no menu
          // (the icon of the pane's Comment action, actions.go commentIcon).
          Box conversation_reply_comment {
            orientation: horizontal;
            spacing: 6;
            valign: end;
            margin-bottom: 8;
            visible: false;

            Image {
              icon-name: "chat-message-new-symbolic";

              styles [
                "dim-label",
              ]
            }

            Label conversation_reply_comment_label {
              use-markup: false;
            }
          }

          Overlay {
            hexpand: true;

            child: ScrolledWindow conversation_reply_scroller {
              hscrollbar-policy: never;
              propagate-natural-height: true;
              max-content-height: 112;

              styles [
                "assistant-input",
              ]

              child: TextView conversation_reply_text {
                wrap-mode: word_char;
                accepts-tab: false;
                top-margin: 6;
                bottom-margin: 6;
                left-margin: 8;
                right-margin: 8;
              };
            };

            [overlay]
            Label conversation_reply_placeholder {
              use-markup: false;
              halign: start;
              valign: start;
              margin-top: 6;
              margin-start: 9;
              ellipsize: end;
              can-target: false;

              styles [
                "dim-label",
              ]
            }
          }

          MenuButton conversation_reply_assistant {
            valign: end;
            visible: false;
          }

          Button conversation_reply_open {
            icon-name: "window-new-symbolic";
            valign: end;
          }

          Button conversation_reply_send {
            icon-name: "mail-send-symbolic";
            tooltip-text: _("Send (Ctrl+Enter)");
            valign: end;
            sensitive: false;

            styles [
              "suggested-action",
            ]
          }
        };
      }
    }
  };

  [overlay]
  Label conversation_status {
    halign: start;
    valign: end;
    margin-start: 6;
    margin-bottom: 6;
    ellipsize: middle;
    max-width-chars: 80;
    visible: false;

    styles [
      "osd",
      "caption",
    ]
  }

  [overlay]
  Adw.Spinner conversation_spinner {
    halign: center;
    valign: center;
    width-request: 32;
    height-request: 32;
    visible: false;

    accessibility {
      label: C_("accessibility", "Loading the message");
    }
  }
}
