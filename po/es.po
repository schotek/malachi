msgstr "Firmado, según el firmante"

#. TRANSLATORS: label of the time the message arrived
#: ui/internal/signature/text.go:238
msgctxt "signature"
msgid "Arrived"
msgstr "Llegó"

#: ui/internal/signature/text.go:240
msgctxt "signature"
msgid "Algorithm"
msgstr "Algoritmo"

#: ui/internal/signature/text.go:244
msgctxt "signature"
msgid "Key fingerprint"
msgstr "Huella de la clave"

#: ui/internal/signature/text.go:246
msgctxt "signature"
msgid "Key ID"
msgstr "ID de la clave"

#. TRANSLATORS: label of the row that says whether the OpenPGP key is confirmed
#: ui/internal/signature/text.go:249
msgctxt "signature"
msgid "Key"
msgstr "Clave"

#: ui/internal/signature/text.go:251
msgctxt "signature"
msgid "Key source"
msgstr "Origen de la clave"

#. TRANSLATORS: label of the date the OpenPGP key was first seen
#: ui/internal/signature/text.go:254
msgctxt "signature"
msgid "First seen"
msgstr "Visto por primera vez"

#: ui/internal/signature/text.go:256
msgctxt "signature"
msgid "User IDs"
msgstr "ID de usuario"

#. TRANSLATORS: label of the fingerprint of the key the sender used before
#: ui/internal/signature/text.go:259
msgctxt "signature"
msgid "Previous key"
msgstr "Clave anterior"

#: ui/internal/signature/text.go:261
msgctxt "signature"
msgid "Expired"
msgstr "Caducado"

#: ui/internal/signature/text.go:263
msgctxt "signature"
msgid "Revoked"
msgstr "Revocado"

#. TRANSLATORS: label of the row with the result of the revocation check
#: ui/internal/signature/text.go:266
msgctxt "signature"
msgid "Revocation"
msgstr "Revocación"

#. TRANSLATORS: label of the e-mail addresses a certificate names
#: ui/internal/signature/text.go:275
msgctxt "signature"
msgid "E-mail addresses"
msgstr "Direcciones de correo"

#: ui/internal/signature/text.go:289
msgid "Confirmed by you"
msgstr "Confirmada por ti"

#: ui/internal/signature/text.go:291
msgid "Found automatically, not confirmed"
msgstr "Encontrada automáticamente, sin confirmar"

#: ui/internal/signature/text.go:293
msgid "Not in Malachi Mail"
msgstr "No está en Malachi Mail"

#. TRANSLATORS: Autocrypt is a name; the key came in a message's header
#: ui/internal/signature/text.go:301
msgid "Autocrypt header of a message"
msgstr "Encabezado Autocrypt de un mensaje"

#: ui/internal/signature/text.go:303
