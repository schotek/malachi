msgstr "Usar"

#: ui/internal/accountwizard/linked.go:93
msgid "Added"
msgstr "Añadida"

#: ui/internal/accountwizard/linked.go:114
msgid "The mail service does not describe this account; update it and try again"
msgstr "El servicio de correo no describe esta cuenta; actualízala e inténtalo de nuevo"

#. TRANSLATORS: %s is a provider such as "Microsoft 365" or "Google".
#: ui/internal/accountwizard/linked.go:153
#, c-format
msgid "This address belongs to a %s account. Add it under Settings → Online Accounts, then come back here."
msgstr "Esta dirección pertenece a una cuenta de %s. Añádela en Configuración → Cuentas en línea y vuelve aquí."

#: ui/internal/accountwizard/linked.go:178 ui/internal/window/sync.go:514
msgid "Could not open Online Accounts; open GNOME Settings yourself"
msgstr "No se pudo abrir Cuentas en línea; abre tú mismo la Configuración de GNOME"

#: ui/internal/accountwizard/linked.go:194
msgid "This address is not signed in yet"
msgstr "Esta dirección aún no ha iniciado sesión"

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:75
#, c-format
msgid "Your browser will open so you can sign in to %s. Malachi Mail never sees your password; it only receives permission to read and send your mail."
msgstr "Se abrirá tu navegador para que inicies sesión en %s. Malachi Mail nunca ve tu contraseña; solo recibe permiso para leer y enviar tu correo."

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:77
#, c-format
msgid "_Sign In with %s"
msgstr "_Iniciar sesión con %s"

#. TRANSLATORS: progressive form for the RPC error text
#: ui/internal/accountwizard/oauth.go:145 ui/internal/window/sync.go:542
#: ui/internal/window/contacts_consent.go:32
msgid "Starting the sign-in"
msgstr "Iniciando el inicio de sesión"

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:298
#, c-format
msgid "No OAuth client is configured for %s on this computer. Add a client ID to the mail backend's configuration and try again."
msgstr "No hay ningún cliente OAuth configurado para %s en este equipo. Añade un ID de cliente a la configuración del motor de correo e inténtalo de nuevo."

#: ui/internal/accountwizard/oauth.go:328
#: ui/internal/accountwizard/wizard.go:508
msgid "Enter the app password for this account"
msgstr "Introduce la contraseña de aplicación de esta cuenta"

#. TRANSLATORS: title of the page the browser shows
#: ui/internal/accountwizard/oauth.go:351
#: ui/internal/assistant/assistant.go:604
msgid "Signed in"
msgstr "Sesión iniciada"

#. TRANSLATORS: page the browser shows
#: ui/internal/accountwizard/oauth.go:353
msgid "You can close this tab and return to Malachi Mail."
msgstr "Puedes cerrar esta pestaña y volver a Malachi Mail."

#. TRANSLATORS: title of the page the browser shows
#: ui/internal/accountwizard/oauth.go:355
msgid "Sign-in failed"
msgstr "Error al iniciar sesión"

#. TRANSLATORS: page the browser shows
#: ui/internal/accountwizard/oauth.go:357
msgid "Return to Malachi Mail and try again."
msgstr "Vuelve a Malachi Mail e inténtalo de nuevo."

#: ui/internal/accountwizard/oauth.go:367
msgid "The sign-in was cancelled"
msgstr "Se canceló el inicio de sesión"

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:370
#, c-format
msgid "The sign-in with %s was refused"
msgstr "Se rechazó el inicio de sesión con %s"

#: ui/internal/accountwizard/oauth.go:372
#: ui/internal/assistant/assistant.go:932
msgid "The sign-in took too long; try again"
msgstr "El inicio de sesión tardó demasiado; inténtalo de nuevo"

#. TRANSLATORS: %s is an e-mail address.
#: ui/internal/accountwizard/oauth.go:375
#, c-format
msgid "The browser signed in to %s, not to this address"
msgstr "El navegador inició sesión en %s, no en esta dirección"

#. TRANSLATORS: progressive form for the RPC error text
#: ui/internal/accountwizard/oauth.go:378 ui/internal/crm/text.go:438
#: ui/internal/crm/text.go:535
msgid "Signing in"
msgstr "Iniciando sesión"

#: ui/internal/accountwizard/results.go:63
msgid "Not tested"
msgstr "Sin probar"

#. TRANSLATORS: %d is the connection latency in milliseconds.
#: ui/internal/accountwizard/results.go:67
#, c-format
msgid "Connected in %d ms"
msgstr "Conectado en %d ms"

#. TRANSLATORS: banner on the identity page of the account assistant
#: ui/internal/accountwizard/results.go:89
msgid "No password is stored for this account. Enter it to continue."
msgstr "No hay ninguna contraseña guardada para esta cuenta. Introdúcela para continuar."

#: ui/internal/accountwizard/results.go:92
msgid "Google rejected the sign-in. It does not accept the account's password here: create an app password in your Google Account and enter that one. For a work or school account, the administrator has to allow app passwords and IMAP."
msgstr "Google rechazó el inicio de sesión. Aquí no acepta la contraseña de la cuenta: crea una contraseña de aplicación en tu cuenta de Google e introdúcela. En una cuenta del trabajo o de un centro educativo, el administrador debe permitir las contraseñas de aplicación e IMAP."

#: ui/internal/accountwizard/results.go:94 ui/internal/crm/text.go:556
#: ui/internal/widget/rpc.go:103
msgid "The server rejected the user name or password"
msgstr "El servidor rechazó el nombre de usuario o la contraseña"

#. TRANSLATORS: joins two servers ("host:port") in the sentence
#. "… accept exactly this certificate for %s and no other …".
#. TRANSLATORS: joins the last item of a list, e.g. "Monday and
#. Wednesday".
#: ui/internal/accountwizard/trust.go:83 ui/internal/calendar/recurrence.go:74
#, c-format
msgid "%s and %s"
msgstr "%s y %s"

#. TRANSLATORS: dialog heading, the pinned certificate of a server
#. has changed
#: ui/internal/accountwizard/trust.go:101 ui/internal/aiaccount/dialog.go:372
msgid "Trust the New Certificate?"
msgstr "¿Confiar en el nuevo certificado?"

#. TRANSLATORS: %s is one server ("host:port") or two joined by
#. "%s and %s".
#: ui/internal/accountwizard/trust.go:104 ui/internal/aiaccount/dialog.go:375
#, c-format
msgid "The certificate of %s has changed since you trusted it. If you did not renew it yourself, someone may be intercepting the connection. Trust the new certificate only if you know why it changed."
msgstr "El certificado de %s ha cambiado desde que confiaste en él. Si no lo renovaste tú, alguien podría estar interceptando la conexión. Confía en el nuevo certificado solo si sabes por qué ha cambiado."

#. TRANSLATORS: dialog heading
#: ui/internal/accountwizard/trust.go:107 ui/internal/aiaccount/dialog.go:378
msgid "Trust This Certificate?"
msgstr "¿Confiar en este certificado?"

#. TRANSLATORS: %s is one server ("host:port") or two joined by
#. "%s and %s".
#: ui/internal/accountwizard/trust.go:110 ui/internal/aiaccount/dialog.go:381
#, c-format
msgid "Only trust a certificate you expect, for example the one of a mail bridge on your own computer. Malachi Mail will then accept exactly this certificate for %s and no other, even if it is self-signed, issued for another name or expired."
msgstr "Confía solo en un certificado que esperas, por ejemplo el de un puente de correo en tu propio equipo. Malachi Mail aceptará entonces exactamente este certificado para %s y ningún otro, aunque sea autofirmado, esté emitido para otro nombre o haya caducado."

#. TRANSLATORS: destructive confirm button of "Trust This Certificate?"
#: ui/internal/accountwizard/trust.go:113 ui/internal/aiaccount/dialog.go:384
msgid "_Trust"
msgstr "_Confiar"

#: ui/internal/accountwizard/trust.go:167 ui/internal/signature/text.go:242
msgctxt "certificate"
msgid "SHA-256 fingerprint"
msgstr "Huella SHA-256"

#. TRANSLATORS: label of the fingerprint of the certificate that was
#. pinned before
#: ui/internal/accountwizard/trust.go:170
msgctxt "certificate"
msgid "Previously trusted"
msgstr "Confiado anteriormente"

#: ui/internal/accountwizard/trust.go:171 ui/internal/signature/text.go:268
msgctxt "certificate"
msgid "Issued to"
msgstr "Emitido para"

#: ui/internal/accountwizard/trust.go:172 ui/internal/signature/text.go:270
msgctxt "certificate"
msgid "Issued by"
msgstr "Emitido por"

#. TRANSLATORS: validity period of a certificate: two dates
#: ui/internal/accountwizard/trust.go:176 ui/internal/signature/text.go:282
#, c-format
msgctxt "certificate"
msgid "%s to %s"
msgstr "%s a %s"

#. TRANSLATORS: label of a certificate's validity period
#: ui/internal/accountwizard/trust.go:178 ui/internal/signature/text.go:272
msgctxt "certificate"
msgid "Valid"
msgstr "Válido"

#: ui/internal/accountwizard/trust.go:181
msgctxt "certificate"
msgid "Self-signed"
msgstr "Autofirmado"

#: ui/internal/accountwizard/wizard.go:262 ui/internal/crm/text.go:431
msgid "New Password (leave empty to keep)"
msgstr "Contraseña nueva (déjala vacía para conservarla)"

#: ui/internal/accountwizard/wizard.go:264
msgid "Save _Anyway"
msgstr "Guardar _de todos modos"

#: ui/internal/accountwizard/wizard.go:276 ui/data/ui/account_wizard.ui:275
msgid "_Test Connection"
msgstr "_Probar conexión"

#: ui/internal/accountwizard/wizard.go:550 ui/internal/crm/text.go:432
#: ui/internal/crm/text.go:559
msgid "Enter the password for this account"
msgstr "Introduce la contraseña de esta cuenta"

#: ui/internal/accountwizard/wizard.go:604 ui/data/ui/account_wizard.ui:481
msgid "Testing Connection…"
msgstr "Probando la conexión…"

#. TRANSLATORS: progressive form for the RPC error text
#: ui/internal/accountwizard/wizard.go:642 ui/internal/aiaccount/text.go:88
msgid "Testing the connection"
msgstr "Probando la conexión"

#: ui/internal/accountwizard/wizard.go:680
msgid "The server refused the sign-in. Sign in again and make sure access to mail is allowed."
msgstr "El servidor rechazó el inicio de sesión. Vuelve a iniciar sesión y asegúrate de que el acceso al correo está permitido."

#: ui/internal/accountwizard/wizard.go:685
msgid "The server refused the sign-in. Sign in to the account again in Settings → Online Accounts and make sure access to mail is allowed."
msgstr "El servidor rechazó el inicio de sesión. Vuelve a iniciar sesión en la cuenta en Configuración → Cuentas en línea y asegúrate de que el acceso al correo está permitido."

#: ui/internal/accountwizard/wizard.go:688
msgid "_Sign In Again"
msgstr "_Volver a iniciar sesión"

#: ui/internal/accountwizard/wizard.go:690 ui/data/ui/account_wizard.ui:576
msgid "_Edit Servers"
msgstr "_Editar servidores"

#: ui/internal/accountwizard/wizard.go:698
msgid "Ready to Save"
msgstr "Listo para guardar"

#: ui/internal/accountwizard/wizard.go:700
msgid "Ready to Add"
msgstr "Listo para añadir"

#: ui/internal/accountwizard/wizard.go:704
#: ui/internal/accountwizard/wizard.go:713
msgid "Connection Failed"
msgstr "Error de conexión"

#: ui/internal/accountwizard/wizard.go:736
msgid "Saving Account…"
msgstr "Guardando la cuenta…"

#: ui/internal/accountwizard/wizard.go:738
msgid "Adding Account…"
msgstr "Añadiendo la cuenta…"

#: ui/internal/accountwizard/wizard.go:782
msgid "An account with this e-mail address already exists"
msgstr "Ya existe una cuenta con esta dirección de correo"

#: ui/internal/accountwizard/wizard.go:785 ui/internal/aiaccount/text.go:94
#: ui/internal/jira/wizard.go:96 ui/internal/jira/wizard.go:429
#: ui/internal/jira/settings.go:125 ui/internal/crm/text.go:440
#: ui/internal/crm/text.go:539 ui/internal/calendarctl/account.go:407
msgid "Saving the account"
msgstr "Guardando la cuenta"

#: ui/internal/accountwizard/wizard.go:787 ui/internal/aiaccount/text.go:93
#: ui/internal/jira/wizard.go:95 ui/internal/jira/wizard.go:427
#: ui/internal/crm/text.go:439 ui/internal/crm/text.go:537
msgid "Adding the account"
msgstr "Añadiendo la cuenta"

#. TRANSLATORS: button of the AI provider dialog after a test refused an https server's certificate the user may trust.
#: ui/internal/aiaccount/dialog.go:200 ui/internal/calendar/caldav.go:483
msgid "Trust Certificate…"
msgstr "Confiar en el certificado…"

#. TRANSLATORS: title of the dialog that adds an AI provider account (Anthropic API, OpenAI API, an OpenAI-compatible server).
#: ui/internal/aiaccount/text.go:57
msgid "Add AI Provider"
msgstr "Añadir proveedor de IA"

#. TRANSLATORS: the read-only row of the AI provider dialog naming the kind of provider.
#: ui/internal/aiaccount/text.go:60
msgid "Provider"
msgstr "Proveedor"

#: ui/internal/aiaccount/text.go:61 ui/internal/jira/settings.go:85
#: ui/internal/crm/text.go:428 ui/internal/calendar/caldav.go:379
#: ui/data/ui/account_wizard.ui:145
msgid "Account Name"
msgstr "Nombre de la cuenta"

#. TRANSLATORS: the base URL of an OpenAI-compatible server ("…/v1").
#: ui/internal/aiaccount/text.go:63 ui/internal/calendar/caldav.go:373
msgid "Server Address"
msgstr "Dirección del servidor"

#: ui/internal/aiaccount/text.go:65
msgid "API Key"
msgstr "Clave de API"

#. TRANSLATORS: the key row of an OpenAI-compatible server, which may need none.
#: ui/internal/aiaccount/text.go:67
msgid "API Key (optional)"
msgstr "Clave de API (opcional)"

#: ui/internal/aiaccount/text.go:68
msgid "New API Key"
msgstr "Clave de API nueva"

#. TRANSLATORS: the key row of an existing AI provider account: the key is in the keyring and never shown.
#: ui/internal/aiaccount/text.go:70
msgid "Key stored"
msgstr "Clave guardada"

#. TRANSLATORS: button of the key row of an existing AI provider account.
#: ui/internal/aiaccount/text.go:72
msgid "Replace Key…"
msgstr "Reemplazar clave…"

#. TRANSLATORS: button that takes a key replacement back and keeps the stored key.
#: ui/internal/aiaccount/text.go:74
msgid "Keep the Stored Key"
msgstr "Conservar la clave guardada"

#. TRANSLATORS: under the model row of the AI provider dialog; the list comes from Test.
#: ui/internal/aiaccount/text.go:77
msgid "Choose one of the provider's models or type its id"
msgstr "Elige uno de los modelos del proveedor o escribe su ID"

#. TRANSLATORS: the model of the board's triage, an optional second model of the AI provider account.
#: ui/internal/aiaccount/text.go:79
msgid "Board Model"
msgstr "Modelo del tablero"

#. TRANSLATORS: row of the AI provider dialog showing the pinned certificate of an https server.
#: ui/internal/aiaccount/text.go:82
msgid "Trusted Certificate"
msgstr "Certificado de confianza"

#. TRANSLATORS: button that drops the pinned certificate.
#: ui/internal/aiaccount/text.go:84
msgid "Forget"
msgstr "Olvidar"

#. TRANSLATORS: button of the AI provider dialog: asks the provider for its models with the key.
#: ui/internal/aiaccount/text.go:86
msgid "_Test"
msgstr "_Probar"

#. TRANSLATORS: status of the AI provider dialog after a test that listed no models.
#: ui/internal/aiaccount/text.go:90
msgid "Connected"
msgstr "Conectado"

#: ui/internal/aiaccount/text.go:95
msgid "Enter a name for the account"
msgstr "Introduce un nombre para la cuenta"

#. TRANSLATORS: the address example stays as it is.
#: ui/internal/aiaccount/text.go:97
msgid "Enter the server's address, such as http://localhost:11434/v1"
msgstr "Introduce la dirección del servidor, por ejemplo http://localhost:11434/v1"

#: ui/internal/aiaccount/text.go:98 ui/internal/jira/wizard.go:161
#: ui/internal/jira/wizard.go:414 ui/internal/crm/text.go:457
#: ui/internal/crm/text.go:564
msgid "This is not a web address"
msgstr "Esto no es una dirección web"

#: ui/internal/aiaccount/text.go:99
msgid "A certificate can be pinned only for an https address"
msgstr "Solo se puede fijar un certificado para una dirección https"

#: ui/internal/aiaccount/text.go:100
msgid "Enter the API key"
msgstr "Introduce la clave de API"

#: ui/internal/aiaccount/text.go:101
msgid "Enter or choose a model"
msgstr "Introduce o elige un modelo"

#: ui/internal/aiaccount/text.go:102
msgid "This is not a model id"
msgstr "Esto no es un ID de modelo"

#. TRANSLATORS: Save of the AI provider dialog with the consent check box off.
#: ui/internal/aiaccount/text.go:104
msgid "Allow sending mail to the provider first"
msgstr "Permite primero el envío de correo al proveedor"

#: ui/internal/aiaccount/text.go:106
msgid "The provider could not be reached"
msgstr "No se pudo contactar con el proveedor"

#: ui/internal/aiaccount/text.go:107
msgid "The provider did not answer in time"
msgstr "El proveedor no respondió a tiempo"

#: ui/internal/aiaccount/text.go:108
msgid "The connection to the provider is not secure"
msgstr "La conexión con el proveedor no es segura"

#: ui/internal/aiaccount/text.go:109
msgid "The provider answered with an error"
msgstr "El proveedor respondió con un error"

#. TRANSLATORS: status of the AI provider dialog after a test; %d is the number of models the provider listed.
#: ui/internal/aiaccount/text.go:120
#, c-format
msgid "Connected · %d model"
msgid_plural "Connected · %d models"
msgstr[0] "Conectado · %d modelo"
msgstr[1] "Conectado · %d modelos"

#. TRANSLATORS: %s is the host of an OpenAI-compatible server reached over plain http.
#: ui/internal/aiaccount/text.go:127
#, c-format
msgid "The API key and your mail travel unencrypted over http to %s."
msgstr "La clave de API y tu correo viajan sin cifrar por http a %s."

#. TRANSLATORS: under the address field of an OpenAI-compatible server; the examples follow, one per line.
#: ui/internal/aiaccount/text.go:154
msgid "The server's base URL, usually ending in /v1. For example:"
msgstr "La URL base del servidor, que suele terminar en /v1. Por ejemplo:"

#: ui/internal/aiaccount/text.go:181
msgid "The assistant sends the prompt, the text you write, the mail it reads for you and that mail's attachments to the provider. It can read mail and prepare drafts; it cannot send, delete or move messages."
msgstr "El asistente envía al proveedor la instrucción, el texto que escribes, el correo que lee por ti y los adjuntos de ese correo. Puede leer correo y preparar borradores; no puede enviar, eliminar ni mover mensajes."

#. TRANSLATORS: check box of the AI provider dialog; Save needs it on.
#: ui/internal/aiaccount/text.go:183
msgid "Allow Malachi Mail to send mail to this provider"
msgstr "Permitir que Malachi Mail envíe correo a este proveedor"

#: ui/internal/aiaccount/text.go:187
msgid "Send Mail to Anthropic?"
msgstr "¿Enviar correo a Anthropic?"

#: ui/internal/aiaccount/text.go:188
msgid "They go to Anthropic under its API terms, which do not use data sent through the API for training by default."
msgstr "Se envían a Anthropic según sus condiciones de la API, que por defecto no usan para entrenamiento los datos enviados a través de la API."

#: ui/internal/aiaccount/text.go:190 ui/internal/assistant/chatgpt.go:58
msgid "Send Mail to OpenAI?"
msgstr "¿Enviar correo a OpenAI?"

#: ui/internal/aiaccount/text.go:191
msgid "They go to OpenAI under its API terms, which do not use data sent through the API for training by default."
msgstr "Se envían a OpenAI según sus condiciones de la API, que por defecto no usan para entrenamiento los datos enviados a través de la API."

#. TRANSLATORS: consent heading of an OpenAI-compatible server the user set the address of.
#: ui/internal/aiaccount/text.go:194
msgid "Send Mail to Your Server?"
msgstr "¿Enviar correo a tu servidor?"

#: ui/internal/aiaccount/text.go:195
msgid "They go to the server at the address you set. Over http they travel unencrypted."
msgstr "Se envían al servidor en la dirección que has indicado. Por http viajan sin cifrar."

#. TRANSLATORS: the kind of an AI provider account: the Anthropic Messages API with the user's own key.
#: ui/internal/assistant/api.go:188
msgid "Anthropic API"
msgstr "API de Anthropic"

#. TRANSLATORS: the kind of an AI provider account: the OpenAI API with the user's own key.
#: ui/internal/assistant/api.go:190
msgid "OpenAI API"
msgstr "API de OpenAI"

#. TRANSLATORS: the kind of an AI provider account: any server with the OpenAI chat completions interface (Ollama, llama.cpp, LM Studio, vLLM, a gateway).
#: ui/internal/assistant/api.go:192
msgid "OpenAI-compatible server"
msgstr "Servidor compatible con OpenAI"

#. TRANSLATORS: row of Settings → AI: which provider the assistant in the app runs on (Claude Code, ChatGPT, or an AI provider account).
#: ui/internal/assistant/api.go:196
msgid "Assistant Uses"
msgstr "El asistente usa"

#: ui/internal/assistant/api.go:197
msgid "Claude Code or ChatGPT on this computer, or an AI provider added in Integrations"
msgstr "Claude Code o ChatGPT en este equipo, o un proveedor de IA añadido en Integraciones"

#. TRANSLATORS: why an AI provider account cannot be chosen: its switch in Integrations is off.
#: ui/internal/assistant/api.go:199
msgid "Switched off in Integrations"
msgstr "Desactivado en Integraciones"

#. TRANSLATORS: why an AI provider account cannot be chosen: the user did not allow sending mail to it yet.
#: ui/internal/assistant/api.go:201
msgid "Sending mail to it is not allowed yet"
msgstr "Aún no se permite enviarle correo"

#. TRANSLATORS: why an AI provider account cannot be chosen: the provider refused its API key.
#: ui/internal/assistant/api.go:203
msgid "The provider refused the API key"
msgstr "El proveedor rechazó la clave de API"

#. TRANSLATORS: the Assistant Uses row shows this when the chosen AI provider account no longer exists.
#: ui/internal/assistant/api.go:205 ui/internal/rules/text.go:127
msgid "Removed account"
msgstr "Cuenta eliminada"

#: ui/internal/assistant/api.go:206 ui/internal/assistant/assistant.go:602
msgid "Model"
msgstr "Modelo"

#. TRANSLATORS: under the Model row of Settings → AI when the assistant runs on an AI provider account.
#: ui/internal/assistant/api.go:208
msgid "The model the account uses; saved to the account"
