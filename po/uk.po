#: ui/internal/rules/text.go:390
msgctxt "rule action"
msgid "Forward to"
msgstr "Переслати на"

#: ui/internal/rules/text.go:392
msgctxt "rule action"
msgid "Reply automatically"
msgstr "Відповісти автоматично"

#: ui/internal/rules/text.go:400
msgid "Choose a Folder"
msgstr "Виберіть папку"

#: ui/internal/rules/text.go:405
msgid "name@example.com"
msgstr "name@example.com"

#: ui/internal/rules/text.go:411
msgid "Subject (Re: and the original subject if empty)"
msgstr "Тема (якщо порожньо — Re: і початкова тема)"

#: ui/internal/rules/text.go:416
msgid "Reply text"
msgstr "Текст відповіді"

#: ui/internal/rules/text.go:422
msgid "Each sender gets at most one automatic reply in four days. Bulk mail, automatic messages and your own messages are never answered."
msgstr "Кожен відправник отримує не більше однієї автоматичної відповіді за чотири дні. На масові розсилки, автоматичні повідомлення та ваші власні повідомлення ніколи не відповідають."

#: ui/internal/rules/text.go:424
msgid "The message is sent whole as an attachment. Bulk mail, automatic messages and your own messages are never forwarded."
msgstr "Повідомлення надсилається повністю як вкладення. Масові розсилки, автоматичні повідомлення та ваші власні повідомлення ніколи не пересилаються."

#: ui/internal/rules/text.go:432 ui/internal/rules/text.go:470
msgid "Enter a name for the rule."
msgstr "Введіть назву правила."

#: ui/internal/rules/text.go:434
msgid "This is too long."
msgstr "Це задовго."

#: ui/internal/rules/text.go:436
msgid "This contains characters that cannot be used."
msgstr "Містить символи, які не можна використовувати."

#: ui/internal/rules/text.go:438
msgid "Add at least one condition."
msgstr "Додайте принаймні одну умову."

#: ui/internal/rules/text.go:440
#, c-format
msgid "A rule can have at most %d condition."
msgid_plural "A rule can have at most %d conditions."
msgstr[0] "Правило може мати не більше %d умови."
msgstr[1] "Правило може мати не більше %d умов."
msgstr[2] "Правило може мати не більше %d умов."

#: ui/internal/rules/text.go:442
msgid "Enter a value."
msgstr "Введіть значення."

#: ui/internal/rules/text.go:444
msgid "Choose how to compare."
msgstr "Виберіть спосіб порівняння."

#: ui/internal/rules/text.go:446
msgid "Add at least one action."
msgstr "Додайте принаймні одну дію."

#: ui/internal/rules/text.go:448
#, c-format
msgid "A rule can have at most %d action."
msgid_plural "A rule can have at most %d actions."
msgstr[0] "Правило може мати не більше %d дії."
msgstr[1] "Правило може мати не більше %d дій."
msgstr[2] "Правило може мати не більше %d дій."

#: ui/internal/rules/text.go:450
msgid "This action is already in the rule."
msgstr "Ця дія вже є в правилі."

#: ui/internal/rules/text.go:452
msgid "A rule can move a message to only one place."
msgstr "Правило може перемістити повідомлення лише в одне місце."

#: ui/internal/rules/text.go:454
msgid "Choose an account to move messages to one of its folders."
msgstr "Виберіть обліковий запис, щоб переміщувати повідомлення в одну з його папок."

#: ui/internal/rules/text.go:456
msgid "Choose a folder."
msgstr "Виберіть папку."

#: ui/internal/rules/text.go:458
msgid "Enter one valid email address."
msgstr "Введіть одну дійсну адресу електронної пошти."

#: ui/internal/rules/text.go:460
msgid "Enter the text of the reply."
msgstr "Введіть текст відповіді."

#: ui/internal/rules/text.go:472
msgid "The account of this rule no longer exists."
msgstr "Облікового запису цього правила вже не існує."

#: ui/internal/rules/text.go:474
msgid "Rules that send mail need your confirmation."
msgstr "Правила, що надсилають пошту, потребують вашого підтвердження."

#: ui/internal/rules/text.go:476
msgid "A condition of this rule cannot be used."
msgstr "Умову цього правила неможливо використати."

#: ui/internal/rules/text.go:478
msgid "An action of this rule cannot be used."
msgstr "Дію цього правила неможливо використати."

#: ui/internal/rules/text.go:480
msgid "This rule cannot be saved."
msgstr "Це правило неможливо зберегти."

#: ui/internal/rules/text.go:485
msgid "This rule no longer exists."
msgstr "Цього правила вже не існує."

#: ui/internal/rules/text.go:491
msgid "The rule could not be saved."
msgstr "Не вдалося зберегти правило."

#. TRANSLATORS: a button of the rule editor: shows which stored
#. messages of a folder the rule would match.
#: ui/internal/rules/text.go:498
msgid "Try It"
msgstr "Перевірити"

#: ui/internal/rules/text.go:504
msgid "Try in"
msgstr "Перевірити в"

#: ui/internal/rules/text.go:510
msgid "No message in this folder matches."
msgstr "Жодне повідомлення в цій папці не відповідає."

#: ui/internal/rules/text.go:512
#, c-format
msgid "%d message in this folder matches."
msgid_plural "%d messages in this folder match."
msgstr[0] "У цій папці відповідає %d повідомлення."
msgstr[1] "У цій папці відповідають %d повідомлення."
msgstr[2] "У цій папці відповідає %d повідомлень."

