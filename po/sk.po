msgstr "Poštová služba tento účet neopisuje; aktualizujte ju a skúste to znova"

#. TRANSLATORS: %s is a provider such as "Microsoft 365" or "Google".
#: ui/internal/accountwizard/linked.go:153
#, c-format
msgid "This address belongs to a %s account. Add it under Settings → Online Accounts, then come back here."
msgstr "Táto adresa patrí k účtu %s. Pridajte ho v Nastaveniach → Online účty a potom sa sem vráťte."

#: ui/internal/accountwizard/linked.go:178 ui/internal/window/sync.go:514
msgid "Could not open Online Accounts; open GNOME Settings yourself"
msgstr "Online účty sa nepodarilo otvoriť; otvorte Nastavenia GNOME ručne"

#: ui/internal/accountwizard/linked.go:194
msgid "This address is not signed in yet"
msgstr "Táto adresa ešte nie je prihlásená"

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:75
#, c-format
msgid "Your browser will open so you can sign in to %s. Malachi Mail never sees your password; it only receives permission to read and send your mail."
msgstr "Otvorí sa prehliadač, v ktorom sa prihlásite k účtu %s. Malachi Mail vaše heslo nikdy neuvidí; dostane len povolenie čítať a odosielať poštu."

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:77
#, c-format
msgid "_Sign In with %s"
msgstr "_Prihlásiť sa cez %s"

#. TRANSLATORS: progressive form for the RPC error text
#: ui/internal/accountwizard/oauth.go:145 ui/internal/window/sync.go:542
#: ui/internal/window/contacts_consent.go:32
msgid "Starting the sign-in"
msgstr "Spustenie prihlásenia"

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:298
#, c-format
msgid "No OAuth client is configured for %s on this computer. Add a client ID to the mail backend's configuration and try again."
msgstr "Pre %s nie je na tomto počítači nastavený žiadny klient OAuth. Pridajte ID klienta do nastavení poštového backendu a skúste to znova."

#: ui/internal/accountwizard/oauth.go:328
#: ui/internal/accountwizard/wizard.go:508
msgid "Enter the app password for this account"
msgstr "Zadajte heslo aplikácie pre tento účet"

#. TRANSLATORS: title of the page the browser shows
#: ui/internal/accountwizard/oauth.go:351
#: ui/internal/assistant/assistant.go:604
msgid "Signed in"
msgstr "Prihlásené"

#. TRANSLATORS: page the browser shows
#: ui/internal/accountwizard/oauth.go:353
msgid "You can close this tab and return to Malachi Mail."
msgstr "Túto kartu môžete zavrieť a vrátiť sa do Malachi Mail."

#. TRANSLATORS: title of the page the browser shows
#: ui/internal/accountwizard/oauth.go:355
msgid "Sign-in failed"
msgstr "Prihlásenie zlyhalo"

#. TRANSLATORS: page the browser shows
#: ui/internal/accountwizard/oauth.go:357
msgid "Return to Malachi Mail and try again."
msgstr "Vráťte sa do Malachi Mail a skúste to znova."

#: ui/internal/accountwizard/oauth.go:367
msgid "The sign-in was cancelled"
msgstr "Prihlásenie bolo zrušené"

#. TRANSLATORS: %s is a provider such as "Google" or "Microsoft 365".
#: ui/internal/accountwizard/oauth.go:370
#, c-format
msgid "The sign-in with %s was refused"
msgstr "Prihlásenie cez %s bolo odmietnuté"

#: ui/internal/accountwizard/oauth.go:372
#: ui/internal/assistant/assistant.go:932
msgid "The sign-in took too long; try again"
msgstr "Prihlásenie trvalo príliš dlho, skúste to znova"

#. TRANSLATORS: %s is an e-mail address.
#: ui/internal/accountwizard/oauth.go:375
#, c-format
msgid "The browser signed in to %s, not to this address"
msgstr "Prehliadač sa prihlásil k účtu %s, nie k tejto adrese"

#. TRANSLATORS: progressive form for the RPC error text
#: ui/internal/accountwizard/oauth.go:378 ui/internal/crm/text.go:438
#: ui/internal/crm/text.go:535
msgid "Signing in"
msgstr "Prihlasovanie"

#: ui/internal/accountwizard/results.go:63
msgid "Not tested"
msgstr "Netestované"

#. TRANSLATORS: %d is the connection latency in milliseconds.
#: ui/internal/accountwizard/results.go:67
#, c-format
msgid "Connected in %d ms"
msgstr "Pripojené za %d ms"

#. TRANSLATORS: banner on the identity page of the account assistant
#: ui/internal/accountwizard/results.go:89
msgid "No password is stored for this account. Enter it to continue."
msgstr "Pre tento účet nie je uložené heslo. Zadajte ho a pokračujte."

#: ui/internal/accountwizard/results.go:92
msgid "Google rejected the sign-in. It does not accept the account's password here: create an app password in your Google Account and enter that one. For a work or school account, the administrator has to allow app passwords and IMAP."
msgstr "Google prihlásenie odmietol. Bežné heslo účtu tu neprijíma: vytvorte si v účte Google heslo aplikácie a zadajte ho. Pri pracovnom alebo školskom účte musí heslá aplikácií a IMAP povoliť správca."

#: ui/internal/accountwizard/results.go:94 ui/internal/crm/text.go:556
#: ui/internal/widget/rpc.go:103
msgid "The server rejected the user name or password"
msgstr "Server odmietol používateľské meno alebo heslo"

#. TRANSLATORS: joins two servers ("host:port") in the sentence
#. "… accept exactly this certificate for %s and no other …".
#. TRANSLATORS: joins the last item of a list, e.g. "Monday and
#. Wednesday".
#: ui/internal/accountwizard/trust.go:83 ui/internal/calendar/recurrence.go:74
#, c-format
msgid "%s and %s"
msgstr "%s a %s"

#. TRANSLATORS: dialog heading, the pinned certificate of a server
#. has changed
#: ui/internal/accountwizard/trust.go:101 ui/internal/aiaccount/dialog.go:372
msgid "Trust the New Certificate?"
msgstr "Dôverovať novému certifikátu?"

#. TRANSLATORS: %s is one server ("host:port") or two joined by
#. "%s and %s".
#: ui/internal/accountwizard/trust.go:104 ui/internal/aiaccount/dialog.go:375
#, c-format
msgid "The certificate of %s has changed since you trusted it. If you did not renew it yourself, someone may be intercepting the connection. Trust the new certificate only if you know why it changed."
msgstr "Certifikát servera %s sa zmenil, odkedy ste mu začali dôverovať. Ak ste ho sami neobnovili, niekto môže odpočúvať spojenie. Novému certifikátu dôverujte, len ak viete, prečo sa zmenil."

#. TRANSLATORS: dialog heading
#: ui/internal/accountwizard/trust.go:107 ui/internal/aiaccount/dialog.go:378
msgid "Trust This Certificate?"
msgstr "Dôverovať tomuto certifikátu?"

#. TRANSLATORS: %s is one server ("host:port") or two joined by
#. "%s and %s".
#: ui/internal/accountwizard/trust.go:110 ui/internal/aiaccount/dialog.go:381
#, c-format
msgid "Only trust a certificate you expect, for example the one of a mail bridge on your own computer. Malachi Mail will then accept exactly this certificate for %s and no other, even if it is self-signed, issued for another name or expired."
msgstr "Dôverujte len certifikátu, ktorý očakávate, napríklad certifikátu poštového mostu na vlastnom počítači. Malachi Mail potom pre %s prijme presne tento certifikát a žiadny iný, aj keď je podpísaný sám sebou, vystavený pre iné meno alebo je jeho platnosť skončená."

#. TRANSLATORS: destructive confirm button of "Trust This Certificate?"
#: ui/internal/accountwizard/trust.go:113 ui/internal/aiaccount/dialog.go:384
msgid "_Trust"
msgstr "_Dôverovať"

#: ui/internal/accountwizard/trust.go:167 ui/internal/signature/text.go:242
msgctxt "certificate"
msgid "SHA-256 fingerprint"
msgstr "Odtlačok SHA-256"

#. TRANSLATORS: label of the fingerprint of the certificate that was
#. pinned before
#: ui/internal/accountwizard/trust.go:170
msgctxt "certificate"
msgid "Previously trusted"
msgstr "Predtým dôveryhodný"

#: ui/internal/accountwizard/trust.go:171 ui/internal/signature/text.go:268
msgctxt "certificate"
msgid "Issued to"
msgstr "Vystavené pre"

#: ui/internal/accountwizard/trust.go:172 ui/internal/signature/text.go:270
msgctxt "certificate"
msgid "Issued by"
msgstr "Vydal"

#. TRANSLATORS: validity period of a certificate: two dates
#: ui/internal/accountwizard/trust.go:176 ui/internal/signature/text.go:282
#, c-format
msgctxt "certificate"
msgid "%s to %s"
msgstr "%s až %s"

#. TRANSLATORS: label of a certificate's validity period
#: ui/internal/accountwizard/trust.go:178 ui/internal/signature/text.go:272
msgctxt "certificate"
msgid "Valid"
msgstr "Platnosť"

#: ui/internal/accountwizard/trust.go:181
msgctxt "certificate"
msgid "Self-signed"
msgstr "Podpísaný sám sebou"

#: ui/internal/accountwizard/wizard.go:262 ui/internal/crm/text.go:431
