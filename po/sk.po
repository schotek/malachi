msgid "The newest message answers one of yours."
msgstr "Najnovšia správa odpovedá na niektorú z vašich."

#: ui/internal/board/text.go:567
msgid "You replied last; the next step is theirs."
msgstr "Naposledy ste odpovedali vy; ďalší krok je na nich."

#: ui/internal/board/text.go:569
msgid "You asked a question and wait for the answer."
msgstr "Položili ste otázku a čakáte na odpoveď."

