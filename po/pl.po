msgstr "Model używany przez dostawcę ChatGPT"

#: data/io.github.schotek.Malachi.gschema.xml:250
#: data/io.github.schotek.Malachi.gschema.xml:261
msgid "Empty uses the provider's model default."
msgstr "Puste oznacza domyślny model dostawcy."

