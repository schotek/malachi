msgid "Sonnet, Haiku or Opus, passed to Claude Code."
msgstr "Sonnet, Haiku lub Opus, przekazywany do Claude Code."

#: data/io.github.schotek.Malachi.gschema.xml:228
msgid "Where Claude Code is"
msgstr "Gdzie jest Claude Code"

#: data/io.github.schotek.Malachi.gschema.xml:229
