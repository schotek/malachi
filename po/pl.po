#: ui/internal/signature/text.go:24 ui/internal/signature/text.go:73
msgid "Valid signature"
msgstr "Prawidłowy podpis"

#. TRANSLATORS: the header's badge of a signed message; %s is the
#. signer's name and address from the certificate or key.
#: ui/internal/signature/text.go:28
#, c-format
msgid "Signed by %s"
msgstr "Podpisane przez: %s"

#: ui/internal/signature/text.go:31 ui/internal/signature/text.go:79
msgid "Signed by someone else"
msgstr "Podpisane przez kogoś innego"

#. TRANSLATORS: the signature is valid but belongs to another address
#. than the sender's; %s is the signer's name and address.
#: ui/internal/signature/text.go:35
#, c-format
msgid "Signed by someone else: %s"
msgstr "Podpisane przez kogoś innego: %s"

#: ui/internal/signature/text.go:38 ui/internal/signature/text.go:81
msgid "Untrusted signature"
msgstr "Niezaufany podpis"

#: ui/internal/signature/text.go:41
#, c-format
msgid "Signed by %s, but the key had expired"
msgstr "Podpisane przez: %s, ale klucz już wygasł"

#: ui/internal/signature/text.go:43
#, c-format
msgid "Signed by %s, but the certificate is not trusted"
msgstr "Podpisane przez: %s, ale certyfikat nie jest zaufany"

#: ui/internal/signature/text.go:46 ui/internal/signature/text.go:83
msgid "Weak signature"
msgstr "Słaby podpis"

#: ui/internal/signature/text.go:48
#, c-format
msgid "Signed by %s with a weak algorithm"
msgstr "Podpisane przez: %s słabym algorytmem"

#: ui/internal/signature/text.go:51
msgid "Signed with a revoked key"
msgstr "Podpisane unieważnionym kluczem"

#: ui/internal/signature/text.go:53
msgid "Signed with a revoked certificate"
msgstr "Podpisane unieważnionym certyfikatem"

#: ui/internal/signature/text.go:55 ui/internal/signature/text.go:85
msgid "Invalid signature"
msgstr "Nieprawidłowy podpis"

#: ui/internal/signature/text.go:57
msgid "Signed with an unknown OpenPGP key"
msgstr "Podpisane nieznanym kluczem OpenPGP"

#: ui/internal/signature/text.go:60
msgid "Inline OpenPGP signature, not verified"
msgstr "Wbudowany podpis OpenPGP, niezweryfikowany"

#: ui/internal/signature/text.go:62 ui/internal/signature/text.go:94
msgid "Signature not verified"
msgstr "Podpis niezweryfikowany"

#: ui/internal/signature/text.go:64 ui/internal/signature/text.go:96
msgid "Signature could not be verified"
msgstr "Nie udało się zweryfikować podpisu"

#. TRANSLATORS: an OpenPGP signature that matches, made with a key
#. found automatically that the user has not confirmed yet.
#: ui/internal/signature/text.go:77
msgid "Valid signature, key not confirmed"
msgstr "Prawidłowy podpis, klucz niepotwierdzony"

#: ui/internal/signature/text.go:88
msgid "Revoked key"
msgstr "Unieważniony klucz"

#: ui/internal/signature/text.go:90
msgid "Revoked certificate"
msgstr "Unieważniony certyfikat"

#: ui/internal/signature/text.go:92
msgid "Unknown key"
msgstr "Nieznany klucz"

#: ui/internal/signature/text.go:105
msgid "The signature matches the message, and you confirmed the key."
msgstr "Podpis pasuje do wiadomości, a klucz został przez Ciebie potwierdzony."

#: ui/internal/signature/text.go:107
msgid "The signature matches the message, and the certificate was issued by an authority this computer trusts."
msgstr "Podpis pasuje do wiadomości, a certyfikat wystawił urząd, któremu ufa ten komputer."

#: ui/internal/signature/text.go:109
msgid "The signature matches the message. The key was found automatically: compare its fingerprint with the sender to confirm it."
msgstr "Podpis pasuje do wiadomości. Klucz został znaleziony automatycznie: porównaj jego odcisk z nadawcą, aby go potwierdzić."

#. TRANSLATORS: the first %s is the address of the certificate or
#. key, the second the sender's address of the message.
#: ui/internal/signature/text.go:114
#, c-format
msgid "The signature is valid, but it belongs to %s, not to the sender %s."
msgstr "Podpis jest prawidłowy, ale należy do %s, a nie do nadawcy %s."

#: ui/internal/signature/text.go:116
msgid "The signature is valid, but it does not belong to the sender's address."
msgstr "Podpis jest prawidłowy, ale nie należy do adresu nadawcy."

#: ui/internal/signature/text.go:119
msgid "The signature matches the message, but the key had expired when the message arrived."
msgstr "Podpis pasuje do wiadomości, ale klucz wygasł przed nadejściem wiadomości."

#: ui/internal/signature/text.go:121
msgid "The signature matches the message, but the certificate cannot be trusted."
msgstr "Podpis pasuje do wiadomości, ale certyfikatowi nie można ufać."

#: ui/internal/signature/text.go:123
msgid "The signature matches the message, but it uses an algorithm that is no longer considered safe."
msgstr "Podpis pasuje do wiadomości, ale używa algorytmu, który nie jest już uważany za bezpieczny."

#: ui/internal/signature/text.go:125
msgid "The message may have been changed after it was signed. Do not trust its content."
msgstr "Wiadomość mogła zostać zmieniona po podpisaniu. Nie ufaj jej treści."

#: ui/internal/signature/text.go:128
msgid "The key was revoked before the message arrived. Do not trust its content."
msgstr "Klucz został unieważniony przed nadejściem wiadomości. Nie ufaj jej treści."

#: ui/internal/signature/text.go:130
msgid "The certificate was revoked before the message arrived. Do not trust its content."
msgstr "Certyfikat został unieważniony przed nadejściem wiadomości. Nie ufaj jej treści."

#: ui/internal/signature/text.go:132
msgid "The message is signed with an OpenPGP key that Malachi Mail does not have. Import the sender's key to verify it."
msgstr "Wiadomość jest podpisana kluczem OpenPGP, którego Malachi Mail nie ma. Zaimportuj klucz nadawcy, aby ją zweryfikować."

#: ui/internal/signature/text.go:134
msgid "Malachi Mail cannot verify this kind of signature."
msgstr "Malachi Mail nie potrafi zweryfikować tego rodzaju podpisu."

#: ui/internal/signature/text.go:136
msgid "Malachi Mail could not verify the signature."
msgstr "Malachi Mail nie udało się zweryfikować podpisu."

#: ui/internal/signature/text.go:141
msgid "A valid signature tells who sent the message, not that its content is true or safe."
msgstr "Prawidłowy podpis mówi, kto wysłał wiadomość, a nie że jej treść jest prawdziwa lub bezpieczna."

#: ui/internal/signature/text.go:151
msgid "The key has expired since the message arrived."
msgstr "Klucz wygasł po nadejściu wiadomości."

#: ui/internal/signature/text.go:153
msgid "The certificate has expired since the message arrived."
msgstr "Certyfikat wygasł po nadejściu wiadomości."

#: ui/internal/signature/text.go:155
msgid "Whether the certificate was revoked has not been checked."
msgstr "Nie sprawdzono, czy certyfikat został unieważniony."

#: ui/internal/signature/text.go:157
msgid "The certificate was not revoked when last checked."
msgstr "Przy ostatnim sprawdzeniu certyfikat nie był unieważniony."

#: ui/internal/signature/text.go:160
msgid "The key was revoked after the message arrived."
msgstr "Klucz został unieważniony po nadejściu wiadomości."

#: ui/internal/signature/text.go:162
msgid "The certificate was revoked after the message arrived."
msgstr "Certyfikat został unieważniony po nadejściu wiadomości."

#: ui/internal/signature/text.go:164
msgid "A footer added after signing, such as a mailing list's, is not covered by the signature."
msgstr "Stopka dodana po podpisaniu, np. przez listę dyskusyjną, nie jest objęta podpisem."

#: ui/internal/signature/text.go:166
msgid "The signed headers differ from the ones shown."
msgstr "Podpisane nagłówki różnią się od wyświetlanych."

#: ui/internal/signature/text.go:168
msgid "Inline OpenPGP signatures are not verified: they do not cover attachments or formatting."
msgstr "Wbudowane podpisy OpenPGP nie są weryfikowane: nie obejmują załączników ani formatowania."

#: ui/internal/signature/text.go:170
msgid "This sender used a different key before."
msgstr "Ten nadawca wcześniej używał innego klucza."

#: ui/internal/signature/text.go:172
msgid "The signed content was unpacked from the signature."
msgstr "Podpisana treść została rozpakowana z podpisu."

#: ui/internal/signature/text.go:182
msgid "The message was changed after it was signed."
msgstr "Wiadomość została zmieniona po podpisaniu."

#: ui/internal/signature/text.go:184
msgid "The signature does not match the signer's certificate or key."
msgstr "Podpis nie pasuje do certyfikatu ani klucza podpisującego."

#: ui/internal/signature/text.go:186
msgid "The signature is damaged."
msgstr "Podpis jest uszkodzony."

#: ui/internal/signature/text.go:188
msgid "The signature uses MD5, which is broken."
msgstr "Podpis używa MD5, który jest złamany."

#: ui/internal/signature/text.go:190
msgid "The certificate is not meant for signing e-mail."
msgstr "Certyfikat nie jest przeznaczony do podpisywania poczty e-mail."

#: ui/internal/signature/text.go:192
msgid "The certificate was not issued by an authority this computer trusts."
msgstr "Certyfikatu nie wystawił urząd, któremu ufa ten komputer."

#: ui/internal/signature/text.go:194
msgid "The certificate is self-signed."
msgstr "Certyfikat jest samopodpisany."

#: ui/internal/signature/text.go:196
msgid "The certificate was not valid yet when the message arrived."
msgstr "Certyfikat nie był jeszcze ważny w chwili nadejścia wiadomości."

#: ui/internal/signature/text.go:199
msgid "The key had expired when the message arrived."
msgstr "Klucz był wygasły w chwili nadejścia wiadomości."

#: ui/internal/signature/text.go:201
msgid "The certificate had expired when the message arrived."
msgstr "Certyfikat był wygasły w chwili nadejścia wiadomości."

#: ui/internal/signature/text.go:203
msgid "The signature uses SHA-1, which is no longer considered safe."
msgstr "Podpis używa SHA-1, który nie jest już uważany za bezpieczny."

#: ui/internal/signature/text.go:205
msgid "The signing key is shorter than 2048 bits."
msgstr "Klucz podpisujący jest krótszy niż 2048 bitów."

#: ui/internal/signature/text.go:207
msgid "The signature uses an algorithm Malachi Mail does not support."
msgstr "Podpis używa algorytmu, którego Malachi Mail nie obsługuje."

#: ui/internal/signature/text.go:209
msgid "The message has more than one signer, which Malachi Mail does not support."
msgstr "Wiadomość ma więcej niż jednego podpisującego, czego Malachi Mail nie obsługuje."

#: ui/internal/signature/text.go:211
msgid "The mail server changed the message, so its signature cannot be checked."
msgstr "Serwer poczty zmienił wiadomość, więc nie można sprawdzić jej podpisu."

#: ui/internal/signature/text.go:213
msgid "Malachi Mail does not support this kind of signed message."
msgstr "Malachi Mail nie obsługuje tego rodzaju podpisanej wiadomości."

#: ui/internal/signature/text.go:215
msgid "The signature is too large or too complex to check."
msgstr "Podpis jest za duży lub zbyt złożony, aby go sprawdzić."

#. TRANSLATORS: label of the details row with the signer's name and address
#: ui/internal/signature/text.go:225
msgctxt "signature"
msgid "Signed by"
msgstr "Podpisane przez"

#. TRANSLATORS: label of the row that says S/MIME or OpenPGP
#: ui/internal/signature/text.go:228
msgctxt "signature"
msgid "Signature type"
msgstr "Typ podpisu"

#. TRANSLATORS: label of the row that says why the signature is not valid
#: ui/internal/signature/text.go:231
msgctxt "signature"
msgid "Problem"
msgstr "Problem"

#. TRANSLATORS: label of the signing time; the signer writes it, so
#. it is only a claim
#: ui/internal/signature/text.go:235
msgctxt "signature"
msgid "Signed, as stated by the signer"
msgstr "Podpisano (według podpisującego)"

#. TRANSLATORS: label of the time the message arrived
#: ui/internal/signature/text.go:238
msgctxt "signature"
msgid "Arrived"
msgstr "Nadeszła"

#: ui/internal/signature/text.go:240
msgctxt "signature"
msgid "Algorithm"
msgstr "Algorytm"

#: ui/internal/signature/text.go:244
msgctxt "signature"
msgid "Key fingerprint"
msgstr "Odcisk klucza"

#: ui/internal/signature/text.go:246
