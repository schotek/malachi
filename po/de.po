#: ui/internal/board/text.go:243
#, c-format
msgid "The daemon’s rules set the state and the assistant (%s) kept it."
msgstr "Die Regeln des Hintergrunddienstes haben den Status festgelegt, und der Assistent (%s) hat ihn beibehalten."

