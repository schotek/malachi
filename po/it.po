#: ui/internal/accountwizard/wizard.go:785 ui/internal/aiaccount/text.go:94
#: ui/internal/jira/wizard.go:96 ui/internal/jira/wizard.go:429
#: ui/internal/jira/settings.go:125 ui/internal/crm/text.go:440
#: ui/internal/crm/text.go:539 ui/internal/calendarctl/account.go:407
msgid "Saving the account"
