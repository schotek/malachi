msgid_plural "Conversation about %d messages"
msgstr[0] "Rozhovor o %d zprávě"
msgstr[1] "Rozhovor o %d zprávách"
msgstr[2] "Rozhovor o %d zprávách"

#. TRANSLATORS: %s is the subject of the message the conversation is about.
#: ui/internal/assistant/assistant.go:350
#, c-format
