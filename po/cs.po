msgstr[1] "Vybraná konverzace (%d zprávy)"
msgstr[2] "Vybraná konverzace (%d zpráv)"

#. TRANSLATORS: The context of the assistant panel: the conversation is about several messages.
#: ui/internal/assistant/assistant.go:346
#, c-format
msgid "Conversation about %d message"
msgid_plural "Conversation about %d messages"
msgstr[0] "Rozhovor o %d zprávě"
msgstr[1] "Rozhovor o %d zprávách"
msgstr[2] "Rozhovor o %d zprávách"

#. TRANSLATORS: %s is the subject of the message the conversation is about.
#: ui/internal/assistant/assistant.go:350
#, c-format
