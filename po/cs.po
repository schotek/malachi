msgstr[1] "Pravidla změnila %d zprávy."
msgstr[2] "Pravidla změnila %d zpráv."

#: ui/internal/rules/text.go:642
msgid "The rules could not be applied."
msgstr "Pravidla se nepodařilo použít."

#: ui/internal/signature/text.go:24 ui/internal/signature/text.go:73
msgid "Valid signature"
msgstr "Platný podpis"

#. TRANSLATORS: the header's badge of a signed message; %s is the
#. signer's name and address from the certificate or key.
#: ui/internal/signature/text.go:28
#, c-format
msgid "Signed by %s"
msgstr "Podepsal(a) %s"

#: ui/internal/signature/text.go:31 ui/internal/signature/text.go:79
msgid "Signed by someone else"
msgstr "Podepsal(a) někdo jiný"

#. TRANSLATORS: the signature is valid but belongs to another address
#. than the sender's; %s is the signer's name and address.
#: ui/internal/signature/text.go:35
#, c-format
msgid "Signed by someone else: %s"
msgstr "Podepsal(a) někdo jiný: %s"

#: ui/internal/signature/text.go:38 ui/internal/signature/text.go:81
msgid "Untrusted signature"
msgstr "Nedůvěryhodný podpis"

#: ui/internal/signature/text.go:41
#, c-format
msgid "Signed by %s, but the key had expired"
msgstr "Podepsal(a) %s, ale platnost klíče už vypršela"

#: ui/internal/signature/text.go:43
#, c-format
msgid "Signed by %s, but the certificate is not trusted"
msgstr "Podepsal(a) %s, ale certifikát není důvěryhodný"

#: ui/internal/signature/text.go:46 ui/internal/signature/text.go:83
msgid "Weak signature"
msgstr "Slabý podpis"

#: ui/internal/signature/text.go:48
#, c-format
msgid "Signed by %s with a weak algorithm"
msgstr "Podepsal(a) %s slabým algoritmem"

#: ui/internal/signature/text.go:51
msgid "Signed with a revoked key"
msgstr "Podepsáno odvolaným klíčem"

#: ui/internal/signature/text.go:53
msgid "Signed with a revoked certificate"
msgstr "Podepsáno odvolaným certifikátem"

#: ui/internal/signature/text.go:55 ui/internal/signature/text.go:85
msgid "Invalid signature"
msgstr "Neplatný podpis"

#: ui/internal/signature/text.go:57
msgid "Signed with an unknown OpenPGP key"
msgstr "Podepsáno neznámým klíčem OpenPGP"

#: ui/internal/signature/text.go:60
msgid "Inline OpenPGP signature, not verified"
msgstr "Vložený podpis OpenPGP, neověřuje se"

#: ui/internal/signature/text.go:62 ui/internal/signature/text.go:94
msgid "Signature not verified"
msgstr "Podpis nebyl ověřen"

#: ui/internal/signature/text.go:64 ui/internal/signature/text.go:96
msgid "Signature could not be verified"
msgstr "Podpis se nepodařilo ověřit"

#. TRANSLATORS: an OpenPGP signature that matches, made with a key
#. found automatically that the user has not confirmed yet.
#: ui/internal/signature/text.go:77
msgid "Valid signature, key not confirmed"
msgstr "Platný podpis, klíč nepotvrzený"

#: ui/internal/signature/text.go:88
msgid "Revoked key"
msgstr "Odvolaný klíč"

#: ui/internal/signature/text.go:90
msgid "Revoked certificate"
msgstr "Odvolaný certifikát"

#: ui/internal/signature/text.go:92
msgid "Unknown key"
msgstr "Neznámý klíč"

#: ui/internal/signature/text.go:105
msgid "The signature matches the message, and you confirmed the key."
msgstr "Podpis odpovídá zprávě a klíč jste potvrdili."

#: ui/internal/signature/text.go:107
msgid ""
"The signature matches the message, and the certificate was issued by an "
"authority this computer trusts."
msgstr ""
"Podpis odpovídá zprávě a certifikát vydala autorita, které tento počítač "
"důvěřuje."

#: ui/internal/signature/text.go:109
msgid ""
"The signature matches the message. The key was found automatically: compare "
"its fingerprint with the sender to confirm it."
msgstr ""
"Podpis odpovídá zprávě. Klíč se našel automaticky: potvrďte ho tak, že jeho "
"otisk porovnáte s odesílatelem."

#. TRANSLATORS: the first %s is the address of the certificate or
#. key, the second the sender's address of the message.
#: ui/internal/signature/text.go:114
#, c-format
msgid "The signature is valid, but it belongs to %s, not to the sender %s."
msgstr "Podpis je platný, ale patří adrese %s, ne odesílateli %s."

#: ui/internal/signature/text.go:116
msgid "The signature is valid, but it does not belong to the sender's address."
msgstr "Podpis je platný, ale nepatří adrese odesílatele."

#: ui/internal/signature/text.go:119
msgid ""
"The signature matches the message, but the key had expired when the message "
"arrived."
msgstr ""
"Podpis odpovídá zprávě, ale platnost klíče v době doručení zprávy už "
"vypršela."

#: ui/internal/signature/text.go:121
msgid ""
"The signature matches the message, but the certificate cannot be trusted."
msgstr "Podpis odpovídá zprávě, ale certifikátu nelze důvěřovat."

#: ui/internal/signature/text.go:123
msgid ""
"The signature matches the message, but it uses an algorithm that is no "
"longer considered safe."
msgstr ""
"Podpis odpovídá zprávě, ale používá algoritmus, který se už nepovažuje za "
"bezpečný."

#: ui/internal/signature/text.go:125
msgid ""
"The message may have been changed after it was signed. Do not trust its "
"content."
msgstr "Zpráva mohla být po podepsání změněna. Jejímu obsahu nevěřte."

#: ui/internal/signature/text.go:128
msgid ""
"The key was revoked before the message arrived. Do not trust its content."
msgstr "Klíč byl odvolán dřív, než zpráva přišla. Jejímu obsahu nevěřte."

#: ui/internal/signature/text.go:130
msgid ""
"The certificate was revoked before the message arrived. Do not trust its "
"content."
msgstr "Certifikát byl odvolán dřív, než zpráva přišla. Jejímu obsahu nevěřte."

#: ui/internal/signature/text.go:132
msgid ""
"The message is signed with an OpenPGP key that Malachi Mail does not have. "
"Import the sender's key to verify it."
msgstr ""
"Zpráva je podepsaná klíčem OpenPGP, který Malachi Mail nemá. Pro ověření "
"importujte klíč odesílatele."

#: ui/internal/signature/text.go:134
msgid "Malachi Mail cannot verify this kind of signature."
msgstr "Malachi Mail tento druh podpisu ověřit neumí."

#: ui/internal/signature/text.go:136
msgid "Malachi Mail could not verify the signature."
msgstr "Podpis se v Malachi Mail nepodařilo ověřit."

#: ui/internal/signature/text.go:141
msgid ""
"A valid signature tells who sent the message, not that its content is true "
"or safe."
msgstr ""
"Platný podpis říká, kdo zprávu poslal, ne že je její obsah pravdivý nebo "
"bezpečný."

#: ui/internal/signature/text.go:151
msgid "The key has expired since the message arrived."
msgstr "Platnost klíče od doručení zprávy vypršela."

#: ui/internal/signature/text.go:153
msgid "The certificate has expired since the message arrived."
msgstr "Platnost certifikátu od doručení zprávy vypršela."

#: ui/internal/signature/text.go:155
msgid "Whether the certificate was revoked has not been checked."
msgstr "Zda byl certifikát odvolán, se nekontrolovalo."

#: ui/internal/signature/text.go:157
msgid "The certificate was not revoked when last checked."
msgstr "Při poslední kontrole certifikát odvolaný nebyl."

#: ui/internal/signature/text.go:160
msgid "The key was revoked after the message arrived."
msgstr "Klíč byl odvolán až po doručení zprávy."

#: ui/internal/signature/text.go:162
msgid "The certificate was revoked after the message arrived."
msgstr "Certifikát byl odvolán až po doručení zprávy."

#: ui/internal/signature/text.go:164
msgid ""
"A footer added after signing, such as a mailing list's, is not covered by "
"the signature."
msgstr ""
"Patička přidaná po podepsání, třeba od konference, podpisem pokrytá není."

#: ui/internal/signature/text.go:166
msgid "The signed headers differ from the ones shown."
msgstr "Podepsané hlavičky se liší od zobrazených."

#: ui/internal/signature/text.go:168
msgid ""
"Inline OpenPGP signatures are not verified: they do not cover attachments or "
"formatting."
msgstr ""
"Vložené podpisy OpenPGP se neověřují: nepokrývají přílohy ani formátování."

#: ui/internal/signature/text.go:170
msgid "This sender used a different key before."
msgstr "Tento odesílatel dřív používal jiný klíč."

#: ui/internal/signature/text.go:172
msgid "The signed content was unpacked from the signature."
msgstr "Podepsaný obsah byl rozbalen z podpisu."

#: ui/internal/signature/text.go:182
msgid "The message was changed after it was signed."
msgstr "Zpráva byla po podepsání změněna."

#: ui/internal/signature/text.go:184
msgid "The signature does not match the signer's certificate or key."
msgstr "Podpis nesouhlasí s certifikátem ani klíčem podepisujícího."

#: ui/internal/signature/text.go:186
msgid "The signature is damaged."
msgstr "Podpis je poškozený."

#: ui/internal/signature/text.go:188
msgid "The signature uses MD5, which is broken."
msgstr "Podpis používá MD5, který je prolomený."

#: ui/internal/signature/text.go:190
