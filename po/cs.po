#. TRANSLATORS: under the model row of the AI provider dialog; the list comes from Test.
#: ui/internal/aiaccount/text.go:77
msgid "Choose one of the provider's models or type its id"
msgstr "Vyberte některý z modelů poskytovatele, nebo napište jeho id"

#. TRANSLATORS: the model of the board's triage, an optional second model of the AI provider account.
#: ui/internal/aiaccount/text.go:79
