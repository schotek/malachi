msgstr[2] "%s · %d odchozích zpráv zadrženo"

#: ui/internal/rules/text.go:160
msgid ""
"The folder this rule moves messages to no longer exists, so the rule was "
"turned off."
msgstr ""
"Složka, do které pravidlo přesouvá zprávy, už neexistuje, proto bylo "
"pravidlo vypnuto."

#: ui/internal/rules/text.go:162
msgid "This rule could not send a message, so it was turned off."
msgstr "Toto pravidlo nemohlo odeslat zprávu, proto bylo vypnuto."

#: ui/internal/rules/text.go:178
#, c-format
msgid "Remove the Rule “%s”?"
msgstr "Odebrat pravidlo „%s“?"

#: ui/internal/rules/text.go:179
msgid "Messages it already moved or marked stay as they are."
msgstr "Zprávy, které už přesunulo nebo označilo, zůstanou, jak jsou."

#: ui/internal/rules/text.go:190
msgid "Send Mail Automatically?"
msgstr "Odesílat poštu automaticky?"

#: ui/internal/rules/text.go:191
msgid "Turn On"
msgstr "Zapnout"

#: ui/internal/rules/text.go:205
#, c-format
msgid ""
"This rule forwards every matching message to %s and answers its sender, "
"without asking you. Bulk mail, automatic messages and your own messages are "
"never forwarded or answered."
msgstr ""
"Toto pravidlo bez ptaní přepošle každou odpovídající zprávu na %s a odpoví "
"jejímu odesílateli. Hromadná pošta, automatické zprávy a vaše vlastní zprávy "
"se nikdy nepřeposílají ani se na ně neodpovídá."

#: ui/internal/rules/text.go:207
#, c-format
msgid ""
"This rule forwards every matching message to %s without asking you. Bulk "
"mail, automatic messages and your own messages are never forwarded."
msgstr ""
"Toto pravidlo bez ptaní přepošle každou odpovídající zprávu na %s. Hromadná "
"pošta, automatické zprávy a vaše vlastní zprávy se nikdy nepřeposílají."

#: ui/internal/rules/text.go:209
msgid ""
"This rule answers the sender of every matching message without asking you, "
"at most once in four days per sender. Bulk mail, automatic messages and your "
"own messages are never answered."
msgstr ""
"Toto pravidlo bez ptaní odpoví odesílateli každé odpovídající zprávy, "
"každému nejvýš jednou za čtyři dny. Na hromadnou poštu, automatické zprávy a "
"vaše vlastní zprávy se nikdy neodpovídá."

#: ui/internal/rules/text.go:221
