BEGIN:VCALENDAR
X-MALACHI-TEST:VALARMs with EMAIL, PROCEDURE and an ATTACH (never executed)
VERSION:2.0
PRODID:-//Malachi Test//Corpus//EN
BEGIN:VEVENT
UID:vep@example.org
DTSTAMP:20261016T080000Z
DTSTART:20261020T090000Z
DTEND:20261020T100000Z
SUMMARY:Planning
BEGIN:VALARM
ACTION:EMAIL
TRIGGER:-PT10M
SUMMARY:Alarm mail
DESCRIPTION:sent by the alarm
ATTENDEE:mailto:victim@example.org
END:VALARM
BEGIN:VALARM
ACTION:PROCEDURE
TRIGGER:-PT5M
ATTACH;VALUE=URI:file:///bin/sh
END:VALARM
BEGIN:VALARM
ACTION:AUDIO
TRIGGER:-PT1M
ATTACH;FMTTYPE=audio/basic:https://example.org/sound.wav
END:VALARM
END:VEVENT
END:VCALENDAR
